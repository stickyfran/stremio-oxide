import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { PillButton } from "../components/button.slint";
import { EmptyState } from "../components/feedback.slint";
import { FallbackImage } from "../components/fallback_image.slint";
import { ModalDialog } from "../components/overlays.slint";

export struct DownloadEpisodeChip {
    id: string,
    season: int,
    episode-num: int,
    title: string,
    is-downloaded: bool,
    is-downloading: bool,
    is-paused: bool,
    is-failed: bool,
    error-message: string,
    watched: bool,
    watch-progress: float,
    progress: float,
}

export struct DownloadSeasonGroup {
    season: int,
    season-label: string,
    season-year: string,
    has-downloaded: bool,
    has-active: bool,
    has-paused: bool,
    has-failed: bool,
    episodes: [DownloadEpisodeChip],
}

export struct DownloadEpisodeItem {
    id: string,
    title: string,
    season: int,
    episode-num: int,
    status: string,
    progress: float,
    size-formatted: string,
    can-pause: bool,
    can-resume: bool,
    can-play: bool,
    can-delete: bool,
    watched: bool,
    watch-progress: float,
}

export struct DownloadItem {
    id: string,
    meta-id: string,
    is-series: bool,
    title: string,
    poster: image,
    has-poster: bool,
    poster-url: string,
    coverage: string,
    status: string,
    progress: float,
    size-formatted: string,
    subtitles-info: string,
    has-subtitles: bool,
    is-downloading: bool,
    is-paused: bool,
    has-failed: bool,
    error-message: string,
    can-pause: bool,
    can-resume: bool,
    can-cancel: bool,
    can-change-source: bool,
    can-play: bool,
    can-delete: bool,
    watched: bool,
    watch-progress: float,
    downloaded-seasons: [DownloadSeasonGroup],
    all-seasons: [DownloadSeasonGroup],
    episodes: [DownloadEpisodeItem],
}

export component DownloadsPage inherits Rectangle {
    in property <length> unit: Theme.root-font-size;
    in property <[DownloadItem]> items: [];
    in property <bool> loading: false;
    in property <string> error: "";
    in property <string> disk-usage-text: "";
    in property <int> active-count: 0;
    in property <string> speed-text: "";
    in property <string> current-text: "";
    in property <string> eta-text: "";
    in-out property <string> expanded-id: "";

    in-out property <bool> prompt-download-open: false;
    in-out property <string> prompt-download-meta-id: "";
    in-out property <string> prompt-download-title: "";
    in-out property <int> prompt-download-season: 0;
    in-out property <int> prompt-download-episode: 0;
    in-out property <string> prompt-download-ep-title: "";
    in-out property <string> prompt-download-job-id: "";
    in-out property <bool> prompt-download-is-downloaded: false;
    in-out property <bool> prompt-download-is-downloading: false;
    in-out property <bool> prompt-download-is-paused: false;
    in-out property <bool> prompt-download-is-failed: false;
    in-out property <float> prompt-download-progress: 0.0;
    in-out property <string> prompt-download-error: "";
    in-out property <bool> prompt-download-season-has-dl: false;
    in-out property <bool> prompt-download-season-has-active: false;
    in-out property <bool> prompt-download-season-has-paused: false;
    in-out property <string> prompt-download-season-label: "";
    in-out property <string> prompt-download-season-year: "";

    callback pause(string);
    callback resume(string);
    callback cancel(string);
    callback play(string);
    callback reveal(string);
    callback delete-item(string);
    callback open-downloads-folder;
    callback retry;
    callback dismiss-error;
    callback request-download-episode(string, int, int, bool);

    background: transparent;

    private property <float> content-fade-opacity: 1.0;
    private property <bool> content-fade-in-pending: false;
    private property <int> has-items-state: root.items.length > 0 ? 1 : 0;

    function trigger-content-fade() {
        root.content-fade-opacity = 0.0;
        root.content-fade-in-pending = true;
    }

    init => {
        root.trigger-content-fade();
    }

    changed loading => {
        root.trigger-content-fade();
    }

    changed has-items-state => {
        root.trigger-content-fade();
    }

    Timer {
        interval: 16ms;
        running: root.content-fade-in-pending;
        triggered => {
            self.stop();
            root.content-fade-in-pending = false;
            root.content-fade-opacity = 1.0;
        }
    }

    opacity: root.content-fade-opacity;
    animate opacity {
        duration: root.content-fade-in-pending ? 0ms : Theme.motion-control;
        easing: ease-out;
    }

    VerticalLayout {
        padding-left: 3 * root.unit;
        padding-right: 3 * root.unit;
        padding-top: 2.5 * root.unit;
        padding-bottom: 2 * root.unit;
        spacing: 1.5 * root.unit;

        HorizontalLayout {
            height: 3.2 * root.unit;
            spacing: 1.5 * root.unit;

            Text {
                horizontal-stretch: 1;
                text: @tr("DOWNLOADS_TITLE" => "Descargas");
                color: Theme.text-primary;
                font-size: 2 * root.unit;
                font-weight: 700;
                vertical-alignment: center;
            }

            if (root.active-count > 0) : VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;

                Rectangle {
                    height: 2.8 * root.unit;
                    max-width: 22 * root.unit;
                    clip: true;
                    border-radius: Theme.border-radius;
                    background: Theme.primary-accent.with-alpha(0.16);
                    border-width: 1px;
                    border-color: Theme.primary-accent.with-alpha(0.45);

                    HorizontalLayout {
                        padding-left: 1 * root.unit;
                        padding-right: 1.2 * root.unit;
                        spacing: 0.8 * root.unit;
                        alignment: center;

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 0.8 * root.unit;
                                height: 0.8 * root.unit;
                                border-radius: self.height / 2;
                                background: Theme.accent;
                                opacity: 0.35 + 0.65 * abs(sin(animation-tick() / 600ms * 180deg));
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 0.1 * root.unit;

                            Text {
                                text: (root.speed-text != "" ? "Descargando " + root.active-count + " · " + root.speed-text : "Preparando descarga…")
                                    + (root.eta-text != "" ? " · " + root.eta-text : "");
                                color: Theme.primary-foreground;
                                font-size: 0.82 * root.unit;
                                font-weight: 650;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            if (root.current-text != "") : Text {
                                text: root.current-text;
                                color: Theme.text-secondary;
                                font-size: 0.72 * root.unit;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            if (root.disk-usage-text != "") : VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;

                Rectangle {
                    height: 2.8 * root.unit;
                    max-width: 24 * root.unit;
                    clip: true;
                    border-radius: Theme.border-radius;
                    background: Theme.card-background;
                    border-width: 1px;
                    border-color: Theme.card-border;

                    HorizontalLayout {
                        padding-left: 1.2 * root.unit;
                        padding-right: 1.2 * root.unit;
                        spacing: 0.8 * root.unit;
                        alignment: center;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                width: 1.2 * root.unit;
                                height: 1.2 * root.unit;
                                source: @image-url("../assets/images/icons/download.svg");
                                colorize: Theme.accent;
                                image-fit: contain;
                            }
                        }

                        Text {
                            text: root.disk-usage-text;
                            color: Theme.text-secondary;
                            font-size: 0.9 * root.unit;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;

                PillButton {
                    width: 10.5 * root.unit;
                    height: 2.8 * root.unit;
                    unit: root.unit;
                    label: @tr("SETTINGS_OPEN_FOLDER" => "Abrir carpeta");
                    label-font-size: 0.88 * root.unit;
                    clicked => { root.open-downloads-folder(); }
                }
            }
        }

        if (root.error != "") : Rectangle {
            height: error-banner-row.preferred-height;
            border-radius: Theme.border-radius;
            background: Theme.danger.with-alpha(0.16);
            border-width: 1px;
            border-color: Theme.danger.with-alpha(0.45);

            error-banner-row := HorizontalLayout {
                padding: 0.9 * root.unit;
                spacing: 0.8 * root.unit;
                alignment: start;

                Text {
                    horizontal-stretch: 1;
                    text: root.error;
                    color: Theme.text-primary;
                    font-size: 0.88 * root.unit;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }

                VerticalLayout {
                    alignment: center;
                    PillButton {
                        width: 8.5 * root.unit;
                        height: 2.6 * root.unit;
                        unit: root.unit;
                        label: @tr("RETRY" => "Reintentar");
                        label-font-size: 0.84 * root.unit;
                        clicked => { root.retry(); }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    PillButton {
                        width: 2.8 * root.unit;
                        height: 2.6 * root.unit;
                        unit: root.unit;
                        label: "×";
                        outlined: true;
                        clicked => { root.dismiss-error(); }
                    }
                }
            }
        }

        if (!root.loading && root.items.length == 0 && root.error == "") : EmptyState {
            vertical-stretch: 1;
            unit: root.unit;
            icon-source: @image-url("../assets/images/icons/download.svg");
            title: @tr("DOWNLOADS_EMPTY" => "No hay descargas aún");
            message: @tr("DOWNLOADS_EMPTY_HINT" => "Descarga una película o serie para tenerla disponible sin conexión con subtítulos.");
        }

        if (root.loading) : Text {
            vertical-stretch: 1;
            text: @tr("LOADING" => "Loading…");
            color: Theme.text-secondary;
            font-size: root.unit;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        if (!root.loading && root.items.length > 0) : ScrollView {
            vertical-stretch: 1;
            viewport-width: self.visible-width;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

            items-layout := VerticalLayout {
                alignment: start;
                spacing: 1.0 * root.unit;
                padding-bottom: 2.0 * root.unit;

                for item in root.items : card := Rectangle {
                    property <bool> is-expanded: root.expanded-id == item.id;
                    property <string> hovered-ep-info: "";
                    // Auto-size to the real content: collapsed/expanded lists and
                    // movie cards no longer rely on a hand-computed height.
                    height: card-content.preferred-height;
                    border-radius: Theme.border-radius;
                    border-width: 1px;
                    border-color: item.has-failed
                        ? Theme.danger.with-alpha(0.55)
                        : (item.is-downloading
                            ? Theme.primary-accent.with-alpha(0.55)
                            : (item.is-paused
                                ? #f59e0b.with-alpha(0.55)
                                : (row-area.has-hover ? Theme.primary-accent.with-alpha(0.4) : Theme.card-border)));
                    background: row-area.has-hover ? #1c1a2d : Theme.card-background;
                    clip: true;

                    animate background, border-color { duration: Theme.motion-fast; }

                    // Card background click: toggles expand/collapse for series or plays completed movie
                    row-area := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            if (item.is-series) {
                                if (root.expanded-id == item.id) {
                                    root.expanded-id = "";
                                } else {
                                    root.expanded-id = item.id;
                                }
                            } else if (item.can-play) {
                                root.play(item.id);
                            }
                        }
                    }

                    card-content := VerticalLayout {
                        x: 0px;
                        y: 0px;
                        width: 100%;
                        padding-left: 1.4 * root.unit;
                        padding-right: 1.4 * root.unit;
                        padding-top: 1.2 * root.unit;
                        padding-bottom: 1.2 * root.unit;
                        spacing: 0.9 * root.unit;
                        alignment: start;

                        // Main Header Row (Poster, Meta Column, Actions)
                        HorizontalLayout {
                            height: 8.2 * root.unit;
                            spacing: 1.4 * root.unit;

                            // Poster
                            poster-container := Rectangle {
                                width: 5.6 * root.unit;
                                height: 8.2 * root.unit;
                                border-radius: 8px;
                                background: #141322;
                                border-width: 1px;
                                border-color: Theme.card-border;
                                clip: true;

                                FallbackImage {
                                    width: 100%;
                                    height: 100%;
                                    source: item.poster;

                                    Image {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: 2.2 * root.unit;
                                        height: 2.2 * root.unit;
                                        source: item.is-series ? @image-url("../assets/images/icons/series.svg") : @image-url("../assets/images/icons/movies.svg");
                                        colorize: Theme.text-secondary;
                                        image-fit: contain;
                                    }
                                }
                            }

                            // Meta info column
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: space-between;
                                spacing: 0.5 * root.unit;

                                // Line 1: Title and Type Badge
                                HorizontalLayout {
                                    height: 2.2 * root.unit;
                                    spacing: 0.8 * root.unit;
                                    alignment: start;

                                    Text {
                                        horizontal-stretch: 1;
                                        text: item.title;
                                        color: Theme.text-primary;
                                        font-size: 1.35 * root.unit;
                                        font-weight: 750;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }

                                    // Type text (sin recuadro/squircle ni bordes, alineado al mismo renglón, grisáceo e itálica)
                                    Text {
                                        horizontal-stretch: 0;
                                        text: item.is-series ? "Serie" : "Película";
                                        color: Theme.text-muted;
                                        font-size: 0.92 * root.unit;
                                        font-italic: true;
                                        font-weight: 500;
                                        vertical-alignment: center;
                                    }
                                }

                                // Fallback line 2 if movie or no downloaded season items yet:
                                if (!item.is-series || item.downloaded-seasons.length == 0) : HorizontalLayout {
                                    height: 2.2 * root.unit;
                                    spacing: 0.6 * root.unit;
                                    alignment: start;

                                    if (item.coverage != "") : VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            height: 1.9 * root.unit;
                                            border-radius: 4px;
                                            background: Theme.control-background;

                                            HorizontalLayout {
                                                padding-left: 0.6 * root.unit;
                                                padding-right: 0.6 * root.unit;
                                                Text {
                                                    text: item.coverage;
                                                    color: Theme.text-secondary;
                                                    font-size: 0.85 * root.unit;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }

                                // Line 3: Status (or Hovered Episode Info), Subtitles Badge
                                HorizontalLayout {
                                    height: 1.8 * root.unit;
                                    spacing: 1.0 * root.unit;
                                    alignment: start;

                                    if (item.watched) : VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            height: 1.7 * root.unit;
                                            border-radius: 4px;
                                            background: Theme.primary-accent.with-alpha(0.22);

                                            HorizontalLayout {
                                                height: 100%;
                                                padding-left: 0.45 * root.unit;
                                                padding-right: 0.5 * root.unit;
                                                spacing: 0.3 * root.unit;
                                                alignment: center;

                                                VerticalLayout {
                                                    alignment: center;
                                                    Image {
                                                        width: 0.8 * root.unit;
                                                        height: 0.8 * root.unit;
                                                        source: @image-url("../assets/images/icons/checkmark.svg");
                                                        colorize: Theme.primary-foreground;
                                                        image-fit: contain;
                                                    }
                                                }

                                                Text {
                                                    text: "Visto";
                                                    color: Theme.primary-foreground;
                                                    font-size: 0.78 * root.unit;
                                                    font-weight: 650;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }

                                    if (!item.is-series && item.watch-progress > 0 && !item.watched) : VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 5 * root.unit;
                                            height: 0.35 * root.unit;
                                            border-radius: self.height / 2;
                                            background: Theme.control-background;

                                            Rectangle {
                                                width: parent.width * min(1.0, item.watch-progress);
                                                height: parent.height;
                                                border-radius: self.height / 2;
                                                background: Theme.accent;
                                            }
                                        }
                                    }

                                    Text {
                                        horizontal-stretch: 1;
                                        text: card.hovered-ep-info != "" ? card.hovered-ep-info : item.status;
                                        color: card.hovered-ep-info != ""
                                            ? #c4b5fd
                                            : (item.has-failed ? #fca5a5 : (item.is-paused && !item.is-downloading ? #fde68a : Theme.text-secondary));
                                        font-size: 0.88 * root.unit;
                                        font-weight: card.hovered-ep-info != "" ? 650 : 500;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }

                                    if (item.has-subtitles) : VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            height: 1.7 * root.unit;
                                            border-radius: 4px;
                                            background: Theme.control-background;
                                            border-width: 1px;
                                            border-color: Theme.divider;

                                            HorizontalLayout {
                                                height: 100%;
                                                padding-left: 0.5 * root.unit;
                                                padding-right: 0.5 * root.unit;
                                                spacing: 0.35 * root.unit;
                                                alignment: center;

                                                Rectangle {
                                                    width: 0.9 * root.unit;
                                                    height: parent.height;
                                                    background: transparent;

                                                    Image {
                                                        x: 0px;
                                                        y: (parent.height - self.height) / 2;
                                                        width: 0.9 * root.unit;
                                                        height: 0.9 * root.unit;
                                                        source: @image-url("../assets/images/icons/subtitles.svg");
                                                        colorize: Theme.text-secondary;
                                                        image-fit: contain;
                                                    }
                                                }

                                                Text {
                                                    height: parent.height;
                                                    text: item.subtitles-info;
                                                    color: Theme.text-secondary;
                                                    font-size: 0.8 * root.unit;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }

                                // Line 4: Progress Bar
                                Rectangle {
                                    height: 4px;
                                    border-radius: 2px;
                                    background: Theme.overlay-color;
                                    clip: true;

                                    Rectangle {
                                        x: 0px;
                                        y: 0px;
                                        width: parent.width * item.progress.clamp(0, 1);
                                        height: parent.height;
                                        border-radius: parent.border-radius;
                                        background: item.has-failed && !item.is-downloading
                                            ? Theme.danger
                                            : (item.is-paused && !item.is-downloading ? #f59e0b : Theme.accent);
                                    }
                                }
                            }

                            // Actions
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 0;
                                spacing: 0.45 * root.unit;

                                HorizontalLayout {
                                    alignment: end;
                                    spacing: 0.6 * root.unit;

                                    if (item.can-play) : PillButton {
                                        width: 9.4 * root.unit;
                                        height: 2.8 * root.unit;
                                        unit: root.unit;
                                        label: @tr("CTX_PLAY" => "Reproducir");
                                        label-font-size: 0.86 * root.unit;
                                        primary: true;
                                        clicked => { root.play(item.id); }
                                    }
                                    if (item.can-pause) : PillButton {
                                        width: 7.6 * root.unit;
                                        height: 2.8 * root.unit;
                                        unit: root.unit;
                                        label: @tr("PAUSE" => "Pausar");
                                        label-font-size: 0.86 * root.unit;
                                        clicked => { root.pause(item.id); }
                                    }
                                    if (item.can-resume) : PillButton {
                                        width: 8.8 * root.unit;
                                        height: 2.8 * root.unit;
                                        unit: root.unit;
                                        label: item.has-failed && !item.is-paused ? @tr("RETRY" => "Reintentar") : @tr("RESUME" => "Reanudar");
                                        label-font-size: 0.86 * root.unit;
                                        clicked => { root.resume(item.id); }
                                    }
                                    if (item.is-series) : PillButton {
                                        width: 9.6 * root.unit;
                                        height: 2.8 * root.unit;
                                        unit: root.unit;
                                        label: card.is-expanded ? @tr("COLLAPSE" => "Ocultar ▲") : @tr("EXPAND" => "Capítulos ▼");
                                        label-font-size: 0.86 * root.unit;
                                        clicked => {
                                            if (root.expanded-id == item.id) {
                                                root.expanded-id = "";
                                            } else {
                                                root.expanded-id = item.id;
                                            }
                                        }
                                    }
                                    if (item.can-delete && !item.can-change-source && !item.can-cancel) : PillButton {
                                        width: 7.8 * root.unit;
                                        height: 2.8 * root.unit;
                                        unit: root.unit;
                                        label: @tr("DELETE" => "Eliminar");
                                        label-font-size: 0.86 * root.unit;
                                        outlined: true;
                                        hover-color: Theme.danger.with-alpha(0.2);
                                        hover-outline-color: Theme.danger;
                                        clicked => { root.delete-item(item.id); }
                                    }
                                }

                                if (item.can-change-source || item.can-cancel) : HorizontalLayout {
                                    alignment: end;
                                    spacing: 0.6 * root.unit;

                                    if (item.can-change-source) : PillButton {
                                        width: 10.5 * root.unit;
                                        height: 2.8 * root.unit;
                                        unit: root.unit;
                                        label: "Cambiar fuente";
                                        label-font-size: 0.84 * root.unit;
                                        outlined: true;
                                        clicked => {
                                            root.request-download-episode(
                                                item.meta-id,
                                                item.is-series ? -2 : -1,
                                                -1,
                                                true
                                            );
                                        }
                                    }
                                    if (item.can-cancel) : PillButton {
                                        width: 7.8 * root.unit;
                                        height: 2.8 * root.unit;
                                        unit: root.unit;
                                        label: @tr("CANCEL" => "Cancelar");
                                        label-font-size: 0.86 * root.unit;
                                        outlined: true;
                                        hover-color: Theme.danger.with-alpha(0.2);
                                        hover-outline-color: Theme.danger;
                                        clicked => { root.cancel(item.id); }
                                    }
                                    if (item.can-delete && (!item.can-cancel || item.can-play || item.has-failed)) : PillButton {
                                        width: 7.8 * root.unit;
                                        height: 2.8 * root.unit;
                                        unit: root.unit;
                                        label: @tr("DELETE" => "Eliminar");
                                        label-font-size: 0.86 * root.unit;
                                        outlined: true;
                                        hover-color: Theme.danger.with-alpha(0.2);
                                        hover-outline-color: Theme.danger;
                                        clicked => { root.delete-item(item.id); }
                                    }
                                }
                            }
                        }

                        if (item.error-message != "") : Rectangle {
                            height: card-error-layout.preferred-height;
                            border-radius: 6px;
                            background: Theme.danger.with-alpha(0.14);
                            border-width: 1px;
                            border-color: Theme.danger.with-alpha(0.38);

                            card-error-layout := HorizontalLayout {
                                padding-left: 0.9 * root.unit;
                                padding-right: 0.9 * root.unit;
                                padding-top: 0.6 * root.unit;
                                padding-bottom: 0.6 * root.unit;
                                spacing: 0.6 * root.unit;

                                Text {
                                    horizontal-stretch: 1;
                                    text: item.error-message;
                                    color: #fecaca;
                                    font-size: 0.84 * root.unit;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        // Single chapter list: collapsed shows seasons that have at
                        // least one download; expanded shows every season.
                        if (item.is-series) : VerticalLayout {
                            spacing: 0.8 * root.unit;
                            padding-top: 0.6 * root.unit;

                            Rectangle {
                                height: 1px;
                                background: Theme.divider;
                            }

                            if (card.is-expanded) : HorizontalLayout {
                                alignment: space-between;
                                spacing: 1.0 * root.unit;
                                padding-top: 0.2 * root.unit;
                                padding-bottom: 0.2 * root.unit;

                                Text {
                                    horizontal-stretch: 0;
                                    text: @tr("ALL_CHAPTERS" => "Todos los capítulos");
                                    color: Theme.text-primary;
                                    font-size: 0.95 * root.unit;
                                    font-weight: 700;
                                }

                                Text {
                                    horizontal-stretch: 1;
                                    horizontal-alignment: right;
                                    text: card.hovered-ep-info != "" ? card.hovered-ep-info : @tr("CHAPTER_HINT" => "Iluminados: descargados · Click en capítulo o temporada para gestionar");
                                    color: card.hovered-ep-info != "" ? #c4b5fd : Theme.text-muted;
                                    font-size: 0.82 * root.unit;
                                    font-weight: card.hovered-ep-info != "" ? 650 : 450;
                                    overflow: elide;
                                }
                            }

                            if (item.all-seasons.length == 0) : Text {
                                text: @tr("NO_SEASONS_AVAILABLE" => "No hay información de capítulos disponible para esta serie.");
                                color: Theme.text-secondary;
                                font-size: 0.88 * root.unit;
                                wrap: word-wrap;
                            }

                            for s in item.all-seasons : Rectangle {
                                property <bool> season-visible: card.is-expanded || s.has-downloaded || s.has-active || s.has-paused || s.has-failed;
                                visible: self.season-visible;
                                height: self.season-visible ? 3.1 * root.unit : 0px;
                                clip: true;
                                background: transparent;

                                HorizontalLayout {
                                    width: 100%;
                                    height: 3.1 * root.unit;
                                    spacing: 0.8 * root.unit;

                                // Season Pill on left: "T1 · 2017", "T2 · 2022", etc. (Clickable!) - squircle sin borde
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 0;
                                    Rectangle {
                                        width: s.season-year != "" ? 7.0 * root.unit : 3.8 * root.unit;
                                        height: 2.8 * root.unit;
                                        border-radius: 6px;
                                        background: season-pill-touch.has-hover ? #28263d : Theme.control-background;

                                        season-pill-touch := TouchArea {
                                            mouse-cursor: MouseCursor.pointer;
                                            moved => {
                                                card.hovered-ep-info = s.season-label + (s.season-year != "" ? " (" + s.season-year + ")" : "") + (s.has-active || s.has-paused ? " — Click para pausar, cancelar o cambiar fuente" : (s.has-downloaded ? " — Click para descargar o eliminar temporada" : " — Click para buscar y descargar temporada"));
                                            }
                                            clicked => {
                                                root.prompt-download-meta-id = item.meta-id;
                                                root.prompt-download-title = item.title;
                                                root.prompt-download-season = s.season;
                                                root.prompt-download-episode = 0;
                                                root.prompt-download-ep-title = "";
                                                root.prompt-download-job-id = "";
                                                root.prompt-download-is-downloaded = false;
                                                root.prompt-download-is-downloading = false;
                                                root.prompt-download-is-paused = false;
                                                root.prompt-download-is-failed = false;
                                                root.prompt-download-progress = 0.0;
                                                root.prompt-download-error = "";
                                                root.prompt-download-season-has-dl = s.has-downloaded;
                                                root.prompt-download-season-has-active = s.has-active;
                                                root.prompt-download-season-has-paused = s.has-paused;
                                                root.prompt-download-season-label = s.season-label;
                                                root.prompt-download-season-year = s.season-year;
                                                root.prompt-download-open = true;
                                            }
                                        }

                                        Text {
                                            width: 100%;
                                            height: 100%;
                                            text: s.season-year != "" ? (s.season-label + " · " + s.season-year) : s.season-label;
                                            color: season-pill-touch.has-hover ? #c4b5fd : Theme.text-primary;
                                            font-size: 0.86 * root.unit;
                                            font-weight: 750;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Horizontal strip of episodes: E1 E2 E3 ... EN (scrollable so long seasons never clip)
                                ep-scroll := ScrollView {
                                    horizontal-stretch: 1;
                                    height: 3.1 * root.unit;
                                    viewport-width: max(self.visible-width, ep-strip.preferred-width);
                                    viewport-height: self.visible-height;
                                    vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                                    horizontal-scrollbar-policy: ScrollBarPolicy.as-needed;

                                    ep-strip := HorizontalLayout {
                                        spacing: 0.45 * root.unit;
                                        alignment: start;

                                        for ep in s.episodes : VerticalLayout {
                                            alignment: center;
                                            horizontal-stretch: 0;
                                            Rectangle {
                                                width: ep-grid-touch.has-hover && ep.title != ""
                                                    ? min(22 * root.unit, 4.0 * root.unit + ep-title-measure.preferred-width + 1.4 * root.unit)
                                                    : 4.0 * root.unit;
                                                height: 2.8 * root.unit;
                                                border-radius: 6px;
                                                border-width: ep.is-failed || ep.is-downloading || ep.is-paused ? 1px : 0px;
                                                border-color: ep.is-failed
                                                    ? Theme.danger.with-alpha(0.65)
                                                    : (ep.is-downloading
                                                        ? #38bdf8.with-alpha(0.55)
                                                        : (ep.is-paused ? #f59e0b.with-alpha(0.65) : transparent));
                                                clip: true;
                                                animate width { duration: Theme.motion-panel; easing: ease-out; }
                                                background: ep.is-downloaded
                                                    ? (ep-grid-touch.has-hover ? #8b5cf6 : Theme.primary-accent.with-alpha(0.35))
                                                    : (ep.is-downloading
                                                        ? (ep-grid-touch.has-hover ? #0284c7.with-alpha(0.45) : #0ea5e9.with-alpha(0.24))
                                                        : (ep.is-paused
                                                            ? (ep-grid-touch.has-hover ? #f59e0b.with-alpha(0.40) : #f59e0b.with-alpha(0.24))
                                                            : (ep.is-failed
                                                                ? (ep-grid-touch.has-hover ? Theme.danger.with-alpha(0.42) : Theme.danger.with-alpha(0.24))
                                                                : (ep-grid-touch.has-hover ? #28283c : #181824))));

                                                ep-title-measure := Text {
                                                    visible: false;
                                                    text: ep.title;
                                                    font-size: 0.78 * root.unit;
                                                }

                                                if (ep.is-downloading) : Rectangle {
                                                    x: 0px;
                                                    y: parent.height - 3px;
                                                    width: parent.width * max(0.08, min(1.0, ep.progress));
                                                    height: 3px;
                                                    background: #38bdf8;
                                                }

                                                if (ep.is-paused) : Rectangle {
                                                    x: 0px;
                                                    y: parent.height - 3px;
                                                    width: parent.width * max(0.08, min(1.0, ep.progress));
                                                    height: 3px;
                                                    background: #f59e0b;
                                                }

                                                if (!ep.is-downloading && !ep.is-paused && ep.watch-progress > 0) : Rectangle {
                                                    x: 0px;
                                                    y: parent.height - 3px;
                                                    width: parent.width * min(1.0, ep.watch-progress);
                                                    height: 3px;
                                                    background: Theme.accent;
                                                }

                                                ep-grid-touch := TouchArea {
                                                    mouse-cursor: MouseCursor.pointer;
                                                    moved => {
                                                        card.hovered-ep-info = s.season-label + " · E" + ep.episode-num
                                                            + (ep.title != "" ? ": " + ep.title : "")
                                                            + (ep.is-downloaded
                                                                ? " (Descargado — click para reproducir, click derecho para opciones)"
                                                                : (ep.is-downloading
                                                                    ? " (Descargando " + Math.round(ep.progress * 100) + "% — click para pausar, cancelar o cambiar fuente)"
                                                                    : (ep.is-paused
                                                                        ? " (Pausado " + Math.round(ep.progress * 100) + "% — click para reanudar, cancelar o cambiar fuente)"
                                                                        : (ep.is-failed
                                                                            ? " (Error: " + ep.error-message + ")"
                                                                            : " (No descargado — click para descargar)"))));
                                                    }
                                                    clicked => {
                                                        if (ep.is-downloaded) {
                                                            root.play(ep.id);
                                                        } else {
                                                            root.prompt-download-meta-id = item.meta-id;
                                                            root.prompt-download-title = item.title;
                                                            root.prompt-download-season = ep.season;
                                                            root.prompt-download-episode = ep.episode-num;
                                                            root.prompt-download-ep-title = ep.title;
                                                            root.prompt-download-job-id = ep.id;
                                                            root.prompt-download-is-downloaded = false;
                                                            root.prompt-download-is-downloading = ep.is-downloading;
                                                            root.prompt-download-is-paused = ep.is-paused;
                                                            root.prompt-download-is-failed = ep.is-failed;
                                                            root.prompt-download-progress = ep.progress;
                                                            root.prompt-download-error = ep.error-message;
                                                            root.prompt-download-season-has-dl = s.has-downloaded;
                                                            root.prompt-download-season-has-active = s.has-active;
                                                            root.prompt-download-season-has-paused = s.has-paused;
                                                            root.prompt-download-season-label = s.season-label;
                                                            root.prompt-download-season-year = s.season-year;
                                                            root.prompt-download-open = true;
                                                        }
                                                    }
                                                    pointer-event(event) => {
                                                        if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                                                            root.prompt-download-meta-id = item.meta-id;
                                                            root.prompt-download-title = item.title;
                                                            root.prompt-download-season = ep.season;
                                                            root.prompt-download-episode = ep.episode-num;
                                                            root.prompt-download-ep-title = ep.title;
                                                            root.prompt-download-job-id = ep.id;
                                                            root.prompt-download-is-downloaded = ep.is-downloaded;
                                                            root.prompt-download-is-downloading = ep.is-downloading;
                                                            root.prompt-download-is-paused = ep.is-paused;
                                                            root.prompt-download-is-failed = ep.is-failed;
                                                            root.prompt-download-progress = ep.progress;
                                                            root.prompt-download-error = ep.error-message;
                                                            root.prompt-download-season-has-dl = s.has-downloaded;
                                                            root.prompt-download-season-has-active = s.has-active;
                                                            root.prompt-download-season-has-paused = s.has-paused;
                                                            root.prompt-download-season-label = s.season-label;
                                                            root.prompt-download-season-year = s.season-year;
                                                            root.prompt-download-open = true;
                                                        }
                                                    }
                                                }

                                                if (ep.watched) : Image {
                                                    x: parent.width - 0.95 * root.unit;
                                                    y: 0.2 * root.unit;
                                                    width: 0.65 * root.unit;
                                                    height: 0.65 * root.unit;
                                                    source: @image-url("../assets/images/icons/checkmark.svg");
                                                    colorize: Theme.primary-foreground;
                                                    image-fit: contain;
                                                }

                                                HorizontalLayout {
                                                    width: 100%;
                                                    height: 100%;
                                                    alignment: center;
                                                    spacing: 0.3 * root.unit;

                                                    if (ep.is-downloaded) : Rectangle {
                                                        width: 0.85 * root.unit;
                                                        height: parent.height;
                                                        background: transparent;

                                                        Image {
                                                            x: 0px;
                                                            y: (parent.height - self.height) / 2;
                                                            width: 0.85 * root.unit;
                                                            height: 0.85 * root.unit;
                                                            source: @image-url("../assets/images/icons/play.svg");
                                                            colorize: Theme.primary-foreground;
                                                            image-fit: contain;
                                                        }
                                                    }

                                                    if (ep.is-paused) : Rectangle {
                                                        width: 0.85 * root.unit;
                                                        height: parent.height;
                                                        background: transparent;

                                                        Image {
                                                            x: 0px;
                                                            y: (parent.height - self.height) / 2;
                                                            width: 0.85 * root.unit;
                                                            height: 0.85 * root.unit;
                                                            source: @image-url("../assets/images/icons/pause.svg");
                                                            colorize: #fde68a;
                                                            image-fit: contain;
                                                        }
                                                    }

                                                    if (!ep.is-downloaded && !ep.is-paused) : Rectangle {
                                                        width: 0.85 * root.unit;
                                                        height: parent.height;
                                                        background: transparent;

                                                        Image {
                                                            x: 0px;
                                                            y: (parent.height - self.height) / 2;
                                                            width: 0.85 * root.unit;
                                                            height: 0.85 * root.unit;
                                                            source: @image-url("../assets/images/icons/download.svg");
                                                            colorize: ep.is-failed
                                                                ? #fecaca
                                                                : (ep.is-downloading
                                                                    ? #7dd3fc
                                                                    : (ep-grid-touch.has-hover ? Theme.text-primary : Theme.text-muted));
                                                            image-fit: contain;
                                                        }
                                                    }

                                                    Text {
                                                        height: parent.height;
                                                        text: "E" + ep.episode-num;
                                                        color: ep.is-downloaded
                                                            ? Theme.primary-foreground
                                                            : (ep.is-failed
                                                                ? #fecaca
                                                                : (ep.is-downloading
                                                                    ? #bae6fd
                                                                    : (ep.is-paused
                                                                        ? #fef3c7
                                                                        : (ep-grid-touch.has-hover ? Theme.text-primary : Theme.text-muted))));
                                                        font-size: 0.88 * root.unit;
                                                        font-weight: ep.is-downloaded || ep.is-downloading || ep.is-paused || ep.is-failed ? 750 : 550;
                                                        vertical-alignment: center;
                                                    }

                                                    if (ep-grid-touch.has-hover && ep.title != "") : Text {
                                                        horizontal-stretch: 1;
                                                        height: parent.height;
                                                        text: ep.title;
                                                        color: ep.is-downloaded ? Theme.primary-foreground : Theme.text-primary;
                                                        font-size: 0.76 * root.unit;
                                                        font-weight: 500;
                                                        vertical-alignment: center;
                                                        overflow: elide;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ModalDialog for Episode / Season Actions (Play, Pause, Resume, Cancel, Change source, Download, Delete)
    ModalDialog {
        width: 100%;
        height: 100%;
        z: 2000;
        unit: root.unit;
        open: root.prompt-download-open;
        title: root.prompt-download-episode == 0
            ? ("Gestionar " + (root.prompt-download-season-label != "" ? root.prompt-download-season-label : ("Temporada " + root.prompt-download-season)))
            : (root.prompt-download-is-downloaded
                ? "Capítulo descargado"
                : (root.prompt-download-is-downloading
                    ? "Descargando capítulo"
                    : (root.prompt-download-is-paused
                        ? "Descarga pausada"
                        : (root.prompt-download-is-failed ? "Error en descarga de capítulo" : "Descargar capítulo"))));
        dialog-width: 54 * root.unit;
        dialog-height: 29 * root.unit;
        close-requested => { root.prompt-download-open = false; }

        VerticalLayout {
            padding: 0px;
            spacing: 1.2 * root.unit;

            Rectangle {
                height: 5.0 * root.unit;
                border-radius: Theme.border-radius;
                background: Theme.control-background;
                border-width: 1px;
                border-color: Theme.divider;

                VerticalLayout {
                    padding-left: 1.2 * root.unit;
                    padding-right: 1.2 * root.unit;
                    alignment: center;
                    spacing: 0.35 * root.unit;

                    Text {
                        text: root.prompt-download-title;
                        color: Theme.text-primary;
                        font-size: 1.1 * root.unit;
                        font-weight: 700;
                        overflow: elide;
                    }

                    Text {
                        text: root.prompt-download-episode == 0
                            ? ((root.prompt-download-season-label != "" ? root.prompt-download-season-label : ("Temporada " + root.prompt-download-season)) + (root.prompt-download-season-year != "" ? (" · " + root.prompt-download-season-year) : ""))
                            : ((root.prompt-download-season-label != "" ? root.prompt-download-season-label : ("Temporada " + root.prompt-download-season)) + " · Episodio " + root.prompt-download-episode + (root.prompt-download-ep-title != "" ? (": " + root.prompt-download-ep-title) : ""));
                        color: Theme.accent;
                        font-size: 0.92 * root.unit;
                        font-weight: 650;
                        overflow: elide;
                    }
                }
            }

            if (root.prompt-download-is-failed && root.prompt-download-error != "") : Rectangle {
                height: prompt-error-box.preferred-height;
                border-radius: Theme.border-radius;
                background: Theme.danger.with-alpha(0.16);
                border-width: 1px;
                border-color: Theme.danger.with-alpha(0.45);

                prompt-error-box := HorizontalLayout {
                    padding: 0.85 * root.unit;

                    Text {
                        horizontal-stretch: 1;
                        text: root.prompt-download-error;
                        color: #fecaca;
                        font-size: 0.88 * root.unit;
                        wrap: word-wrap;
                    }
                }
            }

            if (!root.prompt-download-is-failed) : Text {
                text: root.prompt-download-episode == 0
                    ? (root.prompt-download-season-has-active
                        ? "Esta temporada tiene capítulos descargándose. Podés pausarlos, cancelar los pendientes o elegir una fuente diferente."
                        : (root.prompt-download-season-has-paused
                            ? "Esta temporada tiene descargas pausadas. Podés reanudarlas, cancelarlas o cambiar la fuente."
                            : (root.prompt-download-season-has-dl
                                ? "Podés buscar fuentes para descargar la temporada completa o eliminar los capítulos ya descargados de esta temporada."
                                : "¿Deseás buscar fuentes para descargar esta temporada?")))
                    : (root.prompt-download-is-downloaded
                        ? "Este capítulo ya está descargado en tu equipo. ¿Deseás reproducirlo o eliminarlo del disco?"
                        : (root.prompt-download-is-downloading
                            ? ("Este capítulo se está descargando (" + Math.round(root.prompt-download-progress * 100) + "%). Podés pausar, cancelar o elegir otra fuente.")
                            : (root.prompt-download-is-paused
                                ? ("La descarga de este capítulo está pausada (" + Math.round(root.prompt-download-progress * 100) + "%). Podés reanudarla, cancelarla o cambiar de fuente.")
                                : "Este capítulo no está descargado aún. Podés buscar fuentes para descargar solo este capítulo o toda la temporada.")));
                color: Theme.text-secondary;
                font-size: 0.9 * root.unit;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 0.65 * root.unit;
                alignment: end;
                padding-top: 0.5 * root.unit;

                PillButton {
                    width: 6.5 * root.unit;
                    unit: root.unit;
                    label: @tr("CLOSE" => "Cerrar");
                    outlined: true;
                    clicked => { root.prompt-download-open = false; }
                }

                // Case 1: Season pill clicked (episode == 0)
                if (root.prompt-download-episode == 0 && root.prompt-download-season-has-dl) : PillButton {
                    width: 11.5 * root.unit;
                    unit: root.unit;
                    label: "Eliminar temporada";
                    outlined: true;
                    hover-color: Theme.danger.with-alpha(0.2);
                    hover-outline-color: Theme.danger;
                    clicked => {
                        root.delete-item("season:" + root.prompt-download-meta-id + ":" + root.prompt-download-season);
                        root.prompt-download-open = false;
                    }
                }

                if (root.prompt-download-episode == 0 && (root.prompt-download-season-has-active || root.prompt-download-season-has-paused)) : PillButton {
                    width: 7.5 * root.unit;
                    unit: root.unit;
                    label: @tr("CANCEL" => "Cancelar");
                    outlined: true;
                    hover-color: Theme.danger.with-alpha(0.2);
                    hover-outline-color: Theme.danger;
                    clicked => {
                        root.cancel("season:" + root.prompt-download-meta-id + ":" + root.prompt-download-season);
                        root.prompt-download-open = false;
                    }
                }

                if (root.prompt-download-episode == 0 && root.prompt-download-season-has-active) : PillButton {
                    width: 7.5 * root.unit;
                    unit: root.unit;
                    label: @tr("PAUSE" => "Pausar");
                    outlined: true;
                    clicked => {
                        root.pause("season:" + root.prompt-download-meta-id + ":" + root.prompt-download-season);
                        root.prompt-download-open = false;
                    }
                }

                if (root.prompt-download-episode == 0 && !root.prompt-download-season-has-active && root.prompt-download-season-has-paused) : PillButton {
                    width: 8.2 * root.unit;
                    unit: root.unit;
                    label: @tr("RESUME" => "Reanudar");
                    outlined: true;
                    clicked => {
                        root.resume("season:" + root.prompt-download-meta-id + ":" + root.prompt-download-season);
                        root.prompt-download-open = false;
                    }
                }

                if (root.prompt-download-episode == 0 && (root.prompt-download-season-has-active || root.prompt-download-season-has-paused)) : PillButton {
                    width: 10.5 * root.unit;
                    unit: root.unit;
                    label: "Cambiar fuente";
                    primary: true;
                    clicked => {
                        root.request-download-episode(root.prompt-download-meta-id, root.prompt-download-season, 0, true);
                        root.prompt-download-open = false;
                    }
                }

                if (root.prompt-download-episode == 0 && !root.prompt-download-season-has-active && !root.prompt-download-season-has-paused) : PillButton {
                    width: 12.5 * root.unit;
                    unit: root.unit;
                    label: "Descargar temporada";
                    primary: true;
                    clicked => {
                        root.request-download-episode(root.prompt-download-meta-id, root.prompt-download-season, 0, false);
                        root.prompt-download-open = false;
                    }
                }

                // Case 2: Downloaded episode clicked (episode > 0 && is-downloaded)
                if (root.prompt-download-episode > 0 && root.prompt-download-is-downloaded) : PillButton {
                    width: 11.5 * root.unit;
                    unit: root.unit;
                    label: "Eliminar capítulo";
                    outlined: true;
                    hover-color: Theme.danger.with-alpha(0.2);
                    hover-outline-color: Theme.danger;
                    clicked => {
                        root.delete-item(root.prompt-download-job-id);
                        root.prompt-download-open = false;
                    }
                }

                if (root.prompt-download-episode > 0 && root.prompt-download-is-downloaded) : PillButton {
                    width: 11.5 * root.unit;
                    unit: root.unit;
                    label: "Reproducir";
                    primary: true;
                    clicked => {
                        root.play(root.prompt-download-job-id);
                        root.prompt-download-open = false;
                    }
                }

                // Case 3: Downloading episode clicked
                if (root.prompt-download-episode > 0 && root.prompt-download-is-downloading) : PillButton {
                    width: 8.5 * root.unit;
                    unit: root.unit;
                    label: @tr("CANCEL" => "Cancelar");
                    outlined: true;
                    hover-color: Theme.danger.with-alpha(0.2);
                    hover-outline-color: Theme.danger;
                    clicked => {
                        root.cancel(root.prompt-download-job-id);
                        root.prompt-download-open = false;
                    }
                }

                if (root.prompt-download-episode > 0 && root.prompt-download-is-downloading) : PillButton {
                    width: 8.5 * root.unit;
                    unit: root.unit;
                    label: @tr("PAUSE" => "Pausar");
                    outlined: true;
                    clicked => {
                        root.pause(root.prompt-download-job-id);
                        root.prompt-download-open = false;
                    }
                }

                if (root.prompt-download-episode > 0 && root.prompt-download-is-downloading) : PillButton {
                    width: 11.5 * root.unit;
                    unit: root.unit;
                    label: "Cambiar fuente";
                    primary: true;
                    clicked => {
                        root.request-download-episode(root.prompt-download-meta-id, root.prompt-download-season, root.prompt-download-episode, true);
                        root.prompt-download-open = false;
                    }
                }

                // Case 4: Paused episode clicked
                if (root.prompt-download-episode > 0 && root.prompt-download-is-paused) : PillButton {
                    width: 8.5 * root.unit;
                    unit: root.unit;
                    label: @tr("CANCEL" => "Cancelar");
                    outlined: true;
                    hover-color: Theme.danger.with-alpha(0.2);
                    hover-outline-color: Theme.danger;
                    clicked => {
                        root.cancel(root.prompt-download-job-id);
                        root.prompt-download-open = false;
                    }
                }

                if (root.prompt-download-episode > 0 && root.prompt-download-is-paused) : PillButton {
                    width: 11.5 * root.unit;
                    unit: root.unit;
                    label: "Cambiar fuente";
                    outlined: true;
                    clicked => {
                        root.request-download-episode(root.prompt-download-meta-id, root.prompt-download-season, root.prompt-download-episode, true);
                        root.prompt-download-open = false;
                    }
                }

                if (root.prompt-download-episode > 0 && root.prompt-download-is-paused) : PillButton {
                    width: 9.5 * root.unit;
                    unit: root.unit;
                    label: @tr("RESUME" => "Reanudar");
                    primary: true;
                    clicked => {
                        root.resume(root.prompt-download-job-id);
                        root.prompt-download-open = false;
                    }
                }

                // Case 5: Failed episode clicked (episode > 0 && is-failed)
                if (root.prompt-download-episode > 0 && root.prompt-download-is-failed) : PillButton {
                    width: 8.0 * root.unit;
                    unit: root.unit;
                    label: "Eliminar";
                    outlined: true;
                    hover-color: Theme.danger.with-alpha(0.2);
                    hover-outline-color: Theme.danger;
                    clicked => {
                        root.delete-item(root.prompt-download-job-id);
                        root.prompt-download-open = false;
                    }
                }

                if (root.prompt-download-episode > 0 && root.prompt-download-is-failed) : PillButton {
                    width: 9.0 * root.unit;
                    unit: root.unit;
                    label: "Reintentar";
                    outlined: true;
                    clicked => {
                        root.resume(root.prompt-download-job-id);
                        root.prompt-download-open = false;
                    }
                }

                if (root.prompt-download-episode > 0 && root.prompt-download-is-failed) : PillButton {
                    width: 11.5 * root.unit;
                    unit: root.unit;
                    label: "Cambiar fuente";
                    primary: true;
                    clicked => {
                        root.request-download-episode(root.prompt-download-meta-id, root.prompt-download-season, root.prompt-download-episode, true);
                        root.prompt-download-open = false;
                    }
                }

                // Case 6: Un-downloaded episode clicked
                if (root.prompt-download-episode > 0 && !root.prompt-download-is-downloaded && !root.prompt-download-is-downloading && !root.prompt-download-is-paused && !root.prompt-download-is-failed) : PillButton {
                    width: 13.0 * root.unit;
                    unit: root.unit;
                    label: "Descargar temporada";
                    outlined: true;
                    clicked => {
                        root.request-download-episode(root.prompt-download-meta-id, root.prompt-download-season, 0, false);
                        root.prompt-download-open = false;
                    }
                }

                if (root.prompt-download-episode > 0 && !root.prompt-download-is-downloaded && !root.prompt-download-is-downloading && !root.prompt-download-is-paused && !root.prompt-download-is-failed) : PillButton {
                    width: 13.0 * root.unit;
                    unit: root.unit;
                    label: "Buscar y descargar";
                    primary: true;
                    clicked => {
                        root.request-download-episode(root.prompt-download-meta-id, root.prompt-download-season, root.prompt-download-episode, false);
                        root.prompt-download-open = false;
                    }
                }
            }
        }
    }
}
