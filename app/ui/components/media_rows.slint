import { Theme } from "../theme.slint";
import { ButtonSurface } from "button.slint";
import { FallbackImage } from "fallback_image.slint";
import { SkeletonBlock } from "feedback.slint";

export component StreamRow inherits Rectangle {
    in property <length> unit: 16px;
    in property <string> name;
    in property <string> description;
    in property <string> title: "";
    in property <string> resolution-label: "";
    in property <string> debrid-badge: "";
    in property <bool> is-debrid-cached: false;
    in property <bool> is-debrid-uncached: false;
    in property <string> source-badge: "";
    in property <string> size-label: "";
    in property <string> seeders-label: "";
    in property <string> tech-summary: "";
    in property <string> score-label: "";
    in property <string> score-details: "";
    in property <bool> filtered: false;
    in property <image> thumbnail;
    in property <bool> has-thumbnail: root.thumbnail.width > 0;
    in property <float> progress: 0;
    in property <bool> selected: false;
    in property <bool> selection-mode: false;
    callback play;
    callback download;
    callback context-requested(length, length);

    height: 6.2 * root.unit;
    border-radius: Theme.border-radius;
    border-width: 1px;
    border-color: root.selected
        ? Theme.accent.with-alpha(0.85)
        : (root.row-hovered ? Theme.primary-accent.with-alpha(0.75) : Theme.divider);
    clip: true;
    private property <bool> download-hovered: false;
    private property <bool> play-hovered: false;
    property <bool> row-hovered: row-area.has-hover || root.download-hovered || root.play-hovered;
    background: root.selected
        ? (root.row-hovered ? Theme.primary-accent.with-alpha(0.26) : Theme.primary-accent.with-alpha(0.18))
        : (root.row-hovered ? Theme.card-background.brighter(0.55) : Theme.card-background.with-alpha(0.90));

    animate background { duration: Theme.motion-fast; }
    animate border-color { duration: Theme.motion-fast; }

    accessible-role: button;
    accessible-label: root.name + " " + root.description + " " + root.score-details;
    accessible-action-default => { root.play(); }

    row-area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.play(); }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                root.context-requested(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }

    HorizontalLayout {
        padding-left: 0.8 * root.unit;
        padding-right: 0.8 * root.unit;
        padding-top: 0.55 * root.unit;
        padding-bottom: 0.55 * root.unit;
        spacing: 0.85 * root.unit;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            stream-info := Rectangle {
                width: 6.2 * root.unit;
                height: 4.9 * root.unit;
                border-radius: 0.45 * root.unit;
                background: Theme.overlay-color;
                border-width: 1px;
                border-color: root.is-debrid-cached
                    ? #10b981.with-alpha(0.45)
                    : (root.is-debrid-uncached ? #f59e0b.with-alpha(0.4) : Theme.divider);
                clip: true;

                if (root.has-thumbnail) : FallbackImage {
                    width: parent.width;
                    height: parent.height;
                    source: root.thumbnail;
                    contain: false;

                    Image {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 1.5 * root.unit;
                        height: 1.5 * root.unit;
                        source: @image-url("../assets/images/icons/link.svg");
                        colorize: Theme.text-secondary;
                        image-fit: contain;
                    }
                }

                if (!root.has-thumbnail && (root.resolution-label != "" || root.debrid-badge != "")) : VerticalLayout {
                    alignment: center;
                    spacing: 0.28 * root.unit;
                    padding-left: 0.3 * root.unit;
                    padding-right: 0.3 * root.unit;

                    if (root.resolution-label != "") : Text {
                        text: root.resolution-label;
                        color: root.resolution-label == "4K" || root.resolution-label == "8K"
                            ? #c4b5fd
                            : (root.resolution-label == "1080p" || root.resolution-label == "1440p"
                                ? Theme.text-primary
                                : Theme.text-secondary);
                        font-size: 0.96 * root.unit;
                        font-weight: 750;
                        horizontal-alignment: center;
                    }

                    if (root.debrid-badge != "") : HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            height: 1.55 * root.unit;
                            border-radius: 0.3 * root.unit;
                            background: root.is-debrid-cached
                                ? #10b981.with-alpha(0.22)
                                : (root.is-debrid-uncached
                                    ? #f59e0b.with-alpha(0.20)
                                    : Theme.control-background);
                            border-width: 1px;
                            border-color: root.is-debrid-cached
                                ? #10b981.with-alpha(0.45)
                                : (root.is-debrid-uncached
                                    ? #f59e0b.with-alpha(0.45)
                                    : Theme.divider);

                            HorizontalLayout {
                                padding-left: 0.4 * root.unit;
                                padding-right: 0.4 * root.unit;
                                alignment: center;

                                Text {
                                    text: root.debrid-badge;
                                    color: root.is-debrid-cached
                                        ? #34d399
                                        : (root.is-debrid-uncached ? #fbbf24 : Theme.text-secondary);
                                    font-size: 0.76 * root.unit;
                                    font-weight: 750;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                if (!root.has-thumbnail && root.resolution-label == "" && root.debrid-badge == "") : Text {
                    x: 0.4 * root.unit;
                    width: parent.width - 0.8 * root.unit;
                    height: parent.height;
                    text: root.name;
                    color: Theme.text-primary;
                    opacity: 0.88;
                    font-size: 0.76 * root.unit;
                    font-weight: 600;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }

                if (root.progress > 0) : Rectangle {
                    y: parent.height - 0.3 * root.unit;
                    width: parent.width;
                    height: 0.3 * root.unit;
                    background: Theme.background.with-alpha(0.7);

                    Rectangle {
                        width: parent.width * root.progress.clamp(0, 1);
                        height: parent.height;
                        background: Theme.accent;
                    }
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            alignment: center;
            spacing: 0.32 * root.unit;

            Text {
                horizontal-stretch: 1;
                text: root.title != "" ? root.title : root.description;
                color: Theme.text-primary;
                font-size: 0.9 * root.unit;
                font-weight: 600;
                overflow: elide;
            }

            if (root.size-label != "" || root.source-badge != "" || root.seeders-label != "") : HorizontalLayout {
                spacing: 0.45 * root.unit;
                alignment: start;
                height: 1.65 * root.unit;

                if (root.size-label != "") : VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;

                    Rectangle {
                        height: 1.55 * root.unit;
                        border-radius: 4px;
                        background: Theme.primary-accent.with-alpha(0.22);
                        border-width: 1px;
                        border-color: Theme.primary-accent.with-alpha(0.45);

                        HorizontalLayout {
                            padding-left: 0.45 * root.unit;
                            padding-right: 0.45 * root.unit;

                            Text {
                                text: root.size-label;
                                color: #ede9fe;
                                font-size: 0.78 * root.unit;
                                font-weight: 750;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                if (root.source-badge != "") : VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;

                    Rectangle {
                        height: 1.55 * root.unit;
                        border-radius: 4px;
                        background: Theme.control-background;
                        border-width: 1px;
                        border-color: Theme.divider;

                        HorizontalLayout {
                            padding-left: 0.45 * root.unit;
                            padding-right: 0.45 * root.unit;

                            Text {
                                text: root.source-badge;
                                color: Theme.text-primary;
                                font-size: 0.76 * root.unit;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                if (root.seeders-label != "") : Text {
                    horizontal-stretch: 0;
                    text: root.seeders-label;
                    color: Theme.text-secondary;
                    font-size: 0.76 * root.unit;
                    font-weight: 600;
                    vertical-alignment: center;
                }

                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }
            }

            if (root.tech-summary != "") : Text {
                horizontal-stretch: 1;
                text: root.tech-summary;
                color: Theme.text-secondary;
                font-size: 0.76 * root.unit;
                font-weight: 500;
                overflow: elide;
            }
        }

        if (root.score-label != "") : VerticalLayout {
            alignment: center;
            Rectangle {
                width: 3.75 * root.unit;
                height: 1.8 * root.unit;
                border-radius: self.height / 2;
                background: root.filtered
                    ? Theme.danger.with-alpha(0.22)
                    : Theme.accent.with-alpha(0.2);

                Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.score-label;
                    color: root.filtered ? Theme.danger : Theme.accent;
                    font-size: 0.78 * root.unit;
                    font-weight: 650;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    mouse-cursor: help;
                    accessible-role: text;
                    accessible-label: root.score-details;
                }
            }
        }

        if (!root.selection-mode) : VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            width: 5.8 * root.unit;

            actions-container := HorizontalLayout {
                spacing: 0.45 * root.unit;
                alignment: end;

                download-button := ButtonSurface {
                    width: 2.6 * root.unit;
                    height: 2.6 * root.unit;
                    border-radius: self.height / 2;
                    background: self.pressed ? Theme.overlay-pressed : (self.has-hover ? Theme.overlay-hover : Theme.overlay-color);
                    accessible-name: @tr("DOWNLOAD" => "Descargar");
                    changed has-hover => { root.download-hovered = self.has-hover; }
                    clicked => { root.download(); }

                    Image {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 1.25 * root.unit;
                        height: 1.25 * root.unit;
                        source: @image-url("../assets/images/icons/download.svg");
                        colorize: Theme.text-primary;
                        image-fit: contain;
                    }
                }

                play-button := ButtonSurface {
                    width: 2.6 * root.unit;
                    height: 2.6 * root.unit;
                    border-radius: self.height / 2;
                    background: self.pressed ? Theme.success.darker(0.2) : (self.has-hover ? Theme.success.brighter(0.15) : Theme.success);
                    accessible-name: @tr("PLAY" => "Reproducir");
                    changed has-hover => { root.play-hovered = self.has-hover; }
                    clicked => { root.play(); }

                    Image {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 1.25 * root.unit;
                        height: 1.25 * root.unit;
                        source: @image-url("../assets/images/icons/play.svg");
                        colorize: Theme.text-primary;
                        image-fit: contain;
                    }
                }
            }
        }

        if (root.selection-mode) : VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            width: 2.2 * root.unit;

            Rectangle {
                width: 1.65 * root.unit;
                height: 1.65 * root.unit;
                border-radius: self.height / 2;
                border-width: 1.5px;
                border-color: root.selected ? Theme.accent : Theme.text-muted;
                background: transparent;

                if (root.selected) : Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 0.9 * root.unit;
                    height: 0.9 * root.unit;
                    border-radius: self.height / 2;
                    background: Theme.accent;
                }
            }
        }
    }
}

export component EpisodeRow inherits Rectangle {
    in property <length> unit: 16px;
    in property <string> title;
    in property <string> description: "";
    in property <string> released;
    in property <image> thumbnail;
    in property <int> episode-number;
    in property <bool> upcoming: false;
    in property <bool> watched: false;
    in property <bool> season-watched: false;
    in property <bool> scheduled: false;
    in property <bool> has-thumbnail: root.thumbnail.width > 0;
    in property <float> progress: 0;
    in property <bool> show-progress: root.progress > 0;
    in property <bool> blur-spoiler: false;
    in property <bool> selected-row: false;
    in property <bool> can-play: false;
    callback selected;
    callback play;
    callback toggle-watched;
    callback toggle-season-watched;
    callback context-requested;

    // 6rem of row plus the web's `margin-bottom: 0.5rem`, so consecutive rows
    // in a ListView are separated the way `.video-container` is.
    height: 6.5 * root.unit;
    background: transparent;
    private property <bool> selection-highlight: false;

    changed selected-row => {
        if (root.selected-row) {
            root.selection-highlight = true;
            selection-timer.restart();
        } else {
            root.selection-highlight = false;
            selection-timer.stop();
        }
    }

    selection-timer := Timer {
        interval: 3s;
        running: false;
        triggered => {
            self.stop();
            root.selection-highlight = false;
        }
    }

    video-button := ButtonSurface {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 6 * root.unit;
        enabled: !root.upcoming;
        opacity: root.upcoming ? 0.45 : 1;
        border-radius: Theme.border-radius;
        border-width: 0.15 * root.unit;
        border-color: root.selection-highlight ? Theme.primary-accent : transparent;
        background: self.has-hover || self.has-focus || root.selected-row
            ? Theme.overlay-color
            : transparent;
        accessible-name: @tr("EPISODE" => "Episode") + " " + root.episode-number + " " + root.title;
        long-press-enabled: true;
        clicked => { root.selected(); }
        long-pressed => { root.context-requested(); }

        animate background { duration: Theme.motion-fast; }
        animate border-color { duration: Theme.motion-fast; easing: ease-in-out; }

        thumbnail-frame := Rectangle {
            visible: root.has-thumbnail;
            x: 0.5 * root.unit;
            y: 0.5 * root.unit;
            width: 8 * root.unit;
            height: 5 * root.unit;
            border-radius: 0.3 * root.unit;
            background: Theme.overlay-color;
            clip: true;

            FallbackImage {
                width: parent.width;
                height: parent.height;
                source: root.thumbnail;
                primary-available: root.thumbnail.width > 0;
                image-opacity: 0.9;
                background-color: Theme.overlay-color;

                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 3 * root.unit;
                    height: 3 * root.unit;
                    source: @image-url("../assets/images/icons/symbol.svg");
                    colorize: Theme.primary-foreground;
                    opacity: 0.25;
                    image-fit: contain;
                }
            }

            if (root.show-progress && root.has-thumbnail) : Rectangle {
                x: 0.5 * root.unit;
                y: parent.height - 0.9 * root.unit;
                width: parent.width - root.unit;
                height: 0.4 * root.unit;
                border-radius: Theme.border-radius;
                background: Theme.primary-foreground.with-alpha(0.2);
                clip: true;

                Rectangle {
                    x: 0px;
                    width: parent.width * max(0, min(100, root.progress)) / 100;
                    height: parent.height;
                    background: Theme.primary-accent;
                }
            }
        }

        info := Rectangle {
            x: root.has-thumbnail ? 10 * root.unit : root.unit;
            y: 0.5 * root.unit;
            width: parent.width - self.x - (root.can-play ? 4 * root.unit : 0.5 * root.unit);
            height: 5 * root.unit;
            background: transparent;

            Text {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: root.description != "" ? 1.7 * root.unit : 2.4 * root.unit;
                text: (root.episode-number > 0 ? root.episode-number + ". " : "")
                    + root.title;
                color: Theme.primary-foreground;
                font-size: root.unit;
                font-weight: 500;
                wrap: word-wrap;
                overflow: elide;
            }

            if (root.description != "") : Text {
                x: 0px;
                y: 1.8 * root.unit;
                width: parent.width;
                height: 1.5 * root.unit;
                text: root.description;
                color: Theme.text-muted;
                font-size: 0.75 * root.unit;
                wrap: word-wrap;
                overflow: elide;
            }

            Text {
                x: 0px;
                y: 3.4 * root.unit;
                width: max(0px, parent.width - badges.width - 0.5 * root.unit);
                height: 1.2 * root.unit;
                text: root.released != "" ? root.released : (root.scheduled ? @tr("TBA" => "TBA") : "");
                color: Theme.primary-foreground;
                opacity: 0.44;
                font-size: 0.8 * root.unit;
                font-weight: 500;
                vertical-alignment: center;
                overflow: elide;
            }

            badges := Rectangle {
                x: parent.width - self.width;
                y: 3.2 * root.unit;
                width: (root.upcoming && !root.watched ? 6.5 * root.unit : 0px)
                    + (root.watched ? 7.5 * root.unit : 0px)
                    + (root.upcoming && root.watched ? 0.5 * root.unit : 0px);
                height: 1.6 * root.unit;
                background: transparent;

                if (root.upcoming && !root.watched) : Rectangle {
                    x: 0px;
                    y: 0px;
                    width: 6.5 * root.unit;
                    height: parent.height;
                    border-radius: 0.3 * root.unit;
                    background: Theme.secondary-accent.with-alpha(0.2);

                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: @tr("UPCOMING" => "Upcoming");
                        color: Theme.secondary-accent;
                        font-size: 0.8 * root.unit;
                        font-weight: 800;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                if (root.watched) : watched-button := ButtonSurface {
                    x: parent.width - self.width;
                    y: 0px;
                    width: 7.5 * root.unit;
                    height: parent.height;
                    border-radius: 0.3 * root.unit;
                    background: Theme.tertiary-accent;
                    accessible-name: @tr("CTX_MARK_UNWATCHED" => "Mark as unwatched");
                    clicked => { root.toggle-watched(); }

                    HorizontalLayout {
                        padding-left: 0.5 * root.unit;
                        padding-right: 0.5 * root.unit;
                        spacing: 0.25 * root.unit;
                        alignment: center;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                width: 1.15 * root.unit;
                                height: 1.15 * root.unit;
                                source: @image-url("../assets/images/icons/eye.svg");
                                colorize: Theme.secondary-foreground;
                                image-fit: contain;
                            }
                        }
                        Text {
                            text: @tr("WATCHED" => "Watched");
                            color: Theme.secondary-foreground;
                            font-size: 0.8 * root.unit;
                            font-weight: 800;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }

        if (root.can-play) : saved-stream-play-button := ButtonSurface {
            x: parent.width - self.width - 0.5 * root.unit;
            y: 1.5 * root.unit;
            width: 3 * root.unit;
            height: 3 * root.unit;
            border-radius: self.width / 2;
            background: self.has-hover || self.has-focus
                ? Theme.secondary-accent
                : Theme.overlay-color;
            accessible-name: @tr("CTX_WATCH" => "Watch");
            clicked => { root.play(); }

            Image {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 1.5 * root.unit;
                height: 1.5 * root.unit;
                source: @image-url("../assets/images/icons/play.svg");
                colorize: Theme.primary-foreground;
                image-fit: contain;
            }
        }
    }

    // The web Video component exposes these actions from every episode row.
    // Use the platform-native menu so right-click behavior, dismissal, and
    // keyboard navigation remain consistent with the host OS.
    ContextMenuArea {
        width: parent.width;
        height: 6 * root.unit;

        Menu {
            MenuItem {
                title: @tr("CTX_WATCH" => "Watch");
                activated => {
                    if (root.can-play) {
                        root.play();
                    } else {
                        root.selected();
                    }
                }
            }
            MenuItem {
                title: root.watched
                    ? @tr("CTX_MARK_NON_WATCHED" => "Mark as unwatched")
                    : @tr("CTX_MARK_WATCHED" => "Mark as watched");
                activated => { root.toggle-watched(); }
            }
            MenuItem {
                title: root.season-watched
                    ? @tr("CTX_UNMARK_REST" => "Mark rest as unwatched")
                    : @tr("CTX_MARK_REST" => "Mark rest as watched");
                activated => { root.toggle-season-watched(); }
            }
        }
    }
}

// Public name retained from stremio-web. EpisodeRow remains as a descriptive
// compatibility name for existing native call sites.
export component Video inherits EpisodeRow { }

export component VideoPlaceholder inherits Rectangle {
    in property <length> unit: Theme.root-font-size;
    in property <bool> has-thumbnail: false;

    private property <length> info-x: root.has-thumbnail ? 10 * root.unit : root.unit;
    private property <length> info-width: max(0px, root.width - root.info-x - root.unit);

    height: 6.5 * root.unit;
    background: transparent;

    if (root.has-thumbnail) : SkeletonBlock {
        x: 0.5 * root.unit;
        y: 0.5 * root.unit;
        width: 8 * root.unit;
        height: 5 * root.unit;
        radius: 0.3 * root.unit;
    }

    SkeletonBlock {
        x: root.info-x;
        y: 0.75 * root.unit;
        width: root.info-width * 0.8;
        height: 1.2 * root.unit;
    }

    SkeletonBlock {
        x: root.info-x;
        y: 3.75 * root.unit;
        width: root.info-width;
        height: root.unit;
    }
}
