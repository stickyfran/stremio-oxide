import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { ButtonSurface } from "button.slint";
import { ActionsGroup } from "action_group.slint";
import { SkeletonBlock } from "feedback.slint";
import { HorizontalScroll } from "horizontal_scroll.slint";
import { MetaLinkItem, MetaLinkGroup } from "types.slint";

export component MetaActionButton inherits ButtonSurface {
    in property <length> unit: Theme.root-font-size;
    in property <image> icon-source;
    in property <string> label: "";
    in property <bool> tooltip: false;
    in property <bool> emphasized: false;

    width: root.tooltip ? 4 * root.unit
        : max(4 * root.unit, label-measure.preferred-width + 6.75 * root.unit);
    height: 4 * root.unit;
    border-radius: self.height / 2;
    background: root.emphasized
        ? (root.has-hover ? transparent : Theme.secondary-accent)
        : (root.has-hover || root.has-focus ? transparent : Theme.overlay-color);
    border-width: root.has-hover || root.has-focus ? Theme.focus-outline-size : 0px;
    border-color: root.emphasized ? Theme.secondary-accent : Theme.primary-foreground;
    accessible-name: root.label;

    label-measure := Text {
        visible: false;
        text: root.label;
        font-size: root.unit;
        font-weight: 500;
    }

    Image {
        x: root.tooltip
            ? (parent.width - self.width) / 2
            : 2 * root.unit;
        y: (parent.height - self.height) / 2;
        width: 1.75 * root.unit;
        height: 1.75 * root.unit;
        source: root.icon-source;
        colorize: Theme.primary-foreground;
        opacity: 0.9;
        image-fit: contain;
    }

    if (!root.tooltip && root.label != "") : Text {
        x: 4.75 * root.unit;
        width: parent.width - 6.75 * root.unit;
        height: parent.height;
        text: root.label;
        color: Theme.primary-foreground;
        opacity: 0.9;
        font-size: root.unit;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    if (root.tooltip && root.label != "") : Text {
        x: -2 * root.unit;
        y: -3 * root.unit;
        width: parent.width + 4 * root.unit;
        height: 2.4 * root.unit;
        text: root.label;
        color: Theme.primary-foreground;
        opacity: root.has-hover || root.has-focus ? 0.7 : 0;
        font-size: root.unit;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
        animate opacity { duration: Theme.motion-panel; }
    }
}

export component MetaLinkChip inherits ButtonSurface {
    in property <length> unit: Theme.root-font-size;
    in property <MetaLinkItem> link;
    in property <string> label: root.link.label;
    in property <string> value: root.link.value;

    width: label-measure.preferred-width + 2.5 * root.unit;
    height: 2.4 * root.unit;
    border-radius: self.height / 2;
    border-width: root.has-focus ? Theme.focus-outline-size : 0px;
    border-color: Theme.primary-foreground;
    background: root.has-hover || root.has-focus
        ? Theme.surface-light-30
        : Theme.overlay-color;
    accessible-name: root.label;

    label-measure := Text {
        visible: false;
        text: root.label;
        font-size: root.unit;
        font-weight: 500;
    }

    Text {
        x: 1.25 * root.unit;
        width: parent.width - 2.5 * root.unit;
        height: parent.height;
        text: root.label;
        color: Theme.primary-foreground;
        font-size: root.unit;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}

// String-backed metadata links let Rust pages pass their existing lightweight
// models while sharing the exact MetaPreview chip and scroll behavior.
export component MetaStringLinks inherits Rectangle {
    in property <length> unit: Theme.root-font-size;
    in property <string> label: "";
    in property <[string]> values: [];
    callback link-selected(string);

    height: (root.label != "" ? 1.7 * root.unit : 0px) + 2.4 * root.unit;
    background: transparent;
    clip: true;

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        spacing: root.label != "" ? 0.7 * root.unit : 0px;
        alignment: start;

        if (root.label != "") : Text {
            horizontal-stretch: 1;
            height: root.unit;
            text: root.label;
            color: Theme.primary-foreground;
            opacity: 0.3;
            font-size: 0.95 * root.unit;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }

        HorizontalScroll {
            horizontal-stretch: 1;
            height: 2.4 * root.unit;
            unit: root.unit;
            content-width: max(root.width, link-row.preferred-width);
            content-height: self.height;
            // A solid edge scrim reads as a black rectangle when this row is
            // used over drawers and artwork. Clipping plus drag scrolling is
            // enough to communicate the remaining horizontal content.
            show-edge-fades: false;
            fade-surface-color: Theme.background;

            link-row := HorizontalLayout {
                // Keep short metadata groups flush-left. A content-sized row
                // inside ScrollView is centered by Slint's child layout when
                // it is narrower than the viewport; spanning the viewport and
                // using start alignment matches the web flex row.
                x: 0px;
                y: 0px;
                width: max(root.width, self.preferred-width);
                height: 2.4 * root.unit;
                spacing: 0.75 * root.unit;
                alignment: start;

                for value in root.values : MetaLinkChip {
                    unit: root.unit;
                    label: value;
                    value: value;
                    clicked => { root.link-selected(value); }
                }
            }
        }
    }
}

export component MetaLinks inherits Rectangle {
    in property <length> unit: Theme.root-font-size;
    in property <MetaLinkGroup> group;
    callback link-selected(string);

    height: (root.group.label != "" ? 1.7 * root.unit : 0px) + 3.15 * root.unit;
    background: transparent;
    clip: true;

    if (root.group.label != "") : Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: root.unit;
        text: root.group.label;
        color: Theme.primary-foreground;
        opacity: 0.3;
        font-size: 0.95 * root.unit;
        font-weight: 700;
        vertical-alignment: center;
        overflow: elide;
    }

    HorizontalLayout {
        x: 0px;
        y: root.group.label != "" ? 1.7 * root.unit : 0px;
        width: parent.width;
        height: 2.4 * root.unit;
        spacing: 0.75 * root.unit;
        alignment: start;

        for link in root.group.links : MetaLinkChip {
            unit: root.unit;
            link: link;
            clicked => { root.link-selected(link.value); }
        }
    }
}

// Inline trailer player embedded in the full details page. Uses Tube Oxide's
// exact `view_control_bar` layout (`#000000a6` bar, padding [8, 12], spacing 6:
// full-width red #ff0000 seek bar on top, and below:
// [Play/Pause] [Mute/Vol] [Vol Slider] [Time] ... [Speed "1x"] [Fullscreen]),
// kept mounted at all times so hover transitions never flicker.
export component TrailerMiniPlayer inherits Rectangle {
    in property <length> unit: Theme.root-font-size;
    in property <image> poster;
    in property <bool> has-trailer: false;
    in property <image> video-frame;
    in property <bool> has-video-frame: false;
    in property <bool> video-loading: false;
    in property <bool> video-playing: false;
    in property <bool> video-muted: true;
    in property <float> video-volume: 0.75;
    in property <float> video-speed: 1.0;
    in property <float> video-progress: 0.0;
    in property <string> video-time-label: "";

    callback toggle-playback;
    callback toggle-muted;
    callback change-volume(float);
    callback change-speed(float);
    callback maximize;
    callback seek-relative(float);
    callback seek-progress(float);

    height: self.width * 9 / 16;
    background: #000000;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.card-border;
    clip: true;

    private property <float> effective-vol: root.video-muted ? 0.0 : Math.max(0.0, Math.min(1.0, root.video-volume));
    private property <string> speed-label:
        Math.abs(root.video-speed - 0.5) < 0.05 ? "0.5x" :
        Math.abs(root.video-speed - 0.75) < 0.05 ? "0.75x" :
        Math.abs(root.video-speed - 1.25) < 0.05 ? "1.25x" :
        Math.abs(root.video-speed - 1.5) < 0.05 ? "1.5x" :
        Math.abs(root.video-speed - 2.0) < 0.05 ? "2x" : "1x";

    property <int> idle-ticks: 0;
    property <bool> hovering-bar:
        bottom-bar-touch.has-hover
        || scrubber-touch.has-hover
        || scrubber-touch.pressed
        || play-btn.has-hover
        || mute-btn.has-hover
        || vol-touch.has-hover
        || vol-touch.pressed
        || speed-btn.has-hover
        || fs-btn.has-hover
        || corner-fs-btn.has-hover;
    property <bool> show-chrome:
        !root.video-playing
        || self.hovering-bar
        || self.idle-ticks < 7;

    Timer {
        interval: 500ms;
        running: root.has-trailer;
        triggered => {
            if (root.hovering-bar || !root.video-playing) {
                root.idle-ticks = 0;
            } else if (root.idle-ticks < 14) {
                root.idle-ticks += 1;
            }
        }
    }

    // Backdrop: item poster while the decoder produces the first frame.
    if (root.poster.width > 0) : Image {
        width: parent.width;
        height: parent.height;
        source: root.poster;
        image-fit: cover;
        opacity: root.has-video-frame ? 0 : 0.55;
        animate opacity { duration: 150ms; }
    }

    if (root.has-video-frame) : Image {
        width: parent.width;
        height: parent.height;
        source: root.video-frame;
        image-fit: contain;
    }

    // Click = play/pause, double-click = fullscreen trailer, scroll = seek.
    surface-touch := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: root.has-trailer ? MouseCursor.pointer : MouseCursor.default;
        moved => {
            root.idle-ticks = 0;
        }
        pointer-event(event) => {
            root.idle-ticks = 0;
        }
        clicked => {
            root.idle-ticks = 0;
            if (root.has-trailer) {
                root.toggle-playback();
            }
        }
        double-clicked => {
            root.idle-ticks = 0;
            if (root.has-trailer) {
                root.maximize();
            }
        }
        scroll-event(event) => {
            root.idle-ticks = 0;
            if (root.has-trailer && event.delta-y != 0px) {
                root.seek-relative(event.delta-y > 0px ? 5.0 : -5.0);
            }
            accept
        }
    }

    // Corner maximize button in the top-right corner of the player
    corner-fs-btn := ButtonSurface {
        x: parent.width - self.width - 10px;
        y: 10px;
        width: 32px;
        height: 32px;
        z: 12;
        border-radius: 16px;
        background: self.has-hover ? #ffffff35 : #0000008c;
        visible: root.has-trailer;
        opacity: root.show-chrome ? 1.0 : 0.0;
        animate opacity { duration: 140ms; easing: ease-out; }
        accessible-name: @tr("Watch trailer in full player");
        clicked => {
            root.idle-ticks = 0;
            root.maximize();
        }

        Image {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 16px;
            height: 16px;
            source: @image-url("../assets/images/icons/maximize.svg");
            colorize: #ffffff;
            image-fit: contain;
        }
    }

    // Center Tube Oxide dark translucent play badge when paused/stopped.
    center-play-btn := ButtonSurface {
        width: 48px;
        height: 48px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 24px;
        visible: !root.video-playing && root.has-trailer && !root.video-loading;
        background: self.has-hover ? #ff0000e6 : #000000a6;
        border-width: 1px;
        border-color: self.has-hover ? #ff4444 : #ffffff30;
        accessible-name: @tr("Watch Trailer");
        clicked => { root.toggle-playback(); }

        Image {
            width: 20px;
            height: 20px;
            x: (parent.width - self.width) / 2 + 2px;
            y: (parent.height - self.height) / 2;
            source: @image-url("../assets/images/icons/play.svg");
            colorize: #ffffff;
            image-fit: contain;
        }
    }

    if (root.video-loading && !root.has-video-frame) : Rectangle {
        width: parent.width;
        height: parent.height;
        background: #00000078;

        Rectangle {
            width: 44px;
            height: 44px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 22px;
            background: #000000a6;
            border-width: 2px;
            border-color: #ff0000;

            Text {
                text: "…";
                color: #ffffff;
                font-size: 20px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    // Tube Oxide `view_control_bar` (always mounted to prevent hover flicker).
    // Background: rgba(0, 0, 0, 0.65) = #000000a6, padding: [8, 12], spacing: 6
    bottom-bar-touch := TouchArea {
        x: 0px;
        y: parent.height - 52px;
        width: parent.width;
        height: 52px;
        z: 10;
        moved => {
            root.idle-ticks = 0;
        }
        pointer-event(event) => {
            root.idle-ticks = 0;
        }
    }

    Rectangle {
        x: 0px;
        y: parent.height - self.height;
        width: parent.width;
        height: 52px;
        z: 11;
        visible: root.has-trailer;
        opacity: root.show-chrome ? 1.0 : 0.0;
        animate opacity { duration: 140ms; easing: ease-out; }
        background: #000000a6;

        // 1. Full-width Tube Oxide red seek bar along the top of the bottom bar
        scrubber-box := Rectangle {
            x: 12px;
            y: 6px;
            width: parent.width - 24px;
            height: 12px;
            background: transparent;

            property <length> rail-h: scrubber-touch.has-hover || scrubber-touch.pressed ? 6px : 4px;

            Rectangle {
                x: 0px;
                y: (parent.height - parent.rail-h) / 2;
                width: parent.width;
                height: parent.rail-h;
                border-radius: self.height / 2;
                background: #ffffff38;
            }

            Rectangle {
                x: 0px;
                y: (parent.height - parent.rail-h) / 2;
                width: parent.width * Math.max(0.0, Math.min(1.0, root.video-progress));
                height: parent.rail-h;
                border-radius: self.height / 2;
                background: #ff0000;
            }

            Rectangle {
                property <length> d: scrubber-touch.has-hover || scrubber-touch.pressed ? 13px : 10px;
                x: max(0px, min(parent.width - self.d, parent.width * Math.max(0.0, Math.min(1.0, root.video-progress)) - self.d / 2));
                y: (parent.height - self.d) / 2;
                width: self.d;
                height: self.d;
                border-radius: self.d / 2;
                background: #ff0000;
            }

            scrubber-touch := TouchArea {
                width: parent.width;
                height: 16px;
                y: -2px;
                mouse-cursor: MouseCursor.pointer;
                pointer-event(event) => {
                    root.idle-ticks = 0;
                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                        if (scrubber-box.width > 0px) {
                            root.seek-progress(Math.max(0.0, Math.min(1.0, self.mouse-x / scrubber-box.width)));
                        }
                    }
                }
                moved => {
                    root.idle-ticks = 0;
                    if (self.pressed && scrubber-box.width > 0px) {
                        root.seek-progress(Math.max(0.0, Math.min(1.0, self.mouse-x / scrubber-box.width)));
                    }
                }
            }
        }

        // 2. Tube Oxide controls row:
        // Left: [Play/Pause] [Mute/Vol] [Vol Slider] [Time] | Center: Spacer | Right: [Speed] [Fullscreen]
        HorizontalLayout {
            x: 10px;
            y: 20px;
            width: parent.width - 20px;
            height: 28px;
            spacing: 4px;
            alignment: start;

            play-btn := ButtonSurface {
                width: 30px;
                height: 28px;
                border-radius: 4px;
                background: self.pressed ? #ffffff40 : (self.has-hover ? #ffffff29 : transparent);
                accessible-name: root.video-playing ? @tr("Pause") : @tr("Play");
                clicked => {
                    root.idle-ticks = 0;
                    root.toggle-playback();
                }

                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 16px;
                    height: 16px;
                    source: root.video-playing
                        ? @image-url("../assets/images/icons/pause.svg")
                        : @image-url("../assets/images/icons/play.svg");
                    colorize: #f1f1f1;
                    image-fit: contain;
                }
            }

            mute-btn := ButtonSurface {
                width: 28px;
                height: 28px;
                border-radius: 4px;
                background: self.pressed ? #ffffff40 : (self.has-hover ? #ffffff29 : transparent);
                accessible-name: root.video-muted ? @tr("Unmute trailer") : @tr("Mute trailer");
                clicked => {
                    root.idle-ticks = 0;
                    root.toggle-muted();
                }

                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 16px;
                    height: 16px;
                    source: (root.video-muted || root.video-volume <= 0.01)
                        ? @image-url("../assets/images/icons/volume-mute.svg")
                        : (root.video-volume < 0.5
                            ? @image-url("../assets/images/icons/volume-low.svg")
                            : @image-url("../assets/images/icons/volume-high.svg"));
                    colorize: #f1f1f1;
                    image-fit: contain;
                }
            }

            // Tube Oxide inline volume slider (0.0..=1.0, red active rail & handle)
            vol-box := Rectangle {
                width: 52px;
                height: 28px;
                background: transparent;

                Rectangle {
                    x: 0px;
                    y: (parent.height - self.height) / 2;
                    width: parent.width;
                    height: 4px;
                    border-radius: 2px;
                    background: #ffffff40;
                }

                Rectangle {
                    x: 0px;
                    y: (parent.height - self.height) / 2;
                    width: parent.width * root.effective-vol;
                    height: 4px;
                    border-radius: 2px;
                    background: #ff0000;
                }

                Rectangle {
                    property <length> d: vol-touch.has-hover || vol-touch.pressed ? 11px : 9px;
                    x: max(0px, min(parent.width - self.d, parent.width * root.effective-vol - self.d / 2));
                    y: (parent.height - self.d) / 2;
                    width: self.d;
                    height: self.d;
                    border-radius: self.d / 2;
                    background: #ff0000;
                }

                vol-touch := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: MouseCursor.pointer;
                    pointer-event(event) => {
                        root.idle-ticks = 0;
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                            if (vol-box.width > 0px) {
                                root.change-volume(Math.max(0.0, Math.min(1.0, self.mouse-x / vol-box.width)));
                            }
                        }
                    }
                    moved => {
                        root.idle-ticks = 0;
                        if (self.pressed && vol-box.width > 0px) {
                            root.change-volume(Math.max(0.0, Math.min(1.0, self.mouse-x / vol-box.width)));
                        }
                    }
                }
            }

            Text {
                height: 28px;
                text: root.video-time-label != "" ? root.video-time-label : "0:00 / 0:00";
                color: #f1f1f1;
                font-size: 12px;
                font-weight: 500;
                vertical-alignment: center;
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            // Tube Oxide Speed button ("1x")
            speed-btn := ButtonSurface {
                width: 34px;
                height: 28px;
                border-radius: 4px;
                background: self.pressed ? #ffffff40 : (self.has-hover ? #ffffff29 : transparent);
                accessible-name: "Velocidad " + root.speed-label;
                clicked => {
                    root.idle-ticks = 0;
                    if (Math.abs(root.video-speed - 1.0) < 0.05) {
                        root.change-speed(1.25);
                    } else if (Math.abs(root.video-speed - 1.25) < 0.05) {
                        root.change-speed(1.5);
                    } else if (Math.abs(root.video-speed - 1.5) < 0.05) {
                        root.change-speed(2.0);
                    } else if (Math.abs(root.video-speed - 2.0) < 0.05) {
                        root.change-speed(0.5);
                    } else {
                        root.change-speed(1.0);
                    }
                }

                Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.speed-label;
                    color: #f1f1f1;
                    font-size: 12px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            fs-btn := ButtonSurface {
                width: 28px;
                height: 28px;
                border-radius: 4px;
                background: self.pressed ? #ffffff40 : (self.has-hover ? #ffffff29 : transparent);
                accessible-name: @tr("Watch trailer in full player");
                clicked => {
                    root.idle-ticks = 0;
                    root.maximize();
                }

                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 16px;
                    height: 16px;
                    source: @image-url("../assets/images/icons/maximize.svg");
                    colorize: #f1f1f1;
                    image-fit: contain;
                }
            }
        }
    }
}

// Reusable metadata presentation shared by Discover, Details, and the player
// drawer. Data normalization and URL policy remain in the Rust/controller layer.
export component MetaPreview inherits Rectangle {
    in property <length> unit: Theme.root-font-size;
    in property <bool> compact: false;
    in property <string> name: "";
    in property <image> logo;
    in property <bool> has-logo: root.logo.width > 0;
    in property <image> background-image;
    in property <bool> has-background: root.background-image.width > 0;
    in property <string> runtime: "";
    in property <string> release-info: "";
    in property <string> imdb-label: "";
    in property <string> rt-rating: "";
    in property <string> metacritic-rating: "";
    in property <string> letterboxd-rating: "";
    in property <string> anilist-rating: "";
    in property <string> kitsu-rating: "";
    in property <string> description: "";
    in property <[MetaLinkGroup]> link-groups: [];
    in property <[string]> genres: [];
    in property <[string]> cast: [];
    in property <[string]> directors: [];
    in property <bool> show-trailer: false;
    in property <image> trailer-poster;
    in property <image> trailer-video-frame;
    in property <bool> trailer-has-video-frame: false;
    in property <bool> trailer-video-loading: false;
    in property <bool> trailer-video-playing: false;
    in property <bool> trailer-video-muted: true;
    in property <float> trailer-video-volume: 0.75;
    in property <float> trailer-video-speed: 1.0;
    in property <float> trailer-video-progress: 0.0;
    in property <string> trailer-video-time-label: "";
    in property <bool> show-library-actions: false;
    in property <bool> in-library: false;
    in property <bool> watched: false;
    in property <bool> show-title-action: false;
    in property <bool> show-ratings: false;
    in property <bool> liked: false;
    in property <bool> loved: false;
    in property <bool> ratings-enabled: true;
    in property <bool> show-share: false;
    callback trailer-requested;
    callback trailer-toggle-playback;
    callback trailer-toggle-muted;
    callback trailer-change-volume(float);
    callback trailer-change-speed(float);
    callback trailer-maximize;
    callback trailer-seek-relative(float);
    callback trailer-seek-progress(float);
    callback library-requested(bool);
    callback watched-requested(bool);
    callback show-requested;
    callback rating-requested(string, bool);
    callback share-requested;
    callback imdb-requested;
    callback link-selected(string);

    private property <length> actions-height: root.compact ? 5.5 * root.unit : 8.5 * root.unit;

    background: transparent;
    clip: false;

    // Slint has no arbitrary image blur. Keep the exact official expansion and
    // opacity; callers can omit this layer when an unblurred image is unsuitable.
    if (root.has-background) : Image {
        x: -10px;
        y: -10px;
        width: parent.width + 20px;
        height: parent.height + 20px;
        source: root.background-image;
        image-fit: cover;
        opacity: 0.3;
        z: -1;
    }

    info-scroll := ScrollView {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: max(0px, parent.height - root.actions-height);
        viewport-width: parent.width;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        vertical-scrollbar-policy: ScrollBarPolicy.as-needed;

        VerticalLayout {
            width: parent.width;
            spacing: root.unit;

            Rectangle {
                height: root.compact ? 6 * root.unit : 9 * root.unit;
                background: transparent;

                if (root.has-logo) : Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.logo;
                    image-fit: contain;
                    horizontal-alignment: left;
                }
                if (!root.has-logo) : Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.name;
                    color: Theme.surface-light-90;
                    font-size: 1.7 * root.unit;
                    font-weight: 500;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    overflow: elide;
                }
            }

            if (root.runtime != "" || root.release-info != "" || root.imdb-label != "") : Rectangle {
                height: 3 * root.unit;
                background: transparent;

                HorizontalLayout {
                    spacing: root.compact ? 0.8 * root.unit : 1.5 * root.unit;
                    alignment: root.compact ? space-between : start;

                    if (root.runtime != "") : Text {
                        text: root.runtime;
                        color: Theme.primary-foreground;
                        font-size: 1.25 * root.unit;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    if (root.release-info != "") : Text {
                        text: root.release-info;
                        color: Theme.primary-foreground;
                        font-size: 1.25 * root.unit;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    if (root.imdb-label != "") : imdb-button := ButtonSurface {
                        width: imdb-measure.preferred-width + 4.2 * root.unit;
                        height: 3 * root.unit;
                        border-width: 0px;
                        background: transparent;
                        accessible-name: "IMDb " + root.imdb-label;
                        clicked => { root.imdb-requested(); }

                        Text {
                            x: 0px;
                            y: 0px;
                            width: imdb-measure.preferred-width;
                            height: parent.height;
                            text: root.imdb-label;
                            color: Theme.primary-foreground;
                            font-size: 1.25 * root.unit;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        Image {
                            x: imdb-measure.preferred-width + 0.6 * root.unit;
                            y: (parent.height - self.height) / 2;
                            width: 2.8 * root.unit;
                            height: 2.8 * root.unit;
                            source: @image-url("../assets/images/icons/imdb.svg");
                            colorize: Theme.imdb;
                            image-fit: contain;
                        }

                        imdb-measure := Text {
                            visible: false;
                            text: root.imdb-label;
                            font-size: 1.25 * root.unit;
                            font-weight: 600;
                        }
                    }

                    if (root.rt-rating != "") : Rectangle {
                        width: rt-measure.preferred-width + 2.0 * root.unit;
                        height: 3 * root.unit;
                        background: transparent;

                        Text {
                            x: 0px;
                            y: 0px;
                            width: rt-measure.preferred-width;
                            height: parent.height;
                            text: root.rt-rating;
                            color: Theme.primary-foreground;
                            font-size: 1.25 * root.unit;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        Image {
                            x: rt-measure.preferred-width + 0.6 * root.unit;
                            y: (parent.height - self.height) / 2 + 0.15 * root.unit;
                            width: 1.35 * root.unit;
                            height: 1.35 * root.unit;
                            source: @image-url("../assets/images/icons/rotten-tomatoes.svg");
                            image-fit: contain;
                        }
                        rt-measure := Text {
                            visible: false;
                            text: root.rt-rating;
                            font-size: 1.25 * root.unit;
                            font-weight: 600;
                        }
                    }

                    if (root.metacritic-rating != "") : Rectangle {
                        width: mc-measure.preferred-width + 2.0 * root.unit;
                        height: 3 * root.unit;
                        background: transparent;

                        Text {
                            x: 0px;
                            y: 0px;
                            width: mc-measure.preferred-width;
                            height: parent.height;
                            text: root.metacritic-rating;
                            color: Theme.primary-foreground;
                            font-size: 1.25 * root.unit;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        Image {
                            x: mc-measure.preferred-width + 0.6 * root.unit;
                            y: (parent.height - self.height) / 2 + 0.15 * root.unit;
                            width: 1.35 * root.unit;
                            height: 1.35 * root.unit;
                            source: @image-url("../assets/images/icons/metacritic.svg");
                            colorize: Theme.metacritic;
                            image-fit: contain;
                        }
                        mc-measure := Text {
                            visible: false;
                            text: root.metacritic-rating;
                            font-size: 1.25 * root.unit;
                            font-weight: 600;
                        }
                    }

                    if (root.letterboxd-rating != "") : Rectangle {
                        width: lb-measure.preferred-width + 2.2 * root.unit;
                        height: 3 * root.unit;
                        background: transparent;

                        Text {
                            x: 0px;
                            y: 0px;
                            width: lb-measure.preferred-width;
                            height: parent.height;
                            text: root.letterboxd-rating;
                            color: Theme.primary-foreground;
                            font-size: 1.25 * root.unit;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        Image {
                            x: lb-measure.preferred-width + 0.6 * root.unit;
                            y: (parent.height - self.height) / 2 + 0.15 * root.unit;
                            width: 1.5 * root.unit;
                            height: 1.25 * root.unit;
                            source: @image-url("../assets/images/icons/letterboxd.svg");
                            image-fit: contain;
                        }
                        lb-measure := Text {
                            visible: false;
                            text: root.letterboxd-rating;
                            font-size: 1.25 * root.unit;
                            font-weight: 600;
                        }
                    }

                    if (root.anilist-rating != "") : Rectangle {
                        width: ani-measure.preferred-width + 2.0 * root.unit;
                        height: 3 * root.unit;
                        background: transparent;

                        Text {
                            x: 0px;
                            y: 0px;
                            width: ani-measure.preferred-width;
                            height: parent.height;
                            text: root.anilist-rating;
                            color: Theme.primary-foreground;
                            font-size: 1.25 * root.unit;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        Image {
                            x: ani-measure.preferred-width + 0.6 * root.unit;
                            y: (parent.height - self.height) / 2 + 0.18 * root.unit;
                            width: 1.35 * root.unit;
                            height: 1.35 * root.unit;
                            source: @image-url("../assets/images/icons/anilist.svg");
                            image-fit: contain;
                        }
                        ani-measure := Text {
                            visible: false;
                            text: root.anilist-rating;
                            font-size: 1.25 * root.unit;
                            font-weight: 600;
                        }
                    }

                    if (root.kitsu-rating != "") : Rectangle {
                        width: kit-measure.preferred-width + 2.0 * root.unit;
                        height: 3 * root.unit;
                        background: transparent;

                        Text {
                            x: 0px;
                            y: 0px;
                            width: kit-measure.preferred-width;
                            height: parent.height;
                            text: root.kitsu-rating;
                            color: Theme.primary-foreground;
                            font-size: 1.25 * root.unit;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        Image {
                            x: kit-measure.preferred-width + 0.6 * root.unit;
                            y: (parent.height - self.height) / 2 + 0.18 * root.unit;
                            width: 1.35 * root.unit;
                            height: 1.35 * root.unit;
                            source: @image-url("../assets/images/icons/kitsu.svg");
                            image-fit: contain;
                        }
                        kit-measure := Text {
                            visible: false;
                            text: root.kitsu-rating;
                            font-size: 1.25 * root.unit;
                            font-weight: 600;
                        }
                    }
                }
            }

            if (root.compact && root.description != "") : Text {
                width: parent.width;
                min-height: 4 * root.unit;
                text: root.description;
                color: Theme.primary-foreground;
                font-size: root.unit;
                wrap: word-wrap;
            }

            for group in root.link-groups : MetaLinks {
                width: parent.width;
                unit: root.unit;
                group: group;
                link-selected(value) => { root.link-selected(value); }
            }

            if (root.genres.length > 0) : MetaStringLinks {
                width: parent.width;
                unit: root.unit;
                label: @tr("LINKS_GENRES" => "Genres");
                values: root.genres;
                link-selected(value) => { root.link-selected(value); }
            }

            if (root.cast.length > 0) : MetaStringLinks {
                width: parent.width;
                unit: root.unit;
                label: @tr("CAST" => "Cast");
                values: root.cast;
                link-selected(value) => { root.link-selected(value); }
            }

            if (root.directors.length > 0) : MetaStringLinks {
                width: parent.width;
                unit: root.unit;
                label: @tr("LINKS_DIRECTORS" => "Directors");
                values: root.directors;
                link-selected(value) => { root.link-selected(value); }
            }

            if (!root.compact && root.description != "") : Rectangle {
                min-height: 6 * root.unit;
                background: transparent;

                Text {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: 1.2 * root.unit;
                    text: @tr("SUMMARY" => "Summary");
                    color: Theme.primary-foreground;
                    opacity: 0.3;
                    font-size: 0.95 * root.unit;
                    font-weight: 700;
                }
                Text {
                    x: 0px;
                    y: 1.5 * root.unit;
                    width: parent.width;
                    min-height: 4.5 * root.unit;
                    text: root.description;
                    color: Theme.primary-foreground;
                    font-size: root.unit;
                    wrap: word-wrap;
                }
            }

            if (!root.compact && root.show-trailer) : HorizontalLayout {
                width: parent.width;
                alignment: start;

                TrailerMiniPlayer {
                    width: min(parent.width, 42 * root.unit);
                    unit: root.unit;
                    poster: root.trailer-poster;
                    has-trailer: root.show-trailer;
                    video-frame: root.trailer-video-frame;
                    has-video-frame: root.trailer-has-video-frame;
                    video-loading: root.trailer-video-loading;
                    video-playing: root.trailer-video-playing;
                    video-muted: root.trailer-video-muted;
                    video-volume: root.trailer-video-volume;
                    video-speed: root.trailer-video-speed;
                    video-progress: root.trailer-video-progress;
                    video-time-label: root.trailer-video-time-label;
                    toggle-playback => { root.trailer-toggle-playback(); }
                    toggle-muted => { root.trailer-toggle-muted(); }
                    change-volume(val) => { root.trailer-change-volume(val); }
                    change-speed(val) => { root.trailer-change-speed(val); }
                    maximize => { root.trailer-maximize(); }
                    seek-relative(offset) => { root.trailer-seek-relative(offset); }
                    seek-progress(progress) => { root.trailer-seek-progress(progress); }
                }
            }
        }
    }

    actions := Rectangle {
        x: 0px;
        y: parent.height - root.actions-height;
        width: parent.width;
        height: root.actions-height;
        background: transparent;

        HorizontalLayout {
            y: root.compact ? 1.5 * root.unit : 3.5 * root.unit;
            width: parent.width;
            height: 4 * root.unit;
            spacing: root.compact ? 0.5 * root.unit : root.unit;
            alignment: root.compact ? space-between : start;

            if (root.show-trailer) : MetaActionButton {
                unit: root.unit;
                icon-source: @image-url("../assets/images/icons/trailer.svg");
                label: @tr("Trailer");
                tooltip: root.compact;
                clicked => { root.trailer-requested(); }
            }

            if (root.show-library-actions) : ActionsGroup {
                unit: root.unit;
                compact: root.compact;
                items: [
                    {
                        id: "library",
                        label: root.in-library ? @tr("REMOVE_FROM_LIB" => "Remove from Library") : @tr("ADD_TO_LIB" => "Add to Library"),
                        icon: root.in-library
                            ? @image-url("../assets/images/icons/remove-from-library.svg")
                            : @image-url("../assets/images/icons/add-to-library.svg"),
                        disabled: false,
                        active: root.in-library
                    },
                    {
                        id: "watched",
                        label: root.watched ? @tr("MARK_AS_UNWATCHED" => "Mark as unwatched") : @tr("MARK_AS_WATCHED" => "Mark as watched"),
                        icon: root.watched
                            ? @image-url("../assets/images/icons/eye-off.svg")
                            : @image-url("../assets/images/icons/eye.svg"),
                        disabled: false,
                        active: root.watched
                    }
                ];
                action-triggered(id) => {
                    if (id == "library") {
                        root.library-requested(!root.in-library);
                    } else if (id == "watched") {
                        root.watched-requested(!root.watched);
                    }
                }
            }

            if (root.compact && root.show-title-action) : MetaActionButton {
                unit: root.unit;
                icon-source: @image-url("../assets/images/icons/play.svg");
                label: @tr("SHOW" => "Show");
                emphasized: true;
                clicked => { root.show-requested(); }
            }

            if (!root.compact && root.show-ratings) : ActionsGroup {
                unit: root.unit;
                items: [
                    {
                        id: "like",
                        label: root.liked ? @tr("Unlike") : @tr("Like"),
                        icon: root.liked
                            ? @image-url("../assets/images/icons/thumbs-up.svg")
                            : @image-url("../assets/images/icons/thumbs-up-outline.svg"),
                        disabled: !root.ratings-enabled,
                        active: root.liked
                    },
                    {
                        id: "love",
                        label: root.loved ? @tr("Unlove") : @tr("Love"),
                        icon: root.loved
                            ? @image-url("../assets/images/icons/heart.svg")
                            : @image-url("../assets/images/icons/heart-outline.svg"),
                        disabled: !root.ratings-enabled,
                        active: root.loved
                    }
                ];
                action-triggered(id) => {
                    root.rating-requested(id, id == "like" ? !root.liked : !root.loved);
                }
            }

            if (!root.compact && root.show-share) : MetaActionButton {
                unit: root.unit;
                icon-source: @image-url("../assets/images/icons/share.svg");
                label: @tr("Share");
                tooltip: true;
                clicked => { root.share-requested(); }
            }
        }
    }
}

export component MetaPreviewPlaceholder inherits Rectangle {
    in property <length> unit: Theme.root-font-size;

    background: transparent;

    SkeletonBlock {
        x: 0px;
        y: 0px;
        width: min(parent.width, 20 * root.unit);
        height: 8 * root.unit;
        radius: Theme.border-radius;
    }
    SkeletonBlock { x: 0px; y: 9 * root.unit; width: 5 * root.unit; height: 1.4 * root.unit; }
    SkeletonBlock { x: 6 * root.unit; y: 9 * root.unit; width: 5 * root.unit; height: 1.4 * root.unit; }
    SkeletonBlock { x: 0px; y: 12 * root.unit; width: 6.5 * root.unit; height: 1.6 * root.unit; }
    SkeletonBlock { x: 0px; y: 14 * root.unit; width: 10 * root.unit; height: 1.2 * root.unit; }
    SkeletonBlock { x: 0px; y: 17 * root.unit; width: 6.5 * root.unit; height: 1.6 * root.unit; }
    SkeletonBlock { x: 0px; y: 19 * root.unit; width: 10 * root.unit; height: 1.2 * root.unit; }
    SkeletonBlock { x: 0px; y: 22 * root.unit; width: 6.5 * root.unit; height: 1.6 * root.unit; }
    SkeletonBlock { x: 0px; y: 24 * root.unit; width: 10 * root.unit; height: 1.2 * root.unit; }
    SkeletonBlock {
        x: 0px;
        y: parent.height - 5 * root.unit;
        width: min(parent.width, 18 * root.unit);
        height: 4 * root.unit;
        radius: 4 * root.unit;
    }
}
