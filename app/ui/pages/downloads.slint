import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { ButtonSurface, PillButton } from "../components/button.slint";
import { EmptyState } from "../components/feedback.slint";
import { FallbackImage } from "../components/fallback_image.slint";
import { ContextMenuSurface, ModalDialog } from "../components/overlays.slint";

export struct DownloadEpisodeChip {
    id: string,
    season: int,
    episode-num: int,
    title: string,
    is-downloaded: bool,
    is-downloading: bool,
    is-paused: bool,
    is-failed: bool,
    error-message: string,
    watched: bool,
    watch-progress: float,
    progress: float,
}

export struct DownloadSeasonGroup {
    season: int,
    season-label: string,
    season-year: string,
    has-downloaded: bool,
    has-active: bool,
    has-paused: bool,
    has-failed: bool,
    episodes: [DownloadEpisodeChip],
}

export struct DownloadEpisodeItem {
    id: string,
    title: string,
    season: int,
    episode-num: int,
    status: string,
    progress: float,
    size-formatted: string,
    can-pause: bool,
    can-resume: bool,
    can-play: bool,
    can-delete: bool,
    watched: bool,
    watch-progress: float,
}

export struct DownloadItem {
    id: string,
    meta-id: string,
    is-series: bool,
    title: string,
    poster: image,
    has-poster: bool,
    poster-url: string,
    coverage: string,
    status: string,
    progress: float,
    size-formatted: string,
    subtitles-info: string,
    has-subtitles: bool,
    is-downloading: bool,
    is-paused: bool,
    has-failed: bool,
    error-message: string,
    can-pause: bool,
    can-resume: bool,
    can-cancel: bool,
    can-change-source: bool,
    can-play: bool,
    can-delete: bool,
    watched: bool,
    watch-progress: float,
    downloaded-seasons: [DownloadSeasonGroup],
    all-seasons: [DownloadSeasonGroup],
    episodes: [DownloadEpisodeItem],
}

component DownloadMenuRow inherits ButtonSurface {
    in property <length> unit: Theme.root-font-size;
    in property <string> label;
    in property <image> icon-source;
    in property <bool> destructive: false;
    in property <brush> hover-color: Theme.overlay-hover;
    in property <color> destructive-color: Theme.danger;

    height: 2.5 * root.unit;
    border-radius: 8px;
    background: self.has-hover || self.has-focus ? root.hover-color : transparent;
    accessible-name: root.label;

    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: 0.75 * root.unit;
        padding-right: 0.75 * root.unit;
        spacing: 0.625 * root.unit;
        alignment: start;
        cross-axis-alignment: center;

        Image {
            width: 1.0625 * root.unit;
            height: 1.0625 * root.unit;
            source: root.icon-source;
            colorize: root.destructive ? root.destructive-color : Theme.text-secondary;
            image-fit: contain;
        }

        Text {
            horizontal-stretch: 1;
            text: root.label;
            color: root.destructive ? root.destructive-color : Theme.text-primary;
            font-size: 0.875 * root.unit;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

export component DownloadsPage inherits Rectangle {
    in property <length> unit: Theme.root-font-size;
    in property <[DownloadItem]> items: [];
    in property <bool> loading: false;
    in property <string> error: "";
    in property <string> disk-usage-text: "";
    in property <int> active-count: 0;
    in property <string> speed-text: "";
    in property <string> current-text: "";
    in property <string> eta-text: "";
    in-out property <string> expanded-id: "";

    in-out property <bool> prompt-download-open: false;
    in-out property <string> prompt-download-meta-id: "";
    in-out property <string> prompt-download-title: "";
    in-out property <int> prompt-download-season: 0;
    in-out property <int> prompt-download-episode: 0;
    in-out property <string> prompt-download-ep-title: "";
    in-out property <string> prompt-download-job-id: "";
    in-out property <bool> prompt-download-is-downloaded: false;
    in-out property <bool> prompt-download-is-downloading: false;
    in-out property <bool> prompt-download-is-paused: false;
    in-out property <bool> prompt-download-is-failed: false;
    in-out property <float> prompt-download-progress: 0.0;
    in-out property <string> prompt-download-error: "";
    in-out property <bool> prompt-download-season-has-dl: false;
    in-out property <bool> prompt-download-season-has-active: false;
    in-out property <bool> prompt-download-season-has-paused: false;
    in-out property <string> prompt-download-season-label: "";
    in-out property <string> prompt-download-season-year: "";

    callback pause(string);
    callback resume(string);
    callback cancel(string);
    callback play(string);
    callback reveal(string);
    callback delete-item(string);
    callback open-downloads-folder;
    callback retry;
    callback dismiss-error;
    callback request-download-episode(string, int, int, bool);

    background: dl-page;

    // Neutral ramp for this screen. The brand violet stays in Theme and is
    // used only for the primary action and the active progress; these
    // surfaces are graphite so the posters and the progress carry the color.
    private property <color> dl-surface: #141416;
    private property <color> dl-surface-raised: #1b1b1e;
    private property <color> dl-surface-hover: #222226;
    private property <color> dl-hairline: #ffffff14;
    private property <color> dl-hairline-strong: #ffffff26;
    private property <color> dl-paused: #d6a13a;
    private property <color> dl-error-text: #f0a8a8;
    private property <color> dl-page: #0e0e10;
    private property <color> dl-primary: #ededed;
    private property <color> dl-primary-ink: #141416;

    private property <bool> menu-open: false;
    private property <length> menu-x: 0px;
    private property <length> menu-y: 0px;
    private property <string> menu-target: "";
    private property <string> menu-meta-id: "";
    private property <bool> menu-is-series: false;
    private property <bool> menu-change-source: false;
    private property <bool> menu-cancel: false;
    private property <bool> menu-delete: false;

    private property <float> content-fade-opacity: 1.0;
    private property <bool> content-fade-in-pending: false;
    private property <int> has-items-state: root.items.length > 0 ? 1 : 0;

    // Explicit page geometry. The list must always take the whole band between
    // the title and the disk footer; relying on nested stretch layouts collapsed
    // the viewport to the height of the first couple of rows.
    private property <length> dl-pad: 2 * root.unit;
    private property <length> dl-header-height: 3.25 * root.unit;
    private property <length> dl-gap: 1.5 * root.unit;
    private property <length> dl-footer-height: 2.25 * root.unit;
    private property <length> dl-banner-height: root.error == "" ? 0px : 5.25 * root.unit;
    private property <length> dl-list-top: root.dl-pad + root.dl-header-height + root.dl-gap
        + (root.error == "" ? 0px : root.dl-banner-height + root.dl-gap);
    private property <length> dl-list-height: max(
        0px,
        root.height - root.dl-list-top - root.dl-pad - root.dl-footer-height - root.dl-gap
    );

    function trigger-content-fade() {
        root.content-fade-opacity = 0.0;
        root.content-fade-in-pending = true;
    }

    function open-season-prompt(item: DownloadItem, s: DownloadSeasonGroup) {
        root.prompt-download-meta-id = item.meta-id;
        root.prompt-download-title = item.title;
        root.prompt-download-season = s.season;
        root.prompt-download-episode = 0;
        root.prompt-download-ep-title = "";
        root.prompt-download-job-id = "";
        root.prompt-download-is-downloaded = false;
        root.prompt-download-is-downloading = false;
        root.prompt-download-is-paused = false;
        root.prompt-download-is-failed = false;
        root.prompt-download-progress = 0.0;
        root.prompt-download-error = "";
        root.prompt-download-season-has-dl = s.has-downloaded;
        root.prompt-download-season-has-active = s.has-active;
        root.prompt-download-season-has-paused = s.has-paused;
        root.prompt-download-season-label = s.season-label;
        root.prompt-download-season-year = s.season-year;
        root.prompt-download-open = true;
    }

    init => {
        root.trigger-content-fade();
    }

    changed loading => {
        root.trigger-content-fade();
    }

    changed has-items-state => {
        root.trigger-content-fade();
    }

    changed prompt-download-open => {
        if (root.prompt-download-open) {
            root.menu-open = false;
        }
    }

    Timer {
        interval: 16ms;
        running: root.content-fade-in-pending;
        triggered => {
            self.stop();
            root.content-fade-in-pending = false;
            root.content-fade-opacity = 1.0;
        }
    }

    opacity: root.content-fade-opacity;
    animate opacity {
        duration: root.content-fade-in-pending ? 0ms : Theme.motion-control;
        easing: ease-out;
    }

    HorizontalLayout {
        x: root.dl-pad;
        y: root.dl-pad;
        width: root.width - 2 * root.dl-pad;
        height: root.dl-header-height;
        spacing: 1.5 * root.unit;

            Text {
                horizontal-stretch: 1;
                text: @tr("DOWNLOADS_TITLE" => "Descargas");
                color: Theme.text-primary;
                font-size: 2 * root.unit;
                font-weight: 500;
                vertical-alignment: center;
            }

            HorizontalLayout {
                horizontal-stretch: 0;
                alignment: end;
                spacing: 1 * root.unit;

                if (root.active-count > 0) : HorizontalLayout {
                    alignment: center;
                    spacing: 0.5 * root.unit;

                    Rectangle {
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        background: Theme.primary-accent;
                    }

                    Text {
                        text: "Descargando " + root.active-count;
                        color: Theme.text-primary;
                        font-size: 0.8125 * root.unit;
                        font-weight: 500;
                        vertical-alignment: center;
                    }

                    if (root.speed-text != "") : Text {
                        text: "· " + root.speed-text;
                        color: Theme.text-secondary;
                        font-size: 0.8125 * root.unit;
                        vertical-alignment: center;
                    }

                    if (root.eta-text != "") : Text {
                        text: "· " + root.eta-text;
                        color: Theme.text-secondary;
                        font-size: 0.8125 * root.unit;
                        vertical-alignment: center;
                    }
                }

                if (root.active-count > 0) : Rectangle {
                    width: 1px;
                    height: 1 * root.unit;
                    background: dl-hairline;
                }

                ButtonSurface {
                    height: 2 * root.unit;
                    accessible-name: @tr("SETTINGS_OPEN_FOLDER" => "Abrir carpeta");
                    border-radius: 6px;
                    background: self.has-hover || self.has-focus ? dl-surface-hover : transparent;

                    HorizontalLayout {
                        padding-left: 0.5 * root.unit;
                        padding-right: 0.5 * root.unit;
                        spacing: 0.5 * root.unit;
                        alignment: center;

                        Image {
                            width: 1 * root.unit;
                            height: 1 * root.unit;
                            source: @image-url("../assets/images/icons/open-in-browser.svg");
                            colorize: Theme.text-secondary;
                            image-fit: contain;
                        }

                        Text {
                            text: @tr("SETTINGS_OPEN_FOLDER" => "Abrir carpeta");
                            color: Theme.text-secondary;
                            font-size: 0.8125 * root.unit;
                            font-weight: 500;
                            vertical-alignment: center;
                        }
                    }

                    clicked => { root.open-downloads-folder(); }
                }
            }
        }

        if (root.error != "") : Rectangle {
            x: root.dl-pad;
            y: root.dl-pad + root.dl-header-height + root.dl-gap;
            width: root.width - 2 * root.dl-pad;
            height: root.dl-banner-height;
            border-radius: Theme.border-radius;
            background: Theme.danger.with-alpha(0.10);
            border-width: 1px;
            border-color: Theme.danger.with-alpha(0.25);

            error-banner-row := HorizontalLayout {
                padding: 1 * root.unit;
                spacing: 0.75 * root.unit;
                alignment: start;

                Text {
                    horizontal-stretch: 1;
                    text: root.error;
                    color: Theme.text-primary;
                    font-size: 0.875 * root.unit;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }

                VerticalLayout {
                    alignment: center;
                    PillButton {
                        width: 8.5 * root.unit;
                        height: 2.5 * root.unit;
                        unit: root.unit;
                        label-font-weight: 500;
                        label: @tr("RETRY" => "Reintentar");
                        label-font-size: 0.8125 * root.unit;
                        clicked => { root.retry(); }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    ButtonSurface {
                        width: 2.75 * root.unit;
                        height: 2.5 * root.unit;
                        accessible-name: @tr("DISMISS" => "Cerrar aviso");
                        border-radius: self.height / 2;
                        border-width: 1px;
                        border-color: dl-hairline;
                        background: self.has-hover ? dl-surface-hover : transparent;
                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 1 * root.unit;
                            height: 1 * root.unit;
                            source: @image-url("../assets/images/icons/close.svg");
                            colorize: Theme.text-secondary;
                            image-fit: contain;
                        }
                        clicked => { root.dismiss-error(); }
                    }
                }
            }
        }

        if (!root.loading && root.items.length == 0 && root.error == "") : EmptyState {
            x: root.dl-pad;
            y: root.dl-list-top;
            width: root.width - 2 * root.dl-pad;
            height: root.dl-list-height;
            unit: root.unit;
            icon-source: @image-url("../assets/images/icons/download.svg");
            title: @tr("DOWNLOADS_EMPTY" => "No hay descargas aún");
            message: @tr("DOWNLOADS_EMPTY_HINT" => "Descargá una película o serie para tenerla disponible sin conexión con subtítulos.");
        }

        if (root.loading) : Text {
            x: root.dl-pad;
            y: root.dl-list-top;
            width: root.width - 2 * root.dl-pad;
            height: root.dl-list-height;
            text: @tr("LOADING" => "Cargando…");
            color: Theme.text-secondary;
            font-size: 0.875 * root.unit;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        if (!root.loading && root.items.length > 0) : ScrollView {
            x: root.dl-pad;
            y: root.dl-list-top;
            width: root.width - 2 * root.dl-pad;
            height: root.dl-list-height;
            viewport-width: self.visible-width;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            changed viewport-y => { root.menu-open = false; }

            VerticalLayout {
                width: 100%;
                alignment: start;
                spacing: 1 * root.unit;
                padding-bottom: 1 * root.unit;

                for item in root.items : card := Rectangle {
                    width: 100%;
                    property <bool> is-expanded: root.expanded-id == item.id;
                    property <string> hovered-ep-info: "";
                    // Auto-size to the real content: collapsed/expanded lists and
                    // movie cards no longer rely on a hand-computed height.
                    height: card-content.preferred-height;
                    border-radius: Theme.border-radius;
                    border-width: 1px;
                    border-color: item.has-failed
                        ? Theme.danger.with-alpha(0.30)
                        : (item.is-paused
                            ? dl-paused.with-alpha(0.30)
                            : (row-area.has-hover ? dl-hairline-strong : dl-hairline));
                    background: row-area.has-hover ? dl-surface-hover : dl-surface;
                    clip: true;

                    animate background, border-color { duration: Theme.motion-fast; }

                    // Card background click: toggles expand/collapse for series or plays completed movie
                    row-area := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            root.menu-open = false;
                            if (item.is-series) {
                                if (root.expanded-id == item.id) {
                                    root.expanded-id = "";
                                } else {
                                    root.expanded-id = item.id;
                                }
                            } else if (item.can-play) {
                                root.play(item.id);
                            }
                        }
                        pointer-event(event) => {
                            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                                root.menu-x = self.absolute-position.x - root.absolute-position.x + self.mouse-x;
                                root.menu-y = self.absolute-position.y - root.absolute-position.y + self.mouse-y;
                                root.menu-target = item.id;
                                root.menu-meta-id = item.meta-id;
                                root.menu-is-series = item.is-series;
                                root.menu-change-source = item.can-change-source;
                                root.menu-cancel = item.can-cancel || item.is-paused;
                                root.menu-delete = item.can-delete;
                                root.menu-open = true;
                            }
                        }
                    }

                    card-content := VerticalLayout {
                        x: 0px;
                        y: 0px;
                        width: 100%;
                        padding-left: 1.25 * root.unit;
                        padding-right: 1.25 * root.unit;
                        padding-top: 1 * root.unit;
                        padding-bottom: 1 * root.unit;
                        spacing: 0.75 * root.unit;
                        alignment: start;

                        // Compact main row: poster, meta and actions. Keeping this
                        // row short is what lets four or more downloads fit at once.
                        HorizontalLayout {
                            height: 4.5 * root.unit;
                            spacing: 1 * root.unit;

                            // Poster
                            poster-container := Rectangle {
                                width: 3 * root.unit;
                                height: 4.5 * root.unit;
                                border-radius: 6px;
                                background: dl-surface-raised;
                                border-width: 1px;
                                border-color: dl-hairline;
                                clip: true;

                                FallbackImage {
                                    width: 100%;
                                    height: 100%;
                                    source: item.poster;

                                    Image {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: 1.25 * root.unit;
                                        height: 1.25 * root.unit;
                                        source: item.is-series ? @image-url("../assets/images/icons/series.svg") : @image-url("../assets/images/icons/movies.svg");
                                        colorize: Theme.text-secondary;
                                        image-fit: contain;
                                    }
                                }
                            }

                            // Title, one quiet detail line and the progress bar
                            VerticalLayout {
                                horizontal-stretch: 1;
                                min-width: 0px;
                                alignment: center;
                                spacing: 0.375 * root.unit;

                                HorizontalLayout {
                                    height: 1.75 * root.unit;
                                    spacing: 0.625 * root.unit;
                                    alignment: start;
                                    cross-axis-alignment: center;

                                    Text {
                                        horizontal-stretch: 1;
                                        text: item.title;
                                        color: Theme.text-primary;
                                        font-size: 1.0625 * root.unit;
                                        font-weight: 600;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        horizontal-stretch: 0;
                                        text: item.is-series ? @tr("SERIES" => "Serie") : @tr("MOVIE" => "Película");
                                        color: Theme.text-muted;
                                        font-size: 0.75 * root.unit;
                                        font-weight: 500;
                                        vertical-alignment: center;
                                    }

                                    if (item.is-series) : Rectangle {
                                        horizontal-stretch: 0;
                                        height: 1.5 * root.unit;
                                        border-radius: 5px;
                                        background: card.is-expanded ? dl-surface-hover : dl-surface-raised;
                                        border-width: 1px;
                                        border-color: dl-hairline;

                                        HorizontalLayout {
                                            padding-left: 0.5 * root.unit;
                                            padding-right: 0.375 * root.unit;
                                            spacing: 0.25 * root.unit;
                                            alignment: center;
                                            cross-axis-alignment: center;

                                            Text {
                                                text: card.is-expanded ? @tr("HIDE_CHAPTERS" => "Ocultar") : @tr("SHOW_CHAPTERS" => "Ver capítulos");
                                                color: Theme.text-secondary;
                                                font-size: 0.75 * root.unit;
                                                font-weight: 500;
                                                vertical-alignment: center;
                                            }

                                            Image {
                                                width: 0.75 * root.unit;
                                                height: 0.75 * root.unit;
                                                source: card.is-expanded
                                                    ? @image-url("../assets/images/icons/chevron-up.svg")
                                                    : @image-url("../assets/images/icons/chevron-down.svg");
                                                colorize: Theme.text-muted;
                                                image-fit: contain;
                                            }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    height: 1.375 * root.unit;
                                    spacing: 0.5 * root.unit;
                                    alignment: start;
                                    cross-axis-alignment: center;

                                    if (item.watched) : Text {
                                        horizontal-stretch: 0;
                                        text: @tr("WATCHED" => "Visto");
                                        color: Theme.text-secondary;
                                        font-size: 0.75 * root.unit;
                                        font-weight: 500;
                                        vertical-alignment: center;
                                    }

                                    if (!item.is-series && item.watch-progress > 0 && !item.watched) : Rectangle {
                                        width: 5 * root.unit;
                                        height: 0.25 * root.unit;
                                        border-radius: self.height / 2;
                                        background: dl-surface-raised;

                                        Rectangle {
                                            width: parent.width * min(1.0, item.watch-progress);
                                            height: parent.height;
                                            border-radius: self.height / 2;
                                            background: Theme.text-secondary;
                                        }
                                    }

                                    Text {
                                        horizontal-stretch: 1;
                                        text: card.hovered-ep-info != ""
                                            ? card.hovered-ep-info
                                            : (item.coverage != "" && item.status != ""
                                                ? item.coverage + " · " + item.status
                                                : (item.coverage != "" ? item.coverage : item.status));
                                        color: card.hovered-ep-info != ""
                                            ? Theme.text-primary
                                            : (item.has-failed ? dl-error-text : (item.is-paused && !item.is-downloading ? dl-paused : Theme.text-secondary));
                                        font-size: 0.75 * root.unit;
                                        font-weight: card.hovered-ep-info != "" ? 500 : 400;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }

                                    if (item.has-subtitles) : Rectangle {
                                        horizontal-stretch: 0;
                                        width: 7 * root.unit;
                                        height: 1.375 * root.unit;
                                        border-radius: 4px;
                                        background: dl-surface-raised;
                                        border-width: 1px;
                                        border-color: dl-hairline;

                                        HorizontalLayout {
                                            width: 100%;
                                            height: 100%;
                                            padding-left: 0.375 * root.unit;
                                            padding-right: 0.375 * root.unit;
                                            spacing: 0.25 * root.unit;
                                            alignment: center;
                                            cross-axis-alignment: center;

                                            Image {
                                                width: 0.875 * root.unit;
                                                height: 0.875 * root.unit;
                                                source: @image-url("../assets/images/icons/subtitles.svg");
                                                colorize: Theme.text-secondary;
                                                image-fit: contain;
                                            }

                                            Text {
                                                horizontal-stretch: 1;
                                                text: item.subtitles-info;
                                                color: Theme.text-secondary;
                                                font-size: 0.6875 * root.unit;
                                                font-weight: 500;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                }

                                if (item.progress > 0 || item.is-downloading || item.is-paused) : Rectangle {
                                    height: 3px;
                                    border-radius: 2px;
                                    background: dl-surface-raised;
                                    clip: true;

                                    Rectangle {
                                        x: 0px;
                                        y: 0px;
                                        width: parent.width * item.progress.clamp(0, 1);
                                        height: parent.height;
                                        border-radius: parent.border-radius;
                                        background: item.has-failed && !item.is-downloading
                                            ? Theme.danger
                                            : (item.is-paused && !item.is-downloading
                                                ? dl-paused
                                                : (item.is-downloading ? Theme.accent : Theme.text-secondary));
                                    }
                                }
                            }

                            // One primary action plus the overflow menu, centered
                            HorizontalLayout {
                                alignment: end;
                                spacing: 0.5 * root.unit;
                                cross-axis-alignment: center;

                                if (item.can-play || item.can-pause || item.can-resume) : ButtonSurface {
                                    width: 8.25 * root.unit;
                                    height: 2.25 * root.unit;
                                    border-radius: 7px;
                                    background: dl-primary;
                                    border-width: self.has-focus ? Theme.focus-outline-size : 1px;
                                    border-color: self.has-focus ? Theme.primary-accent : dl-primary;
                                    accessible-name: item.can-play
                                        ? @tr("CTX_PLAY" => "Reproducir")
                                        : (item.can-pause
                                            ? @tr("PAUSE" => "Pausar")
                                            : (item.has-failed && !item.is-paused
                                                ? @tr("RETRY" => "Reintentar")
                                                : @tr("RESUME" => "Reanudar")));

                                    HorizontalLayout {
                                        width: 100%;
                                        height: 100%;
                                        spacing: 0.4375 * root.unit;
                                        alignment: center;
                                        cross-axis-alignment: center;

                                        Image {
                                            width: 0.875 * root.unit;
                                            height: 0.875 * root.unit;
                                            source: item.can-play
                                                ? @image-url("../assets/images/icons/play.svg")
                                                : (item.can-pause
                                                    ? @image-url("../assets/images/icons/pause.svg")
                                                    : (item.has-failed
                                                        ? @image-url("../assets/images/icons/replay.svg")
                                                        : @image-url("../assets/images/icons/play.svg")));
                                            colorize: dl-primary-ink;
                                            image-fit: contain;
                                        }

                                        Text {
                                            vertical-alignment: center;
                                            text: item.can-play
                                                ? @tr("CTX_PLAY" => "Reproducir")
                                                : (item.can-pause
                                                    ? @tr("PAUSE" => "Pausar")
                                                    : (item.has-failed && !item.is-paused
                                                        ? @tr("RETRY" => "Reintentar")
                                                        : @tr("RESUME" => "Reanudar")));
                                            color: dl-primary-ink;
                                            font-size: 0.8125 * root.unit;
                                            font-weight: 600;
                                        }
                                    }

                                    clicked => {
                                        root.menu-open = false;
                                        if (item.can-play) {
                                            root.play(item.id);
                                        } else if (item.can-pause) {
                                            root.pause(item.id);
                                        } else {
                                            root.resume(item.id);
                                        }
                                    }
                                }

                                ButtonSurface {
                                    width: 2.25 * root.unit;
                                    height: 2.25 * root.unit;
                                    border-radius: 7px;
                                    border-width: 1px;
                                    border-color: root.menu-open && root.menu-target == item.id ? dl-hairline-strong : dl-hairline;
                                    background: root.menu-open && root.menu-target == item.id ? dl-surface-hover : transparent;
                                    accessible-name: @tr("MORE_ACTIONS" => "Más acciones");

                                    pointer-down => {
                                        root.menu-x = self.absolute-position.x - root.absolute-position.x + self.width - 14.5 * root.unit;
                                        root.menu-y = self.absolute-position.y - root.absolute-position.y + self.height + 0.375 * root.unit;
                                    }

                                    clicked => {
                                        root.menu-x = self.absolute-position.x - root.absolute-position.x + self.width - 14.5 * root.unit;
                                        root.menu-y = self.absolute-position.y - root.absolute-position.y + self.height + 0.375 * root.unit;
                                        if (root.menu-open && root.menu-target == item.id) {
                                            root.menu-open = false;
                                        } else {
                                            root.menu-target = item.id;
                                            root.menu-meta-id = item.meta-id;
                                            root.menu-is-series = item.is-series;
                                            root.menu-change-source = item.can-change-source;
                                            root.menu-cancel = item.can-cancel || item.is-paused;
                                            root.menu-delete = item.can-delete;
                                            root.menu-open = true;
                                        }
                                    }

                                    Image {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: 1 * root.unit;
                                        height: 1 * root.unit;
                                        source: @image-url("../assets/images/icons/more-horizontal.svg");
                                        colorize: Theme.text-secondary;
                                        image-fit: contain;
                                    }
                                }
                            }
                        }

                        if (item.error-message != "") : Rectangle {
                            height: card-error-layout.preferred-height;
                            border-radius: 6px;
                            background: Theme.danger.with-alpha(0.10);
                            border-width: 1px;
                            border-color: Theme.danger.with-alpha(0.25);

                            card-error-layout := HorizontalLayout {
                                padding-left: 1 * root.unit;
                                padding-right: 1 * root.unit;
                                padding-top: 0.5 * root.unit;
                                padding-bottom: 0.5 * root.unit;
                                spacing: 0.5 * root.unit;

                                Text {
                                    horizontal-stretch: 1;
                                    text: item.error-message;
                                    color: dl-error-text;
                                    font-size: 0.8125 * root.unit;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        // The chapter list only takes space when the series card is
                        // expanded, so a long season does not hide the other titles.
                        if (item.is-series && card.is-expanded) : VerticalLayout {
                            spacing: 0.75 * root.unit;
                            padding-top: 0.5 * root.unit;

                            Rectangle {
                                height: 1px;
                                background: dl-hairline;
                            }

                            if (card.is-expanded) : HorizontalLayout {
                                alignment: space-between;
                                spacing: 1 * root.unit;
                                padding-top: 0.25 * root.unit;
                                padding-bottom: 0.25 * root.unit;

                                Text {
                                    horizontal-stretch: 0;
                                    text: @tr("ALL_CHAPTERS" => "Todos los capítulos");
                                    color: Theme.text-primary;
                                    font-size: 0.875 * root.unit;
                                    font-weight: 600;
                                }

                                Text {
                                    horizontal-stretch: 1;
                                    horizontal-alignment: right;
                                    text: card.hovered-ep-info != "" ? card.hovered-ep-info : @tr("CHAPTER_HINT" => "Descargados · Elegí un capítulo o temporada para gestionar");
                                    color: card.hovered-ep-info != "" ? Theme.text-primary : Theme.text-muted;
                                    font-size: 0.8125 * root.unit;
                                    font-weight: card.hovered-ep-info != "" ? 500 : 400;
                                    overflow: elide;
                                }
                            }

                            if (item.all-seasons.length == 0) : Text {
                                text: @tr("NO_SEASONS_AVAILABLE" => "Sin datos de capítulos.");
                                color: Theme.text-secondary;
                                font-size: 0.875 * root.unit;
                                wrap: word-wrap;
                            }

                            for s in item.all-seasons : season-row := Rectangle {
                                property <bool> season-visible: true;
                                visible: true;
                                width: 100%;
                                height: 3.5 * root.unit;
                                clip: true;
                                background: transparent;

                                HorizontalLayout {
                                    width: parent.width;
                                    height: parent.height;
                                    spacing: 0.75 * root.unit;

                                // Season Pill on left: "T1 · 2017", "T2 · 2022", etc. (Tocable) - squircle sin borde
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 0;
                                    Rectangle {
                                        width: s.season-year != "" ? 7 * root.unit : 3.75 * root.unit;
                                        height: 2.75 * root.unit;
                                        border-radius: 6px;
                                        background: season-pill-touch.has-hover ? dl-surface-hover : dl-surface-raised;

                                        season-pill-touch := TouchArea {
                                            mouse-cursor: MouseCursor.pointer;
                                            moved => {
                                                card.hovered-ep-info = s.season-label + (s.season-year != "" ? " (" + s.season-year + ")" : "") + (s.has-active || s.has-paused ? " · Elegí para pausar, cancelar o cambiar fuente" : (s.has-downloaded ? " · Elegí para descargar o eliminar temporada" : " · Elegí para buscar y descargar temporada"));
                                            }
                                            clicked => {
                                                root.open-season-prompt(item, s);
                                            }
                                            pointer-event(event) => {
                                                if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                                                    root.open-season-prompt(item, s);
                                                }
                                            }
                                        }

                                        Text {
                                            width: 100%;
                                            height: 100%;
                                            text: s.season-year != "" ? (s.season-label + " · " + s.season-year) : s.season-label;
                                            color: Theme.text-primary;
                                            font-size: 0.875 * root.unit;
                                            font-weight: 600;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Horizontal strip of episodes: E1 E2 E3 ... EN (scrollable so long seasons never clip)
                                ep-viewport := Rectangle {
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    height: parent.height;
                                    background: transparent;
                                    clip: true;

                                    ep-scroll := ScrollView {
                                        x: 0px;
                                        y: 0px;
                                        width: parent.width;
                                        height: parent.height;
                                        viewport-width: max(parent.width, ep-strip.preferred-width);
                                        viewport-height: parent.height;
                                        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                                        horizontal-scrollbar-policy: ScrollBarPolicy.as-needed;
                                        mouse-drag-pan-enabled: true;

                                        ep-strip := HorizontalLayout {
                                            x: 0px;
                                            y: (ep-viewport.height - self.height) / 2;
                                            height: 2.75 * root.unit;
                                            spacing: 0.5 * root.unit;
                                            alignment: start;

                                            for ep in s.episodes : VerticalLayout {
                                                alignment: center;
                                                horizontal-stretch: 0;
                                                Rectangle {
                                                    width: ep-grid-touch.has-hover && ep.title != ""
                                                        ? min(22 * root.unit, 4.5 * root.unit + ep-title-measure.preferred-width + 1.5 * root.unit)
                                                        : 4.5 * root.unit;
                                                    height: 2.75 * root.unit;
                                                    border-radius: 6px;
                                                    border-width: ep.is-failed || ep.is-downloading || ep.is-paused ? 1px : 0px;
                                                    border-color: ep.is-failed
                                                        ? Theme.danger.with-alpha(0.35)
                                                        : (ep.is-downloading
                                                            ? Theme.primary-accent.with-alpha(0.35)
                                                            : (ep.is-paused ? dl-paused.with-alpha(0.35) : transparent));
                                                    clip: true;
                                                    animate width { duration: Theme.motion-panel; easing: ease-out; }
                                                    background: ep.is-downloaded
                                                        ? (ep-grid-touch.has-hover ? dl-surface-hover : dl-surface-raised)
                                                        : (ep.is-downloading
                                                            ? (ep-grid-touch.has-hover ? dl-surface-hover : dl-surface-raised)
                                                            : (ep.is-paused
                                                                ? (ep-grid-touch.has-hover ? dl-surface-hover : dl-surface-raised)
                                                                : (ep.is-failed
                                                                    ? (ep-grid-touch.has-hover ? dl-surface-hover : dl-surface-raised)
                                                                    : (ep-grid-touch.has-hover ? dl-surface-hover : dl-surface))));

                                                    ep-title-measure := Text {
                                                        visible: false;
                                                        text: ep.title;
                                                        font-size: 0.75 * root.unit;
                                                    }

                                                    if (ep.is-downloading) : Rectangle {
                                                        x: 0px;
                                                        y: parent.height - 3px;
                                                        width: parent.width * max(0.08, min(1.0, ep.progress));
                                                        height: 3px;
                                                        background: Theme.accent;
                                                    }

                                                if (ep.is-paused) : Rectangle {
                                                    x: 0px;
                                                    y: parent.height - 3px;
                                                    width: parent.width * max(0.08, min(1.0, ep.progress));
                                                    height: 3px;
                                                    background: dl-paused;
                                                }

                                                if (!ep.is-downloading && !ep.is-paused && ep.watch-progress > 0) : Rectangle {
                                                    x: 0px;
                                                    y: parent.height - 3px;
                                                    width: parent.width * min(1.0, ep.watch-progress);
                                                    height: 3px;
                                                    background: Theme.text-secondary;
                                                }

                                                ep-grid-touch := TouchArea {
                                                    mouse-cursor: MouseCursor.pointer;
                                                    moved => {
                                                        card.hovered-ep-info = s.season-label + " · E" + ep.episode-num
                                                            + (ep.title != "" ? ": " + ep.title : "")
                                                            + (ep.is-downloaded
                                                                ? " (Descargado · Elegí para reproducir, clic derecho para opciones)"
                                                                : (ep.is-downloading
                                                                    ? " (Descargando " + Math.round(ep.progress * 100) + "% · Elegí para pausar, cancelar o cambiar fuente)"
                                                                    : (ep.is-paused
                                                                        ? " (Pausado " + Math.round(ep.progress * 100) + "% · Elegí para reanudar, cancelar o cambiar fuente)"
                                                                        : (ep.is-failed
                                                                            ? " (Error: " + ep.error-message + ")"
                                                                            : " (No descargado · Elegí para descargar)"))));
                                                    }
                                                    clicked => {
                                                        if (ep.is-downloaded) {
                                                            root.play(ep.id);
                                                        } else {
                                                            root.prompt-download-meta-id = item.meta-id;
                                                            root.prompt-download-title = item.title;
                                                            root.prompt-download-season = ep.season;
                                                            root.prompt-download-episode = ep.episode-num;
                                                            root.prompt-download-ep-title = ep.title;
                                                            root.prompt-download-job-id = ep.id;
                                                            root.prompt-download-is-downloaded = false;
                                                            root.prompt-download-is-downloading = ep.is-downloading;
                                                            root.prompt-download-is-paused = ep.is-paused;
                                                            root.prompt-download-is-failed = ep.is-failed;
                                                            root.prompt-download-progress = ep.progress;
                                                            root.prompt-download-error = ep.error-message;
                                                            root.prompt-download-season-has-dl = s.has-downloaded;
                                                            root.prompt-download-season-has-active = s.has-active;
                                                            root.prompt-download-season-has-paused = s.has-paused;
                                                            root.prompt-download-season-label = s.season-label;
                                                            root.prompt-download-season-year = s.season-year;
                                                            root.prompt-download-open = true;
                                                        }
                                                    }
                                                    pointer-event(event) => {
                                                        if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                                                            root.prompt-download-meta-id = item.meta-id;
                                                            root.prompt-download-title = item.title;
                                                            root.prompt-download-season = ep.season;
                                                            root.prompt-download-episode = ep.episode-num;
                                                            root.prompt-download-ep-title = ep.title;
                                                            root.prompt-download-job-id = ep.id;
                                                            root.prompt-download-is-downloaded = ep.is-downloaded;
                                                            root.prompt-download-is-downloading = ep.is-downloading;
                                                            root.prompt-download-is-paused = ep.is-paused;
                                                            root.prompt-download-is-failed = ep.is-failed;
                                                            root.prompt-download-progress = ep.progress;
                                                            root.prompt-download-error = ep.error-message;
                                                            root.prompt-download-season-has-dl = s.has-downloaded;
                                                            root.prompt-download-season-has-active = s.has-active;
                                                            root.prompt-download-season-has-paused = s.has-paused;
                                                            root.prompt-download-season-label = s.season-label;
                                                            root.prompt-download-season-year = s.season-year;
                                                            root.prompt-download-open = true;
                                                        }
                                                    }
                                                }

                                                if (ep.watched) : Image {
                                                    x: parent.width - 1 * root.unit;
                                                    y: 0.25 * root.unit;
                                                    width: 1 * root.unit;
                                                    height: 1 * root.unit;
                                                    source: @image-url("../assets/images/icons/checkmark.svg");
                                                    colorize: Theme.text-secondary;
                                                    image-fit: contain;
                                                }

                                                HorizontalLayout {
                                                    width: 100%;
                                                    height: 100%;
                                                    padding-left: 0.5 * root.unit;
                                                    padding-right: 0.5 * root.unit;
                                                    alignment: center;
                                                    spacing: 0.25 * root.unit;

                                                    if (ep.is-downloaded) : Rectangle {
                                                        width: 1 * root.unit;
                                                        height: parent.height;
                                                        background: transparent;

                                                        Image {
                                                            x: 0px;
                                                            y: (parent.height - self.height) / 2;
                                                            width: 1 * root.unit;
                                                            height: 1 * root.unit;
                                                            source: @image-url("../assets/images/icons/play.svg");
                                                            colorize: Theme.text-primary;
                                                            image-fit: contain;
                                                        }
                                                    }

                                                    if (ep.is-paused) : Rectangle {
                                                        width: 1 * root.unit;
                                                        height: parent.height;
                                                        background: transparent;

                                                        Image {
                                                            x: 0px;
                                                            y: (parent.height - self.height) / 2;
                                                            width: 1 * root.unit;
                                                            height: 1 * root.unit;
                                                            source: @image-url("../assets/images/icons/pause.svg");
                                                            colorize: dl-paused;
                                                            image-fit: contain;
                                                        }
                                                    }

                                                    if (!ep.is-downloaded && !ep.is-paused) : Rectangle {
                                                        width: 1 * root.unit;
                                                        height: parent.height;
                                                        background: transparent;

                                                        Image {
                                                            x: 0px;
                                                            y: (parent.height - self.height) / 2;
                                                            width: 1 * root.unit;
                                                            height: 1 * root.unit;
                                                            source: @image-url("../assets/images/icons/download.svg");
                                                            colorize: ep.is-failed
                                                                ? dl-error-text
                                                                : (ep.is-downloading
                                                                    ? Theme.text-primary
                                                                    : (ep-grid-touch.has-hover ? Theme.text-primary : Theme.text-muted));
                                                            image-fit: contain;
                                                        }
                                                    }

                                                    Text {
                                                        height: parent.height;
                                                        text: "E" + ep.episode-num;
                                                        color: ep.is-downloaded
                                                            ? Theme.text-primary
                                                            : (ep.is-failed
                                                                ? dl-error-text
                                                                : (ep.is-downloading
                                                                    ? Theme.text-primary
                                                                    : (ep.is-paused
                                                                        ? dl-paused
                                                                        : (ep-grid-touch.has-hover ? Theme.text-primary : Theme.text-muted))));
                                                        font-size: 0.875 * root.unit;
                                                        font-weight: 500;
                                                        vertical-alignment: center;
                                                    }

                                                    if (ep-grid-touch.has-hover && ep.title != "") : Text {
                                                        horizontal-stretch: 1;
                                                        height: parent.height;
                                                        text: ep.title;
                                                        color: Theme.text-primary;
                                                        font-size: 0.75 * root.unit;
                                                        font-weight: 500;
                                                        vertical-alignment: center;
                                                        overflow: elide;
                                                    }
                                                }
                                            }
                                        }
                                        }
                                    }
                                }
                                }
                            }
                        }
                    }
                }
            }
        }

        if (root.disk-usage-text != "") : Rectangle {
            x: root.dl-pad;
            y: root.height - root.dl-pad - root.dl-footer-height;
            width: root.width - 2 * root.dl-pad;
            height: root.dl-footer-height;
            background: transparent;

            Rectangle {
                y: 0px;
                width: 100%;
                height: 1px;
                background: dl-hairline;
            }

            Text {
                y: 1px + 0.75 * root.unit;
                width: 100%;
                height: root.dl-footer-height - 1px - 0.75 * root.unit;
                text: root.disk-usage-text;
                color: Theme.text-muted;
                font-size: 0.75 * root.unit;
                vertical-alignment: center;
                overflow: elide;
            }
        }

    // ModalDialog for Episode / Season Actions (Play, Pause, Resume, Cancel, Change source, Download, Delete)
    ModalDialog {
        width: 100%;
        height: 100%;
        z: 2000;
        unit: root.unit;
        open: root.prompt-download-open;
        title: root.prompt-download-episode == 0
            ? ("Gestionar " + (root.prompt-download-season-label != "" ? root.prompt-download-season-label : ("Temporada " + root.prompt-download-season)))
            : (root.prompt-download-is-downloaded
                ? "Capítulo descargado"
                : (root.prompt-download-is-downloading
                    ? "Descargando capítulo"
                    : (root.prompt-download-is-paused
                        ? "Descarga pausada"
                        : (root.prompt-download-is-failed ? "Error en descarga de capítulo" : "Descargar capítulo"))));
        dialog-width: 54 * root.unit;
        dialog-height: 29 * root.unit;
        close-requested => { root.prompt-download-open = false; }

        VerticalLayout {
            padding: 0px;
            spacing: 1.25 * root.unit;

            Rectangle {
                height: 5 * root.unit;
                border-radius: Theme.border-radius;
                background: dl-surface-raised;
                border-width: 1px;
                border-color: dl-hairline;

                VerticalLayout {
                    padding-left: 1.25 * root.unit;
                    padding-right: 1.25 * root.unit;
                    alignment: center;
                    spacing: 0.25 * root.unit;

                    Text {
                        text: root.prompt-download-title;
                        color: Theme.text-primary;
                        font-size: 1.25 * root.unit;
                        font-weight: 600;
                        overflow: elide;
                    }

                    Text {
                        text: root.prompt-download-episode == 0
                            ? ((root.prompt-download-season-label != "" ? root.prompt-download-season-label : ("Temporada " + root.prompt-download-season)) + (root.prompt-download-season-year != "" ? (" · " + root.prompt-download-season-year) : ""))
                            : ((root.prompt-download-season-label != "" ? root.prompt-download-season-label : ("Temporada " + root.prompt-download-season)) + " · Episodio " + root.prompt-download-episode + (root.prompt-download-ep-title != "" ? (": " + root.prompt-download-ep-title) : ""));
                        color: Theme.text-secondary;
                        font-size: 0.8125 * root.unit;
                        font-weight: 500;
                        overflow: elide;
                    }
                }
            }

            if (root.prompt-download-is-failed && root.prompt-download-error != "") : Rectangle {
                height: prompt-error-box.preferred-height;
                border-radius: Theme.border-radius;
                background: Theme.danger.with-alpha(0.10);
                border-width: 1px;
                border-color: Theme.danger.with-alpha(0.25);

                prompt-error-box := HorizontalLayout {
                    padding: 0.75 * root.unit;

                    Text {
                        horizontal-stretch: 1;
                        text: root.prompt-download-error;
                        color: dl-error-text;
                        font-size: 0.875 * root.unit;
                        wrap: word-wrap;
                    }
                }
            }

            if (!root.prompt-download-is-failed) : Text {
                text: root.prompt-download-episode == 0
                    ? (root.prompt-download-season-has-active
                        ? "Hay capítulos descargándose. Podés pausarlos, cancelar los pendientes o cambiar de fuente."
                        : (root.prompt-download-season-has-paused
                            ? "Hay descargas pausadas. Podés reanudarlas, cancelarlas o cambiar de fuente."
                            : (root.prompt-download-season-has-dl
                                ? "Podés descargar la temporada completa o eliminar los capítulos ya descargados."
                                : "¿Buscar fuentes para descargar esta temporada?")))
                    : (root.prompt-download-is-downloaded
                        ? "Ya está en tu equipo. Podés reproducirlo o eliminarlo."
                        : (root.prompt-download-is-downloading
                            ? ("Se está descargando (" + Math.round(root.prompt-download-progress * 100) + "%). Podés pausar, cancelar o cambiar de fuente.")
                            : (root.prompt-download-is-paused
                                ? ("Pausado (" + Math.round(root.prompt-download-progress * 100) + "%). Podés reanudar, cancelar o cambiar de fuente.")
                                : "No está descargado. Podés bajar solo este capítulo o la temporada completa.")));
                color: Theme.text-secondary;
                font-size: 0.875 * root.unit;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 0.5 * root.unit;
                alignment: end;
                padding-top: 0.5 * root.unit;

                ButtonSurface {
                    height: 2.5 * root.unit;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: dl-hairline-strong;
                    background: self.has-hover || self.has-focus ? dl-surface-hover : transparent;
                    accessible-name: @tr("CLOSE" => "Cerrar");

                    HorizontalLayout {
                        padding-left: 1.25 * root.unit;
                        padding-right: 1.25 * root.unit;
                        alignment: center;

                        Text {
                            text: @tr("CLOSE" => "Cerrar");
                            color: Theme.text-primary;
                            font-size: 0.875 * root.unit;
                            font-weight: 500;
                            vertical-alignment: center;
                        }
                    }

                    clicked => { root.prompt-download-open = false; }
                }

                ButtonSurface {
                    width: 12.5 * root.unit;
                    height: 2.5 * root.unit;
                    border-radius: 8px;
                    background: dl-primary;
                    border-width: self.has-focus ? Theme.focus-outline-size : 1px;
                    border-color: self.has-focus ? Theme.primary-accent : dl-primary;
                    accessible-name: root.prompt-download-episode == 0
                        ? (root.prompt-download-season-has-active
                            ? @tr("PAUSE" => "Pausar")
                            : (root.prompt-download-season-has-paused
                                ? @tr("RESUME" => "Reanudar")
                                : "Descargar temporada"))
                        : (root.prompt-download-is-downloaded
                            ? @tr("CTX_PLAY" => "Reproducir")
                            : (root.prompt-download-is-downloading
                                ? @tr("PAUSE" => "Pausar")
                                : (root.prompt-download-is-paused
                                    ? @tr("RESUME" => "Reanudar")
                                    : (root.prompt-download-is-failed
                                        ? @tr("RETRY" => "Reintentar")
                                        : "Buscar y descargar"))));

                    HorizontalLayout {
                        width: 100%;
                        height: 100%;
                        padding-left: 1.25 * root.unit;
                        padding-right: 1.25 * root.unit;
                        spacing: 0.5 * root.unit;
                        alignment: center;

                        Image {
                            width: 1 * root.unit;
                            height: 1 * root.unit;
                            source: root.prompt-download-episode == 0
                                ? (root.prompt-download-season-has-active
                                    ? @image-url("../assets/images/icons/pause.svg")
                                    : (root.prompt-download-season-has-paused
                                        ? @image-url("../assets/images/icons/play.svg")
                                        : @image-url("../assets/images/icons/download.svg")))
                                : (root.prompt-download-is-downloaded
                                    ? @image-url("../assets/images/icons/play.svg")
                                    : (root.prompt-download-is-downloading
                                        ? @image-url("../assets/images/icons/pause.svg")
                                        : (root.prompt-download-is-paused
                                            ? @image-url("../assets/images/icons/play.svg")
                                            : (root.prompt-download-is-failed
                                                ? @image-url("../assets/images/icons/replay.svg")
                                                : @image-url("../assets/images/icons/download.svg")))));
                            colorize: dl-primary-ink;
                            image-fit: contain;
                        }

                        Text {
                            text: root.prompt-download-episode == 0
                                ? (root.prompt-download-season-has-active
                                    ? @tr("PAUSE" => "Pausar")
                                    : (root.prompt-download-season-has-paused
                                        ? @tr("RESUME" => "Reanudar")
                                        : "Descargar temporada"))
                                : (root.prompt-download-is-downloaded
                                    ? @tr("CTX_PLAY" => "Reproducir")
                                    : (root.prompt-download-is-downloading
                                        ? @tr("PAUSE" => "Pausar")
                                        : (root.prompt-download-is-paused
                                            ? @tr("RESUME" => "Reanudar")
                                            : (root.prompt-download-is-failed
                                                ? @tr("RETRY" => "Reintentar")
                                                : "Buscar y descargar"))));
                            color: dl-primary-ink;
                            font-size: 0.875 * root.unit;
                            font-weight: 500;
                            vertical-alignment: center;
                        }
                    }

                    clicked => {
                        root.menu-open = false;
                        if (root.prompt-download-episode == 0) {
                            if (root.prompt-download-season-has-active) {
                                root.pause("season:" + root.prompt-download-meta-id + ":" + root.prompt-download-season);
                            } else if (root.prompt-download-season-has-paused) {
                                root.resume("season:" + root.prompt-download-meta-id + ":" + root.prompt-download-season);
                            } else {
                                root.request-download-episode(root.prompt-download-meta-id, root.prompt-download-season, 0, false);
                            }
                        } else if (root.prompt-download-is-downloaded) {
                            root.play(root.prompt-download-job-id);
                        } else if (root.prompt-download-is-downloading) {
                            root.pause(root.prompt-download-job-id);
                        } else if (root.prompt-download-is-paused) {
                            root.resume(root.prompt-download-job-id);
                        } else if (root.prompt-download-is-failed) {
                            root.resume(root.prompt-download-job-id);
                        } else {
                            root.request-download-episode(root.prompt-download-meta-id, root.prompt-download-season, root.prompt-download-episode, false);
                        }
                        root.prompt-download-open = false;
                    }
                }

                if (root.prompt-download-episode == 0
                    ? (root.prompt-download-season-has-dl || root.prompt-download-season-has-active || root.prompt-download-season-has-paused)
                    : (root.prompt-download-is-downloaded || root.prompt-download-is-downloading || root.prompt-download-is-paused || root.prompt-download-is-failed)) : ButtonSurface {
                    width: 2.5 * root.unit;
                    height: 2.5 * root.unit;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: root.menu-open && root.menu-target == "prompt" ? dl-hairline-strong : dl-hairline;
                    background: root.menu-open && root.menu-target == "prompt" ? dl-surface-hover : transparent;
                    accessible-name: @tr("MORE_ACTIONS" => "Más acciones");

                    pointer-down => {
                        root.menu-x = self.absolute-position.x - root.absolute-position.x + self.width - 14.5 * root.unit;
                        root.menu-y = self.absolute-position.y - root.absolute-position.y + self.height + 0.375 * root.unit;
                    }

                    clicked => {
                        root.menu-x = self.absolute-position.x - root.absolute-position.x + self.width - 14.5 * root.unit;
                        root.menu-y = self.absolute-position.y - root.absolute-position.y + self.height + 0.375 * root.unit;
                        if (root.menu-open && root.menu-target == "prompt") {
                            root.menu-open = false;
                        } else {
                            root.menu-target = "prompt";
                            root.menu-change-source = root.prompt-download-episode == 0
                                ? (root.prompt-download-season-has-active || root.prompt-download-season-has-paused)
                                : (root.prompt-download-is-downloading || root.prompt-download-is-paused || root.prompt-download-is-failed);
                            root.menu-cancel = root.prompt-download-episode == 0
                                ? (root.prompt-download-season-has-active || root.prompt-download-season-has-paused)
                                : (root.prompt-download-is-downloading || root.prompt-download-is-paused);
                            root.menu-delete = root.prompt-download-episode == 0
                                ? (root.prompt-download-season-has-dl || root.prompt-download-season-has-active || root.prompt-download-season-has-paused)
                                : (root.prompt-download-is-downloaded || root.prompt-download-is-downloading || root.prompt-download-is-paused || root.prompt-download-is-failed);
                            root.menu-open = true;
                        }
                    }

                    Image {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 1 * root.unit;
                        height: 1 * root.unit;
                        source: @image-url("../assets/images/icons/more-horizontal.svg");
                        colorize: Theme.text-secondary;
                        image-fit: contain;
                    }
                }
            }
        }
    }

    // One anchored menu for the card and modal overflow actions. It lives at
    // page level so the list ScrollView can never clip it.
    ContextMenuSurface {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        z: 100000;
        unit: root.unit;
        open: root.menu-open;
        requested-x: root.menu-x;
        requested-y: root.menu-y;
        menu-width: 14.5 * root.unit;
        menu-height: menu-content.preferred-height + 2px;
        surface-color: dl-surface-raised;
        menu-border-color: dl-hairline-strong;
        close-requested => { root.menu-open = false; }

        menu-content := VerticalLayout {
            padding: 0.375 * root.unit;
            spacing: 0.25 * root.unit;

            if (root.menu-change-source) : DownloadMenuRow {
                unit: root.unit;
                hover-color: dl-surface-hover;
                label: "Cambiar fuente";
                icon-source: @image-url("../assets/images/icons/link.svg");
                clicked => {
                    root.menu-open = false;
                    if (root.menu-target == "prompt") {
                        root.request-download-episode(
                            root.prompt-download-meta-id,
                            root.prompt-download-season,
                            root.prompt-download-episode == 0 ? 0 : root.prompt-download-episode,
                            true
                        );
                    } else {
                        root.request-download-episode(
                            root.menu-meta-id,
                            root.menu-is-series ? -2 : -1,
                            -1,
                            true
                        );
                    }
                }
            }

            if (root.menu-cancel) : DownloadMenuRow {
                unit: root.unit;
                hover-color: dl-surface-hover;
                label: "Cancelar descarga";
                icon-source: @image-url("../assets/images/icons/close.svg");
                clicked => {
                    root.menu-open = false;
                    if (root.menu-target == "prompt") {
                        if (root.prompt-download-episode == 0) {
                            root.cancel("season:" + root.prompt-download-meta-id + ":" + root.prompt-download-season);
                        } else {
                            root.cancel(root.prompt-download-job-id);
                        }
                    } else {
                        root.cancel(root.menu-target);
                    }
                }
            }

            if (root.menu-change-source || root.menu-cancel) : Rectangle {
                height: 1px;
                background: dl-hairline;
            }

            if (root.menu-delete) : DownloadMenuRow {
                unit: root.unit;
                hover-color: Theme.danger.with-alpha(0.14);
                label: "Eliminar";
                icon-source: @image-url("../assets/images/icons/delete.svg");
                destructive: true;
                destructive-color: dl-error-text;
                clicked => {
                    root.menu-open = false;
                    if (root.menu-target == "prompt") {
                        if (root.prompt-download-episode == 0) {
                            root.delete-item("season:" + root.prompt-download-meta-id + ":" + root.prompt-download-season);
                        } else {
                            root.delete-item(root.prompt-download-job-id);
                        }
                    } else {
                        root.delete-item(root.menu-target);
                    }
                }
            }
        }
    }
}
