import { Theme } from "../theme.slint";
import { ButtonSurface, IconAction, PillButton } from "button.slint";
import { MetaStringLinks } from "meta_preview.slint";
import { ScrollView } from "std-widgets.slint";

component DrawerIconButton inherits ButtonSurface {
    in property <length> unit: Theme.root-font-size;
    in property <image> icon-source;
    in property <length> size: 2.4 * root.unit;
    in property <length> icon-size: 1.25 * root.unit;
    in property <brush> surface-color: Theme.background.with-alpha(0.65);
    in property <brush> icon-color: Theme.primary-foreground;

    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: self.has-hover ? Theme.overlay-hover : root.surface-color;

    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.icon-size;
        height: root.icon-size;
        source: root.icon-source;
        colorize: root.icon-color;
        image-fit: contain;
    }
}

export component MediaPreviewDrawer inherits Rectangle {
    in property <length> unit: Theme.root-font-size;
    in property <length> drawer-width: 29 * root.unit;
    in property <bool> is-open: true;

    // Metadatos
    in property <string> title: "";
    in property <image> logo;
    in property <image> poster;
    in property <string> year: "";
    in property <string> runtime: "";
    in property <string> description: "";
    in property <[string]> genres: [];
    in property <[string]> cast: [];
    in property <[string]> directors: [];

    // Calificaciones (The Big 3)
    in property <string> rating-imdb: "";
    in property <string> rating-rt: "";
    in property <string> rating-metacritic: "";
    in property <bool> ratings-loading: false;

    // Estado del trailer y video
    in property <image> video-frame;
    in property <bool> has-video-frame: false;
    in property <bool> video-loading: false;
    in property <bool> video-playing: false;
    in property <bool> video-muted: true;
    in property <float> video-volume: 0.75;
    in property <float> video-speed: 1.0;
    in property <bool> has-trailer: false;
    in property <bool> autoplay-enabled: false;
    in-out property <float> video-progress: 0.0; // 0.0 a 1.0
    in property <string> video-time-label: "";   // ej. "0:34 / 2:15"

    // Estado en Library
    in property <bool> in-library: false;
    in property <bool> is-watched: false;

    // Callbacks
    callback play-full-details();
    callback toggle-library();
    callback toggle-watched();
    callback close-drawer();
    callback toggle-trailer-playback();
    callback toggle-video-muted();
    callback change-video-volume(float);
    callback change-video-speed(float);
    callback toggle-autoplay();
    callback maximize-trailer();
    callback seek-video-relative(float);
    callback seek-video-progress(float);
    callback metadata-filter-selected(string);

    // Dimensiones fijas anti-layout shift (Zero CLS)
    property <length> video-height: root.drawer-width * 0.5625; // 16:9 exacto
    property <length> header-height: 5 * root.unit;
    property <length> meta-row-height: 1.4 * root.unit;
    property <length> ratings-height: 2.8 * root.unit;
    property <length> actions-height: 5.5 * root.unit;

    // Conmutación inmediata de width para no recalcular columnas 12 veces seguidas
    width: root.is-open ? root.drawer-width : 0px;
    visible: root.width > 0px;
    clip: true;
    background: Theme.modal-background;
    border-radius: Theme.border-radius;

    private property <float> content-fade-opacity: 1.0;
    private property <bool> content-fade-in-pending: false;
    private property <int> poster-ready: root.poster.width > 0 ? 1 : 0;
    private property <int> logo-ready: root.logo.width > 0 ? 1 : 0;

    function trigger-content-fade() {
        root.content-fade-opacity = 0.0;
        root.content-fade-in-pending = true;
    }

    changed is-open => {
        if (root.is-open) {
            root.trigger-content-fade();
        } else {
            root.content-fade-opacity = 0.0;
            root.content-fade-in-pending = false;
        }
    }

    changed title => {
        if (root.is-open && root.title != "") {
            root.trigger-content-fade();
        }
    }

    changed description => {
        if (root.is-open && root.description != "") {
            root.trigger-content-fade();
        }
    }

    Timer {
        interval: 65ms;
        running: root.content-fade-in-pending;
        triggered => {
            root.content-fade-in-pending = false;
            root.content-fade-opacity = 1.0;
        }
    }

    drawer-content := VerticalLayout {
        width: root.drawer-width;
        height: parent.height;
        spacing: 0px;
        opacity: root.is-open ? root.content-fade-opacity : 0.0;
        animate opacity {
            duration: root.content-fade-in-pending ? 65ms : 230ms;
            easing: ease-out;
        }

        // =====================================================================
        // 1. ZONA SUPERIOR: REPRODUCTOR DE TRAILER (16:9 FIJO - ESTILO TUBE OXIDE)
        // =====================================================================
        video-container := Rectangle {
            height: root.video-height;
            background: #000000;
            clip: true;

            private property <float> effective-vol: root.video-muted ? 0.0 : Math.max(0.0, Math.min(1.0, root.video-volume));
            private property <string> speed-label:
                Math.abs(root.video-speed - 0.5) < 0.05 ? "0.5x" :
                Math.abs(root.video-speed - 0.75) < 0.05 ? "0.75x" :
                Math.abs(root.video-speed - 1.25) < 0.05 ? "1.25x" :
                Math.abs(root.video-speed - 1.5) < 0.05 ? "1.5x" :
                Math.abs(root.video-speed - 2.0) < 0.05 ? "2x" : "1x";

            property <int> idle-ticks: 0;
            property <bool> hovering-bar:
                drawer-bottom-touch.has-hover
                || drawer-scrubber-touch.has-hover
                || drawer-scrubber-touch.pressed
                || drawer-play-btn.has-hover
                || drawer-mute-btn.has-hover
                || drawer-vol-touch.has-hover
                || drawer-vol-touch.pressed
                || drawer-speed-btn.has-hover
                || drawer-auto-btn.has-hover
                || drawer-fs-btn.has-hover
                || drawer-corner-fs-btn.has-hover
                || close-drawer-btn.has-hover;
            property <bool> show-chrome:
                !root.video-playing
                || self.hovering-bar
                || self.idle-ticks < 7;

            Timer {
                interval: 500ms;
                running: root.has-trailer;
                triggered => {
                    if (video-container.hovering-bar || !root.video-playing) {
                        video-container.idle-ticks = 0;
                    } else if (video-container.idle-ticks < 14) {
                        video-container.idle-ticks += 1;
                    }
                }
            }

            // Backdrop / Póster base
            if (root.poster.width > 0) : Image {
                width: parent.width;
                height: parent.height;
                source: root.poster;
                image-fit: cover;
                opacity: root.has-video-frame ? 0 : 0.50;
                animate opacity { duration: 150ms; }
            }

            // Frame decodificado por MPV
            if (root.has-video-frame) : Image {
                width: parent.width;
                height: parent.height;
                source: root.video-frame;
                image-fit: contain;
            }

            // Área interactiva de control: Click = Toggle Play/Pause, Double-click = Fullscreen, Scroll = Seek
            drawer-video-touch := TouchArea {
                width: parent.width;
                height: parent.height;
                mouse-cursor: root.has-trailer ? MouseCursor.pointer : MouseCursor.default;
                moved => {
                    video-container.idle-ticks = 0;
                }
                pointer-event(event) => {
                    video-container.idle-ticks = 0;
                }
                clicked => {
                    video-container.idle-ticks = 0;
                    if (root.has-trailer) {
                        root.toggle-trailer-playback();
                    }
                }
                double-clicked => {
                    video-container.idle-ticks = 0;
                    if (root.has-trailer) {
                        root.maximize-trailer();
                    }
                }
                scroll-event(event) => {
                    video-container.idle-ticks = 0;
                    if (event.delta-y > 0px) {
                        root.seek-video-relative(5.0);
                    } else if (event.delta-y < 0px) {
                        root.seek-video-relative(-5.0);
                    }
                    accept
                }
            }

            // Botón central de Play estilo Tube Oxide cuando está detenido o pausado
            drawer-center-play := ButtonSurface {
                width: 50px;
                height: 50px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: 25px;
                visible: !root.video-playing && root.has-trailer && !root.video-loading;
                background: self.has-hover ? #ff0000e6 : #000000a6;
                border-width: 1px;
                border-color: self.has-hover ? #ff4444 : #ffffff30;
                accessible-name: @tr("Watch Trailer");
                clicked => { root.toggle-trailer-playback(); }

                Image {
                    width: 22px;
                    height: 22px;
                    x: (parent.width - self.width) / 2 + 2px;
                    y: (parent.height - self.height) / 2;
                    source: @image-url("../assets/images/icons/play.svg");
                    colorize: #ffffff;
                    image-fit: contain;
                }
            }

            // Indicador de carga / buffering
            if (root.video-loading && !root.has-video-frame) : Rectangle {
                width: parent.width;
                height: parent.height;
                background: #00000078;

                Rectangle {
                    width: 44px;
                    height: 44px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    border-radius: 22px;
                    background: #000000a6;
                    border-width: 2px;
                    border-color: #ff0000;

                    Text {
                        text: "…";
                        color: #ffffff;
                        font-size: 20px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // Botón en esquina superior derecha para maximizar trailer
            drawer-corner-fs-btn := ButtonSurface {
                x: parent.width - self.width - 46px;
                y: 10px;
                width: 30px;
                height: 30px;
                border-radius: 15px;
                visible: root.has-trailer;
                background: self.has-hover ? #ffffff35 : #0000008c;
                accessible-name: @tr("Watch trailer in full player");
                clicked => { root.maximize-trailer(); }

                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 14px;
                    height: 14px;
                    source: @image-url("../assets/images/icons/maximize.svg");
                    colorize: #ffffff;
                    image-fit: contain;
                }
            }

            // Botón superior derecho exclusivo para cerrar el Drawer
            close-drawer-btn := ButtonSurface {
                x: parent.width - self.width - 10px;
                y: 10px;
                width: 30px;
                height: 30px;
                border-radius: 15px;
                background: self.has-hover ? #ffffff2b : #0000008c;
                accessible-name: @tr("Close preview");
                clicked => { root.close-drawer(); }

                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 14px;
                    height: 14px;
                    source: @image-url("../assets/images/icons/close.svg");
                    colorize: #ffffff;
                    image-fit: contain;
                }
            }

            drawer-bottom-touch := TouchArea {
                x: 0px;
                y: parent.height - 52px;
                width: parent.width;
                height: 52px;
                z: 10;
                moved => {
                    video-container.idle-ticks = 0;
                }
                pointer-event(event) => {
                    video-container.idle-ticks = 0;
                }
            }

            Rectangle {
                x: 0px;
                y: parent.height - self.height;
                width: parent.width;
                height: 52px;
                z: 11;
                visible: root.has-trailer;
                opacity: video-container.show-chrome ? 1.0 : 0.0;
                animate opacity { duration: 140ms; easing: ease-out; }
                background: #000000a6;

                // 1. Scrubber rojo de ancho completo arriba de los botones
                scrubber-box := Rectangle {
                    x: 12px;
                    y: 6px;
                    width: parent.width - 24px;
                    height: 12px;
                    background: transparent;

                    property <length> rail-h: drawer-scrubber-touch.has-hover || drawer-scrubber-touch.pressed ? 6px : 4px;

                    Rectangle {
                        x: 0px;
                        y: (parent.height - parent.rail-h) / 2;
                        width: parent.width;
                        height: parent.rail-h;
                        border-radius: self.height / 2;
                        background: #ffffff38;
                    }

                    Rectangle {
                        x: 0px;
                        y: (parent.height - parent.rail-h) / 2;
                        width: parent.width * Math.max(0.0, Math.min(1.0, root.video-progress));
                        height: parent.rail-h;
                        border-radius: self.height / 2;
                        background: #ff0000;
                    }

                    Rectangle {
                        property <length> d: drawer-scrubber-touch.has-hover || drawer-scrubber-touch.pressed ? 13px : 10px;
                        x: max(0px, min(parent.width - self.d, parent.width * Math.max(0.0, Math.min(1.0, root.video-progress)) - self.d / 2));
                        y: (parent.height - self.d) / 2;
                        width: self.d;
                        height: self.d;
                        border-radius: self.d / 2;
                        background: #ff0000;
                    }

                    drawer-scrubber-touch := TouchArea {
                        width: parent.width;
                        height: 16px;
                        y: -2px;
                        mouse-cursor: MouseCursor.pointer;
                        pointer-event(event) => {
                            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                if (scrubber-box.width > 0px) {
                                    root.seek-video-progress(Math.max(0.0, Math.min(1.0, self.mouse-x / scrubber-box.width)));
                                }
                            }
                        }
                        moved => {
                            if (self.pressed && scrubber-box.width > 0px) {
                                root.seek-video-progress(Math.max(0.0, Math.min(1.0, self.mouse-x / scrubber-box.width)));
                            }
                        }
                    }
                }

                // 2. Fila inferior de controles estilo Tube Oxide:
                // Izquierda: [Play/Pause] [Mute/Vol] [Vol Slider] [Tiempo] | Centro: Spacer | Derecha: [Speed "1x"] [Auto] [Fullscreen]
                HorizontalLayout {
                    x: 10px;
                    y: 20px;
                    width: parent.width - 20px;
                    height: 28px;
                    spacing: 4px;
                    alignment: start;

                    drawer-play-btn := ButtonSurface {
                        width: 30px;
                        height: 28px;
                        border-radius: 4px;
                        background: self.pressed ? #ffffff40 : (self.has-hover ? #ffffff29 : transparent);
                        accessible-name: root.video-playing ? @tr("Pause") : @tr("Play");
                        clicked => { root.toggle-trailer-playback(); }

                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 16px;
                            height: 16px;
                            source: root.video-playing
                                ? @image-url("../assets/images/icons/pause.svg")
                                : @image-url("../assets/images/icons/play.svg");
                            colorize: #f1f1f1;
                            image-fit: contain;
                        }
                    }

                    drawer-mute-btn := ButtonSurface {
                        width: 28px;
                        height: 28px;
                        border-radius: 4px;
                        background: self.pressed ? #ffffff40 : (self.has-hover ? #ffffff29 : transparent);
                        accessible-name: root.video-muted ? @tr("Unmute trailer") : @tr("Mute trailer");
                        clicked => { root.toggle-video-muted(); }

                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 16px;
                            height: 16px;
                            source: (root.video-muted || root.video-volume <= 0.01)
                                ? @image-url("../assets/images/icons/volume-mute.svg")
                                : (root.video-volume < 0.5
                                    ? @image-url("../assets/images/icons/volume-low.svg")
                                    : @image-url("../assets/images/icons/volume-high.svg"));
                            colorize: #f1f1f1;
                            image-fit: contain;
                        }
                    }

                    // Slider de volumen en línea Tube Oxide (0.0..=1.0, rojo #ff0000)
                    drawer-vol-box := Rectangle {
                        width: 52px;
                        height: 28px;
                        background: transparent;

                        Rectangle {
                            x: 0px;
                            y: (parent.height - self.height) / 2;
                            width: parent.width;
                            height: 4px;
                            border-radius: 2px;
                            background: #ffffff40;
                        }

                        Rectangle {
                            x: 0px;
                            y: (parent.height - self.height) / 2;
                            width: parent.width * video-container.effective-vol;
                            height: 4px;
                            border-radius: 2px;
                            background: #ff0000;
                        }

                        Rectangle {
                            property <length> d: drawer-vol-touch.has-hover || drawer-vol-touch.pressed ? 11px : 9px;
                            x: max(0px, min(parent.width - self.d, parent.width * video-container.effective-vol - self.d / 2));
                            y: (parent.height - self.d) / 2;
                            width: self.d;
                            height: self.d;
                            border-radius: self.d / 2;
                            background: #ff0000;
                        }

                        drawer-vol-touch := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            mouse-cursor: MouseCursor.pointer;
                            pointer-event(event) => {
                                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                    if (drawer-vol-box.width > 0px) {
                                        root.change-video-volume(Math.max(0.0, Math.min(1.0, self.mouse-x / drawer-vol-box.width)));
                                    }
                                }
                            }
                            moved => {
                                if (self.pressed && drawer-vol-box.width > 0px) {
                                    root.change-video-volume(Math.max(0.0, Math.min(1.0, self.mouse-x / drawer-vol-box.width)));
                                }
                            }
                        }
                    }

                    Text {
                        height: 28px;
                        text: root.video-time-label != "" ? root.video-time-label : "0:00 / 0:00";
                        color: #f1f1f1;
                        font-size: 12px;
                        font-weight: 500;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    drawer-speed-btn := ButtonSurface {
                        width: 34px;
                        height: 28px;
                        border-radius: 4px;
                        background: self.pressed ? #ffffff40 : (self.has-hover ? #ffffff29 : transparent);
                        accessible-name: "Velocidad " + video-container.speed-label;
                        clicked => {
                            if (Math.abs(root.video-speed - 1.0) < 0.05) {
                                root.change-video-speed(1.25);
                            } else if (Math.abs(root.video-speed - 1.25) < 0.05) {
                                root.change-video-speed(1.5);
                            } else if (Math.abs(root.video-speed - 1.5) < 0.05) {
                                root.change-video-speed(2.0);
                            } else if (Math.abs(root.video-speed - 2.0) < 0.05) {
                                root.change-video-speed(0.5);
                            } else {
                                root.change-video-speed(1.0);
                            }
                        }

                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: video-container.speed-label;
                            color: #f1f1f1;
                            font-size: 12px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    drawer-auto-btn := ButtonSurface {
                        height: 28px;
                        border-radius: 4px;
                        background: self.pressed ? #ffffff40 : (self.has-hover ? #ffffff29 : transparent);
                        accessible-name: "Autoplay";
                        clicked => { root.toggle-autoplay(); }

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            alignment: center;
                            Text {
                                text: root.autoplay-enabled ? "Auto: ON" : "Auto";
                                color: root.autoplay-enabled ? #ff4d4d : #f1f1f1;
                                font-size: 11.5px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }

                    drawer-fs-btn := ButtonSurface {
                        width: 28px;
                        height: 28px;
                        border-radius: 4px;
                        background: self.pressed ? #ffffff40 : (self.has-hover ? #ffffff29 : transparent);
                        accessible-name: @tr("Watch trailer in full player");
                        clicked => { root.maximize-trailer(); }

                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 16px;
                            height: 16px;
                            source: @image-url("../assets/images/icons/maximize.svg");
                            colorize: #f1f1f1;
                            image-fit: contain;
                        }
                    }
                }
            }
        }

        // =====================================================================
        // 2. CONTENIDO DESPLAZABLE INTERNO (Cero Saltos Estructurales)
        // =====================================================================
        ScrollView {
            vertical-stretch: 1;
            viewport-width: root.drawer-width;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

            VerticalLayout {
                padding-left: 2 * root.unit;
                padding-right: 2 * root.unit;
                padding-top: 1.5 * root.unit;
                padding-bottom: 1.5 * root.unit;
                spacing: 1.2 * root.unit;

                // Título o Logo (Altura fija para 0 CLS)
                Rectangle {
                    height: root.header-height;
                    background: transparent;

                    if (root.logo.width > 0) : Image {
                        width: parent.width;
                        height: parent.height;
                        source: root.logo;
                        image-fit: contain;
                        horizontal-alignment: left;
                    }

                    if (root.logo.width == 0) : Text {
                        width: parent.width;
                        height: parent.height;
                        text: root.title;
                        color: Theme.text-primary;
                        font-size: 1.6 * root.unit;
                        font-weight: 700;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                }

                // Fila de Metadatos Básicos (Runtime / Año) con altura fija obligatoria
                meta-row := Rectangle {
                    height: root.meta-row-height;
                    background: transparent;

                    HorizontalLayout {
                        spacing: 1.5 * root.unit;
                        alignment: start;
                        if (root.runtime != "") : Text {
                            text: root.runtime;
                            color: Theme.text-primary;
                            font-size: 0.95 * root.unit;
                            font-weight: 600;
                            opacity: 0.85;
                        }
                        if (root.year != "") : Text {
                            text: root.year;
                            color: Theme.text-secondary;
                            font-size: 0.95 * root.unit;
                        }
                    }
                }

                // =============================================================
                // 3. TRÍADA DE CALIFICACIONES (IMDb, Rotten Tomatoes, Metacritic)
                // =============================================================
                ratings-container := Rectangle {
                    height: root.ratings-height;
                    background: transparent;

                    HorizontalLayout {
                        spacing: 1.2 * root.unit;
                        alignment: start;

                        // IMDb
                        if (root.rating-imdb != "") : HorizontalLayout {
                            spacing: 0.4 * root.unit;
                            Image {
                                width: 2.2 * root.unit;
                                height: 1.2 * root.unit;
                                y: (parent.height - self.height) / 2;
                                source: @image-url("../assets/images/icons/imdb.svg");
                                colorize: Theme.imdb;
                                image-fit: contain;
                            }
                            Text {
                                text: root.rating-imdb;
                                color: Theme.text-primary;
                                font-size: 0.95 * root.unit;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }

                        // Rotten Tomatoes (con Skeleton mientras carga)
                        if (root.rating-rt != "") : HorizontalLayout {
                            spacing: 0.4 * root.unit;
                            Image {
                                width: 1.2 * root.unit;
                                height: 1.2 * root.unit;
                                y: (parent.height - self.height) / 2;
                                source: @image-url("../assets/images/icons/rotten-tomatoes.svg");
                                image-fit: contain;
                            }
                            Text {
                                text: root.rating-rt;
                                color: Theme.text-primary;
                                font-size: 0.95 * root.unit;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                        if (root.ratings-loading && root.rating-rt == "") : HorizontalLayout {
                            spacing: 0.4 * root.unit;
                            Rectangle {
                                width: 1.2 * root.unit;
                                height: 1.2 * root.unit;
                                y: (parent.height - self.height) / 2;
                                border-radius: 0.2 * root.unit;
                                background: Theme.card-border;
                            }
                            Rectangle {
                                width: 2.2 * root.unit;
                                height: 0.8 * root.unit;
                                y: (parent.height - self.height) / 2;
                                border-radius: 0.2 * root.unit;
                                background: Theme.card-border;
                            }
                        }

                        // Metacritic ("M") (con Skeleton mientras carga)
                        if (root.rating-metacritic != "") : HorizontalLayout {
                            spacing: 0.4 * root.unit;
                            Image {
                                width: 1.2 * root.unit;
                                height: 1.2 * root.unit;
                                y: (parent.height - self.height) / 2;
                                source: @image-url("../assets/images/icons/metacritic.svg");
                                colorize: Theme.metacritic;
                                image-fit: contain;
                            }
                            Text {
                                text: root.rating-metacritic;
                                color: Theme.text-primary;
                                font-size: 0.95 * root.unit;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                        if (root.ratings-loading && root.rating-metacritic == "") : HorizontalLayout {
                            spacing: 0.4 * root.unit;
                            Rectangle {
                                width: 1.2 * root.unit;
                                height: 1.2 * root.unit;
                                y: (parent.height - self.height) / 2;
                                border-radius: 0.2 * root.unit;
                                background: Theme.card-border;
                            }
                            Rectangle {
                                width: 1.8 * root.unit;
                                height: 0.8 * root.unit;
                                y: (parent.height - self.height) / 2;
                                border-radius: 0.2 * root.unit;
                                background: Theme.card-border;
                            }
                        }
                    }
                }

                // Sinopsis
                Text {
                    text: root.description;
                    color: Theme.text-muted;
                    font-size: 0.9 * root.unit;
                    wrap: word-wrap;
                }

                // Géneros
                if (root.genres.length > 0) : MetaStringLinks {
                    unit: root.unit;
                    label: @tr("LINKS_GENRES" => "Genres");
                    values: root.genres;
                    link-selected(value) => { root.metadata-filter-selected(value); }
                }

                // Cast y Directores
                if (root.cast.length > 0) : MetaStringLinks {
                    unit: root.unit;
                    label: @tr("CAST" => "Cast");
                    values: root.cast;
                    link-selected(value) => { root.metadata-filter-selected(value); }
                }
            }
        }

        // =====================================================================
        // 4. BARRA INFERIOR DE ACCIONES FIJAS
        // =====================================================================
        Rectangle {
            height: root.actions-height;
            background: Theme.modal-background;

            HorizontalLayout {
                padding: 1 * root.unit;
                spacing: 0.75 * root.unit;
                alignment: center;

                // Añadir / Quitar de Biblioteca
                IconAction {
                    width: 3.5 * root.unit;
                    height: 3.5 * root.unit;
                    unit: root.unit;
                    icon-size: 1.5 * root.unit;
                    surface-color: Theme.overlay;
                    active: root.in-library;
                    active-color: Theme.accent;
                    icon-source: root.in-library
                        ? @image-url("../assets/images/icons/checkmark.svg")
                        : @image-url("../assets/images/icons/add-to-library.svg");
                    clicked => { root.toggle-library(); }
                }

                // Marcar Visto / No Visto
                IconAction {
                    width: 3.5 * root.unit;
                    height: 3.5 * root.unit;
                    unit: root.unit;
                    icon-size: 1.5 * root.unit;
                    surface-color: Theme.overlay;
                    active: root.is-watched;
                    active-color: Theme.accent;
                    icon-source: root.is-watched
                        ? @image-url("../assets/images/icons/eye-off.svg")
                        : @image-url("../assets/images/icons/eye.svg");
                    clicked => { root.toggle-watched(); }
                }

                // Botón SHOW / Ver Completo (Navega a Details)
                PillButton {
                    horizontal-stretch: 1;
                    height: 3.5 * root.unit;
                    unit: root.unit;
                    label: @tr("SHOW" => "Show");
                    primary: true;
                    clicked => { root.play-full-details(); }
                }
            }
        }
    }
}
