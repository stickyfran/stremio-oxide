import { Theme } from "../theme.slint";
import { ButtonSurface, PillButton, IconAction } from "button.slint";
import { Chip } from "chip.slint";

// Floating hover card shown above a catalog poster once the hover threshold in
// MediaCard elapses. The video frame is pushed in from the preview MPV worker;
// everything else is projected metadata for the hovered item.
export component TrailerHoverPopup inherits Rectangle {
    in property <length> unit: Theme.root-font-size;
    in property <bool> active: false;

    // Preview stream state.
    in property <image> frame;
    in property <bool> has-frame: false;
    in property <bool> loading: false;
    in property <bool> playing: true;
    in property <bool> muted: true;
    in property <float> volume: 0.75;
    in property <float> speed: 1.0;
    in property <float> progress: 0.0;
    in property <string> time-label: "";
    in property <string> status: "";

    // Item metadata.
    in property <image> poster;
    in property <string> title: "";
    in property <string> year: "";
    in property <string> runtime: "";
    in property <string> rating: "";
    in property <string> description: "";
    in property <[string]> genres: [];
    in property <bool> in-library: false;

    // Anchor geometry of the hovered card, in window coordinates.
    in property <length> anchor-x: 0px;
    in property <length> anchor-y: 0px;
    in property <length> anchor-width: 0px;
    in property <length> anchor-height: 0px;

    callback toggle-playback();
    callback toggle-muted();
    callback change-volume(float);
    callback change-speed(float);
    callback maximize-requested();
    callback play-requested();
    callback toggle-library-requested();
    callback seek-relative(float);
    callback seek-progress(float);
    callback pointer-entered();
    callback pointer-left();

    private property <int> pulse-tick: 0;
    property <length> popup-width: min(26 * root.unit, max(20 * root.unit, root.width * 0.30));
    property <length> video-height: root.popup-width * 9 / 16;
    property <length> info-height: 11.5 * root.unit;
    property <length> popup-height: root.video-height + root.info-height;
    // Centre on the card, then keep the whole card inside the viewport so the
    // first and last column of a grid stay fully readable.
    property <length> desired-x: root.anchor-x + (root.anchor-width - root.popup-width) / 2;
    property <length> desired-y: root.anchor-y + (root.anchor-height - root.popup-height) / 2;
    property <length> popup-x: max(root.unit,
        min(root.width - root.popup-width - root.unit, root.desired-x));
    property <length> popup-y: max(root.unit,
        min(root.height - root.popup-height - root.unit, root.desired-y));

    background: transparent;
    // Kept mounted through the fade-out so dismissal does not pop.
    visible: root.active || card.opacity > 0.01;

    card := Rectangle {
        x: root.popup-x;
        y: root.popup-y;
        width: root.popup-width;
        height: root.popup-height;
        background: Theme.modal-background;
        border-radius: Theme.border-radius;
        border-width: 1px;
        border-color: Theme.card-border;
        drop-shadow-blur: 2 * root.unit;
        drop-shadow-color: Theme.background-dark-40;
        opacity: root.active ? 1 : 0;
        clip: true;

        animate opacity { duration: Theme.motion-control; easing: ease-out; }

        hover-area := TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.play-requested(); }
            scroll-event(event) => {
                if (event.delta-y > 0px) {
                    root.seek-relative(5.0);
                } else if (event.delta-y < 0px) {
                    root.seek-relative(-5.0);
                }
                accept
            }
        }

        // The popup covers the card that opened it, so it has to take over the
        // hover contract or the preview would tear down on entry. Nested
        // controls own the pointer while hovered, so the contract is derived
        // from all of them at once: reacting to the individual `has-hover`
        // edges would depend on the order Slint delivers enter and leave in.
        private property <float> effective-vol: root.muted ? 0.0 : Math.max(0.0, Math.min(1.0, root.volume));
        private property <string> speed-label:
            Math.abs(root.speed - 0.5) < 0.05 ? "0.5x" :
            Math.abs(root.speed - 0.75) < 0.05 ? "0.75x" :
            Math.abs(root.speed - 1.25) < 0.05 ? "1.25x" :
            Math.abs(root.speed - 1.5) < 0.05 ? "1.5x" :
            Math.abs(root.speed - 2.0) < 0.05 ? "2x" : "1x";

        private property <bool> pointer-inside: hover-area.has-hover
            || corner-fs-btn.has-hover
            || popup-scrubber-touch.has-hover
            || popup-scrubber-touch.pressed
            || popup-play-button.has-hover
            || mute-button.has-hover
            || popup-vol-touch.has-hover
            || popup-vol-touch.pressed
            || popup-speed-button.has-hover
            || fs-button.has-hover
            || play-button.has-hover
            || library-button.has-hover;
        changed pointer-inside => {
            if (self.pointer-inside) {
                root.pointer-entered();
            } else {
                root.pointer-left();
            }
        }

        VerticalLayout {
            spacing: 0px;
            padding: 0px;

            video := Rectangle {
                height: root.video-height;
                background: #000000;
                clip: true;

                if (root.poster.width > 0) : Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.poster;
                    image-fit: cover;
                    opacity: root.has-frame ? 0 : 0.45;
                    animate opacity { duration: Theme.motion-control; }
                }

                if (root.has-frame) : Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.frame;
                    image-fit: contain;
                }

                // Esquina derecha: Maximizar trailer
                corner-fs-btn := ButtonSurface {
                    x: parent.width - self.width - 8px;
                    y: 8px;
                    width: 28px;
                    height: 28px;
                    border-radius: 14px;
                    background: self.has-hover ? #ffffff35 : #0000008c;
                    accessible-name: @tr("Watch trailer in full player");
                    clicked => { root.maximize-requested(); }

                    Image {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 14px;
                        height: 14px;
                        source: @image-url("../assets/images/icons/maximize.svg");
                        colorize: #ffffff;
                        image-fit: contain;
                    }
                }

                // Buffering / unavailable indicator.
                if (!root.has-frame) : Rectangle {
                    width: parent.width;
                    height: parent.height;
                    background: Theme.background-dark-40;

                    VerticalLayout {
                        alignment: center;
                        spacing: 0.75 * root.unit;

                        Rectangle {
                            height: 2 * root.unit;
                            background: transparent;

                            HorizontalLayout {
                                alignment: center;
                                spacing: 0.5 * root.unit;

                                for index in 3 : Rectangle {
                                    width: 0.6 * root.unit;
                                    height: 0.6 * root.unit;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: self.width / 2;
                                    background: #ff0000;
                                    opacity: root.loading
                                        ? (root.pulse-tick == index ? 0.95 : 0.25)
                                        : 0;
                                    animate opacity { duration: Theme.motion-control; }
                                }
                            }
                        }

                        Text {
                            text: root.loading
                                ? @tr("TRAILER_PREVIEW_LOADING" => "Loading preview…")
                                : root.status;
                            color: Theme.text-secondary;
                            font-size: 0.85 * root.unit;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                            overflow: elide;
                        }
                    }
                }

                // Tube Oxide `view_control_bar` on hover preview
                Rectangle {
                    x: 0px;
                    y: parent.height - self.height;
                    width: parent.width;
                    height: 48px;
                    background: #000000a6;

                    popup-scrubber := Rectangle {
                        x: 10px;
                        y: 5px;
                        width: parent.width - 20px;
                        height: 12px;
                        background: transparent;

                        property <length> rail-h: popup-scrubber-touch.has-hover || popup-scrubber-touch.pressed ? 5px : 4px;

                        Rectangle {
                            x: 0px;
                            y: (parent.height - parent.rail-h) / 2;
                            width: parent.width;
                            height: parent.rail-h;
                            border-radius: self.height / 2;
                            background: #ffffff38;
                        }

                        Rectangle {
                            x: 0px;
                            y: (parent.height - parent.rail-h) / 2;
                            width: parent.width * Math.max(0.0, Math.min(1.0, root.progress));
                            height: parent.rail-h;
                            border-radius: self.height / 2;
                            background: #ff0000;
                        }

                        Rectangle {
                            property <length> d: popup-scrubber-touch.has-hover || popup-scrubber-touch.pressed ? 12px : 9px;
                            x: max(0px, min(parent.width - self.d, parent.width * Math.max(0.0, Math.min(1.0, root.progress)) - self.d / 2));
                            y: (parent.height - self.d) / 2;
                            width: self.d;
                            height: self.d;
                            border-radius: self.d / 2;
                            background: #ff0000;
                        }

                        popup-scrubber-touch := TouchArea {
                            width: parent.width;
                            height: 14px;
                            y: -1px;
                            mouse-cursor: MouseCursor.pointer;
                            pointer-event(event) => {
                                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                    if (popup-scrubber.width > 0px) {
                                        root.seek-progress(Math.max(0.0, Math.min(1.0, self.mouse-x / popup-scrubber.width)));
                                    }
                                }
                            }
                            moved => {
                                if (self.pressed && popup-scrubber.width > 0px) {
                                    root.seek-progress(Math.max(0.0, Math.min(1.0, self.mouse-x / popup-scrubber.width)));
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        x: 8px;
                        y: 18px;
                        width: parent.width - 16px;
                        height: 26px;
                        spacing: 4px;
                        alignment: start;

                        popup-play-button := ButtonSurface {
                            width: 26px;
                            height: 26px;
                            border-radius: 4px;
                            background: self.pressed ? #ffffff40 : (self.has-hover ? #ffffff29 : transparent);
                            accessible-name: root.playing ? @tr("Pause") : @tr("Play");
                            clicked => { root.toggle-playback(); }

                            Image {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: 15px;
                                height: 15px;
                                source: root.playing
                                    ? @image-url("../assets/images/icons/pause.svg")
                                    : @image-url("../assets/images/icons/play.svg");
                                colorize: #f1f1f1;
                                image-fit: contain;
                            }
                        }

                        mute-button := ButtonSurface {
                            width: 26px;
                            height: 26px;
                            border-radius: 4px;
                            background: self.pressed ? #ffffff40 : (self.has-hover ? #ffffff29 : transparent);
                            accessible-name: root.muted
                                ? @tr("TRAILER_PREVIEW_UNMUTE" => "Unmute preview")
                                : @tr("TRAILER_PREVIEW_MUTE" => "Mute preview");
                            clicked => { root.toggle-muted(); }

                            Image {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: 15px;
                                height: 15px;
                                source: (root.muted || root.volume <= 0.01)
                                    ? @image-url("../assets/images/icons/volume-mute.svg")
                                    : (root.volume < 0.5
                                        ? @image-url("../assets/images/icons/volume-low.svg")
                                        : @image-url("../assets/images/icons/volume-high.svg"));
                                colorize: #f1f1f1;
                                image-fit: contain;
                            }
                        }

                        popup-vol-box := Rectangle {
                            width: 48px;
                            height: 26px;
                            background: transparent;

                            Rectangle {
                                x: 0px;
                                y: (parent.height - self.height) / 2;
                                width: parent.width;
                                height: 4px;
                                border-radius: 2px;
                                background: #ffffff40;
                            }

                            Rectangle {
                                x: 0px;
                                y: (parent.height - self.height) / 2;
                                width: parent.width * card.effective-vol;
                                height: 4px;
                                border-radius: 2px;
                                background: #ff0000;
                            }

                            Rectangle {
                                property <length> d: popup-vol-touch.has-hover || popup-vol-touch.pressed ? 11px : 9px;
                                x: max(0px, min(parent.width - self.d, parent.width * card.effective-vol - self.d / 2));
                                y: (parent.height - self.d) / 2;
                                width: self.d;
                                height: self.d;
                                border-radius: self.d / 2;
                                background: #ff0000;
                            }

                            popup-vol-touch := TouchArea {
                                width: parent.width;
                                height: parent.height;
                                mouse-cursor: MouseCursor.pointer;
                                pointer-event(event) => {
                                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                        if (popup-vol-box.width > 0px) {
                                            root.change-volume(Math.max(0.0, Math.min(1.0, self.mouse-x / popup-vol-box.width)));
                                        }
                                    }
                                }
                                moved => {
                                    if (self.pressed && popup-vol-box.width > 0px) {
                                        root.change-volume(Math.max(0.0, Math.min(1.0, self.mouse-x / popup-vol-box.width)));
                                    }
                                }
                            }
                        }

                        Text {
                            height: 26px;
                            text: root.time-label != "" ? root.time-label : "0:00 / 0:00";
                            color: #f1f1f1;
                            font-size: 11.5px;
                            font-weight: 500;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        popup-speed-button := ButtonSurface {
                            width: 32px;
                            height: 26px;
                            border-radius: 4px;
                            background: self.pressed ? #ffffff40 : (self.has-hover ? #ffffff29 : transparent);
                            accessible-name: "Velocidad " + card.speed-label;
                            clicked => {
                                if (Math.abs(root.speed - 1.0) < 0.05) {
                                    root.change-speed(1.25);
                                } else if (Math.abs(root.speed - 1.25) < 0.05) {
                                    root.change-speed(1.5);
                                } else if (Math.abs(root.speed - 1.5) < 0.05) {
                                    root.change-speed(2.0);
                                } else if (Math.abs(root.speed - 2.0) < 0.05) {
                                    root.change-speed(0.5);
                                } else {
                                    root.change-speed(1.0);
                                }
                            }

                            Text {
                                width: parent.width;
                                height: parent.height;
                                text: card.speed-label;
                                color: #f1f1f1;
                                font-size: 11.5px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        fs-button := ButtonSurface {
                            width: 26px;
                            height: 26px;
                            border-radius: 4px;
                            background: self.pressed ? #ffffff40 : (self.has-hover ? #ffffff29 : transparent);
                            accessible-name: @tr("Watch trailer in full player");
                            clicked => { root.maximize-requested(); }

                            Image {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: 15px;
                                height: 15px;
                                source: @image-url("../assets/images/icons/maximize.svg");
                                colorize: #f1f1f1;
                                image-fit: contain;
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: root.info-height;
                background: transparent;

                VerticalLayout {
                    padding-left: 1.25 * root.unit;
                    padding-right: 1.25 * root.unit;
                    padding-top: 0.9 * root.unit;
                    padding-bottom: 0.9 * root.unit;
                    spacing: 0.5 * root.unit;

                    Text {
                        text: root.title;
                        color: Theme.primary-foreground;
                        font-size: 1.15 * root.unit;
                        font-weight: 700;
                        overflow: elide;
                    }

                    HorizontalLayout {
                        spacing: 0.75 * root.unit;
                        alignment: start;

                        if (root.year != "") : Text {
                            text: root.year;
                            color: Theme.text-secondary;
                            font-size: 0.9 * root.unit;
                            vertical-alignment: center;
                        }
                        if (root.runtime != "") : Text {
                            text: root.runtime;
                            color: Theme.text-secondary;
                            font-size: 0.9 * root.unit;
                            vertical-alignment: center;
                        }
                        if (root.rating != "") : HorizontalLayout {
                            spacing: 0.25 * root.unit;

                            Image {
                                width: 0.9 * root.unit;
                                height: 0.9 * root.unit;
                                y: (parent.height - self.height) / 2;
                                source: @image-url("../assets/images/icons/imdb.svg");
                                colorize: Theme.imdb;
                                image-fit: contain;
                            }
                            Text {
                                text: root.rating;
                                color: Theme.text-secondary;
                                font-size: 0.9 * root.unit;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if (root.genres.length > 0) : HorizontalLayout {
                        height: 1.75 * root.unit;
                        spacing: 0.4 * root.unit;
                        alignment: start;

                        for genre in root.genres : Chip {
                            unit: 0.75 * root.unit;
                            height: parent.height;
                            label: genre;
                        }
                    }

                    Text {
                        vertical-stretch: 1;
                        text: root.description;
                        color: Theme.text-muted;
                        font-size: 0.9 * root.unit;
                        wrap: word-wrap;
                        overflow: elide;
                    }

                    HorizontalLayout {
                        height: 2.75 * root.unit;
                        spacing: 0.5 * root.unit;
                        alignment: start;

                        play-button := PillButton {
                            unit: root.unit;
                            height: parent.height;
                            width: 9 * root.unit;
                            primary: true;
                            show-icon: true;
                            icon-source: @image-url("../assets/images/icons/play.svg");
                            icon-size: 1.1 * root.unit;
                            label-font-size: 0.95 * root.unit;
                            label: @tr("TRAILER_PREVIEW_PLAY_FULL" => "Play Full");
                            clicked => { root.play-requested(); }
                        }

                        library-button := PillButton {
                            unit: root.unit;
                            height: parent.height;
                            width: 10.5 * root.unit;
                            show-icon: true;
                            icon-size: 1.1 * root.unit;
                            label-font-size: 0.95 * root.unit;
                            icon-source: root.in-library
                                ? @image-url("../assets/images/icons/checkmark.svg")
                                : @image-url("../assets/images/icons/add-to-library.svg");
                            label: root.in-library
                                ? @tr("TRAILER_PREVIEW_IN_LIBRARY" => "In Library")
                                : @tr("TRAILER_PREVIEW_ADD_LIBRARY" => "Add to Library");
                            clicked => { root.toggle-library-requested(); }
                        }
                    }
                }
            }
        }
    }

    pulse := Timer {
        interval: 350ms;
        running: root.active && root.loading && !root.has-frame;
        triggered => { root.pulse-tick = Math.mod(root.pulse-tick + 1, 3); }
    }
}
