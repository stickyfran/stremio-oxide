import { ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { MediaCardItem } from "../components/media_card.slint";
import { MediaCardGridRow, MediaGridPlaceholder } from "../components/media_carousel.slint";
import { EmptyState } from "../components/feedback.slint";
import { SelectField } from "../components/select.slint";
import { ButtonSurface, PillButton, IconAction } from "../components/button.slint";
import { NativeTextField } from "../components/text_input.slint";
import { MediaPreviewDrawer } from "../components/preview_drawer.slint";

export struct LibraryRow {
    cols: [MediaCardItem],
}

export component LibraryPage inherits Rectangle {
    width: 1280px;
    height: 720px;
    in property <[LibraryRow]> rows: [];
    in property <[LibraryRow]> local-rows: [];
    in property <int> column-count: 6;
    in property <bool> loading: false;
    in property <bool> has-next-page: false;
    in property <bool> authenticated: false;
    in property <bool> continue-watching-mode: false;
    in-out property <string> active-type: "All";
    in-out property <string> active-sort: "Last Watched";
    in-out property <string> local-root-path: "";
    in property <string> local-scan-status: "";
    private property <bool> local-mode: root.active-type == "Local";
    private property <[LibraryRow]> visible-rows: root.local-mode ? root.local-rows : root.rows;

    in property <bool> enable-hover-preview: false;
    in property <duration> hover-preview-delay: 1200ms;

    in-out property <bool> preview-enabled: true;
    in property <bool> has-preview: false;
    in property <string> preview-title: "";
    in property <image> preview-logo;
    in property <string> preview-description: "";
    in property <string> preview-rating: "";
    in property <string> preview-year: "";
    in property <string> preview-runtime: "";
    in property <[string]> preview-genres: [];
    in property <[string]> preview-cast: [];
    in property <[string]> preview-directors: [];
    in property <image> preview-poster;
    in property <bool> preview-is-in-library: true;
    in property <bool> preview-is-watched: false;
    in property <bool> preview-has-trailer: false;
    in property <string> preview-trailer-selection-id: "";
    in property <string> preview-rt-rating: "";
    in property <string> preview-metacritic-rating: "";
    in property <bool> preview-ratings-loading: false;
    in property <image> preview-video-frame;
    in property <bool> preview-has-video-frame: false;
    in property <bool> preview-video-loading: false;
    in property <bool> preview-video-playing: false;
    in property <bool> preview-video-muted: true;
    in property <bool> preview-autoplay-enabled: false;
    in-out property <float> preview-video-progress: 0.0;
    in property <string> preview-video-time-label: "";

    callback toggle-preview-enabled();
    callback play-preview;
    callback toggle-library-preview;
    callback toggle-watched-preview;
    callback play-trailer-preview(string);
    callback toggle-trailer-playback;
    callback toggle-video-muted;
    callback toggle-autoplay;
    callback maximize-trailer;
    callback seek-video-relative(float);
    callback seek-video-progress(float);
    callback close-preview-drawer;
    callback metadata-filter-selected(string);

    callback hover-preview-requested(string, string, length, length, length, length);
    callback hover-preview-dismissed();
    callback type-changed(string);
    callback sort-changed(string);
    callback item-selected(string, string, string);
    callback load-next-page;
    callback poster-requested(string);
    callback request-login;
    callback remove-item(string);
    callback watched-changed(string, bool);
    callback play-item(string);
    callback dismiss-item(string);
    callback local-add-root(string);
    callback local-rescan;
    callback local-play(string);
    in-out property <length> scroll-y: 0px;
    function reset-scroll() {
        root.scroll-y = 0px;
    }

    private property <bool> pagination-latched: false;
    private property <int> pagination-content-length: root.rows.length;
    changed pagination-content-length => { root.pagination-latched = false; }
    changed has-next-page => {
        if (root.has-next-page) {
            root.pagination-latched = false;
        }
    }
    function request-next-page() {
        if (!root.local-mode && root.has-next-page && !root.pagination-latched) {
            root.pagination-latched = true;
            root.load-next-page();
        }
    }
    function check-pagination(remaining: length) {
        if (remaining <= 25 * root.unit) {
            root.request-next-page();
        } else {
            root.pagination-latched = false;
        }
    }

    in property <length> unit: Theme.root-font-size;
    in-out property <bool> type-open: false;
    in-out property <bool> sort-open: false;
    property <length> drawer-width: 29 * root.unit;
    property <length> effective-drawer-width: (!root.local-mode && root.preview-enabled && root.has-preview && root.preview-title != "") ? root.drawer-width : 0px;
    property <length> grid-width: root.width - root.effective-drawer-width - 3 * root.unit;
    property <length> card-width: root.column-count > 0
        ? (root.grid-width - (root.column-count - 1) * 0.5 * root.unit) / root.column-count
        : root.grid-width;
    property <length> card-height: (root.card-width - 2 * root.unit) * 1.464 + 6 * root.unit;

    background: transparent;

    HorizontalLayout {
        spacing: 0px;

        catalog := VerticalLayout {
            horizontal-stretch: 1;
            spacing: 0px;

            if (root.authenticated || root.local-mode) : Rectangle {
            height: 5.75 * root.unit;
            z: 1000;

            HorizontalLayout {
                padding: 1.5 * root.unit;
                spacing: 1.5 * root.unit;
                alignment: start;

                SelectField {
                    unit: root.unit;
                    field-width: 15 * root.unit;
                    value: root.active-type;
                    options: ["All", "Movies", "Series", "Others", "Local"];
                    open: root.type-open;
                    toggle => {
                        root.type-open = !root.type-open;
                        root.sort-open = false;
                    }
                    selected(value) => {
                        root.reset-scroll();
                        root.type-open = false;
                        root.active-type = value;
                        root.type-changed(value);
                    }
                }

                if (root.local-mode) : NativeTextField {
                    unit: root.unit;
                    horizontal-stretch: 1;
                    text <=> root.local-root-path;
                    placeholder-text: @tr("Folder path to add");
                    accepted => {
                        if (root.local-root-path != "") {
                            root.local-add-root(root.local-root-path);
                        }
                    }
                }

                if (root.local-mode) : PillButton {
                    width: 8 * root.unit;
                    unit: root.unit;
                    label: @tr("Add folder");
                    enabled: root.local-root-path != "";
                    clicked => { root.local-add-root(root.local-root-path); }
                }

                if (root.local-mode) : PillButton {
                    width: 7 * root.unit;
                    unit: root.unit;
                    label: @tr("Rescan");
                    outlined: true;
                    clicked => { root.local-rescan(); }
                }

                if (!root.local-mode) : HorizontalLayout {
                    spacing: 0.5 * root.unit;
                    for sort-label in ["Last Watched", "A–Z", "Z–A", "Most Watched", "Watched", "Not Watched"] : ButtonSurface {
                        height: 3.25 * root.unit;
                        min-width: 7 * root.unit;
                        border-radius: self.height / 2;
                        background: sort-label == root.active-sort
                            ? Theme.primary-accent
                            : (self.has-hover ? Theme.overlay-hover : Theme.overlay-color);
                        border-width: self.has-focus ? Theme.focus-outline-size : 0px;
                        border-color: Theme.surface-light;
                        accessible-name: sort-label;
                        clicked => {
                            root.reset-scroll();
                            root.active-sort = sort-label;
                            root.sort-changed(sort-label);
                        }
                        Text {
                            text: sort-label;
                            color: Theme.primary-foreground;
                            font-size: 0.9 * root.unit;
                            font-weight: sort-label == root.active-sort ? 700 : 500;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // Spacer que empuja a la extrema derecha
                Rectangle { horizontal-stretch: 1; }

                // Botón indicativo coherente a la derecha de todo
                ButtonSurface {
                    height: 3.25 * root.unit;
                    border-radius: self.height / 2;
                    background: root.preview-enabled
                        ? Theme.primary-accent
                        : (self.has-hover ? Theme.overlay-hover : Theme.overlay-color);
                    border-width: self.has-focus ? Theme.focus-outline-size : 0px;
                    border-color: Theme.surface-light;
                    accessible-name: root.preview-enabled ? @tr("Hide details panel") : @tr("Show details panel");
                    clicked => {
                        root.preview-enabled = !root.preview-enabled;
                        root.toggle-preview-enabled();
                    }

                    HorizontalLayout {
                        padding-left: 1.2 * root.unit;
                        padding-right: 1.2 * root.unit;
                        spacing: 0.6 * root.unit;
                        alignment: center;

                        Image {
                            width: 1.3 * root.unit;
                            height: 1.3 * root.unit;
                            source: @image-url("../assets/images/icons/details.svg");
                            colorize: Theme.primary-foreground;
                            vertical-alignment: center;
                        }

                        Text {
                            text: root.preview-enabled ? @tr("Hide Preview") : @tr("Show Preview");
                            color: Theme.primary-foreground;
                            font-size: 0.85 * root.unit;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        if (!root.authenticated && !root.local-mode) : VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            spacing: 1.5 * root.unit;
            Text {
                width: 100%;
                text: @tr("Library is only available for logged in users");
                color: Theme.text-primary;
                opacity: 0.55;
                font-size: 1.6 * root.unit;
                horizontal-alignment: center;
            }
            Image {
                x: (parent.width - self.width) / 2;
                width: 8 * root.unit;
                height: 6 * root.unit;
                source: @image-url("../assets/images/icons/cloud-library.svg");
                colorize: Theme.primary-foreground;
                opacity: 0.35;
                image-fit: contain;
            }
            HorizontalLayout {
                x: (parent.width - self.width) / 2;
                width: 36 * root.unit;
                height: 5 * root.unit;
                spacing: 3 * root.unit;
                HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: root.unit;
                    Image {
                        width: 3 * root.unit;
                        source: @image-url("../assets/images/icons/cloud-sync.svg");
                        colorize: Theme.primary-foreground;
                        opacity: 0.45;
                        image-fit: contain;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: @tr("Access your favorite movies and TV shows anytime, anywhere");
                        color: Theme.primary-foreground;
                        font-size: root.unit;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: root.unit;
                    Image {
                        width: 3 * root.unit;
                        source: @image-url("../assets/images/icons/person.svg");
                        colorize: Theme.primary-foreground;
                        opacity: 0.45;
                        image-fit: contain;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: @tr("Recommendations tailored to your viewing history");
                        color: Theme.primary-foreground;
                        font-size: root.unit;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                }
            }
            PillButton {
                x: (parent.width - self.width) / 2;
                width: 12 * root.unit;
                unit: root.unit;
                label: @tr("BUTTON_LOGIN" => "Log in");
                primary: true;
                clicked => { root.request-login(); }
            }
        }

        if (!root.local-mode && root.authenticated && root.loading) : MediaGridPlaceholder {
            vertical-stretch: 1;
            unit: root.unit;
            card-width: root.card-width;
            card-height: root.card-height;
        }

        if ((root.local-mode || root.authenticated) && !root.loading && root.visible-rows.length == 0) : EmptyState {
            vertical-stretch: 1;
            unit: root.unit;
            icon-source: root.continue-watching-mode
                ? @image-url("../assets/images/icons/play.svg")
                : @image-url("../assets/images/icons/library.svg");
            title: root.local-mode
                ? @tr("No local media found")
                : (root.continue-watching-mode
                ? @tr("BOARD_CONTINUE_WATCHING_EMPTY" => "Your Continue Watching list is empty")
                : @tr("MOBILE_EMPTY_LIBRARY" => "Your library is empty"));
            message: root.local-mode
                ? @tr("Add a managed folder or rescan your existing folders.")
                : (root.continue-watching-mode
                ? @tr("Start watching something and it will appear here.")
                : @tr("Add movies and series to find them here."));
        }

        if (root.local-mode && root.local-scan-status != "") : Text {
            height: 2 * root.unit;
            text: root.local-scan-status;
            color: Theme.text-secondary;
            font-size: 0.9 * root.unit;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        if ((root.local-mode || root.authenticated) && !root.loading && root.visible-rows.length > 0) : library-scroll := ListView {
            vertical-stretch: 1;
            viewport-width: parent.width;
            viewport-y <=> root.scroll-y;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            changed viewport-y => {
                root.check-pagination(self.viewport-height + self.viewport-y - self.height);
            }
            changed viewport-height => {
                root.check-pagination(self.viewport-height + self.viewport-y - self.height);
            }

            for row[row-index] in root.visible-rows : Rectangle {
                width: parent.width;
                height: root.card-height + 0.5 * root.unit;

                init => {
                    if (!root.local-mode && row-index == root.visible-rows.length - 1) {
                        root.request-next-page();
                    }
                }

                MediaCardGridRow {
                    x: 1.5 * root.unit;
                    width: root.grid-width;
                    height: root.card-height;
                    unit: root.unit;
                    items: row.cols;
                    card-width: root.card-width;
                    card-height: root.card-height;
                    spacing: 0.5 * root.unit;
                    library-context-menu: !root.local-mode;
                    continue-watching-context-menu: root.continue-watching-mode;
                    enable-hover-preview: root.enable-hover-preview && !root.local-mode;
                    hover-preview-delay: root.hover-preview-delay;
                    hover-preview-requested(id, media-type, x, y, width, height) => {
                        root.hover-preview-requested(id, media-type, x, y, width, height);
                    }
                    hover-preview-dismissed => { root.hover-preview-dismissed(); }
                    item-selected(id, media-type, video-id) => {
                        if (root.local-mode) {
                            root.local-play(id);
                        } else {
                            root.item-selected(id, media-type, video-id);
                        }
                    }
                    poster-requested(url) => { root.poster-requested(url); }
                    watched-change-requested(id, watched) => {
                        root.watched-changed(id, watched);
                    }
                    library-remove-requested(id) => { root.remove-item(id); }
                    play-clicked(id) => {
                        if (root.local-mode) { root.local-play(id); }
                        else { root.play-item(id); }
                    }
                    dismiss-requested(id) => { root.dismiss-item(id); }
                }
            }
        }

        if (!root.local-mode && root.pagination-latched && root.has-next-page) : Rectangle {
            height: 3 * root.unit;
            background: transparent;

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 8.5 * root.unit;
                height: 2.2 * root.unit;
                background: Theme.background.with-alpha(0.85);
                border-radius: self.height / 2;
                border-width: 1px;
                border-color: Theme.divider;

                HorizontalLayout {
                    alignment: center;
                    spacing: 0.6 * root.unit;
                    padding-left: root.unit;
                    padding-right: root.unit;

                    Image {
                        width: 1.1 * root.unit;
                        height: 1.1 * root.unit;
                        source: @image-url("../assets/images/icons/hourglass.svg");
                        colorize: Theme.primary-accent;
                        image-fit: contain;
                    }
                    Text {
                        text: @tr("Loading...");
                        color: Theme.text-primary;
                        font-size: 0.85 * root.unit;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    if (!root.local-mode) : MediaPreviewDrawer {
        unit: root.unit;
        drawer-width: root.drawer-width;
        is-open: root.preview-enabled && root.has-preview && root.preview-title != "";
        title: root.preview-title;
        logo: root.preview-logo;
        poster: root.preview-poster;
        description: root.preview-description;
        year: root.preview-year;
        runtime: root.preview-runtime;
        genres: root.preview-genres;
        cast: root.preview-cast;
        directors: root.preview-directors;
        rating-imdb: root.preview-rating;
        rating-rt: root.preview-rt-rating;
        rating-metacritic: root.preview-metacritic-rating;
        ratings-loading: root.preview-ratings-loading;
        video-frame: root.preview-video-frame;
        has-video-frame: root.preview-has-video-frame;
        video-loading: root.preview-video-loading;
        video-playing: root.preview-video-playing;
        video-muted: root.preview-video-muted;
        has-trailer: root.preview-has-trailer;
        autoplay-enabled: root.preview-autoplay-enabled;
        video-progress <=> root.preview-video-progress;
        video-time-label: root.preview-video-time-label;
        in-library: root.preview-is-in-library;
        is-watched: root.preview-is-watched;

        play-full-details => { root.play-preview(); }
        toggle-library => { root.toggle-library-preview(); }
        toggle-watched => { root.toggle-watched-preview(); }
        close-drawer => {
            root.preview-enabled = false;
            root.close-preview-drawer();
        }
        toggle-trailer-playback => { root.toggle-trailer-playback(); }
        toggle-video-muted => { root.toggle-video-muted(); }
        toggle-autoplay => { root.toggle-autoplay(); }
        maximize-trailer => { root.maximize-trailer(); }
        seek-video-relative(offset) => { root.seek-video-relative(offset); }
        seek-video-progress(progress) => { root.seek-video-progress(progress); }
        metadata-filter-selected(val) => { root.metadata-filter-selected(val); }
    }
}
}
